{
  "agents": {
    "defaults": {
      "workspace": "./.nanobot-workspace",
      "timezone": "Asia/Kolkata"
    }
  },
  "tools": {
    "mcpServers": {
      "gosu_library": {
        "command": "node",
        "args": ["src/nanobot/mcp-server.js"],
        "env": {
          "NANOBOT_ENABLED": "true",
          "NANOBOT_MCP_TOKEN": "${NANOBOT_MCP_TOKEN}",
          "NANOBOT_MCP_SESSION_TOKEN": "${NANOBOT_MCP_SESSION_TOKEN}"
        },
        "enabledTools": [
          "search_library",
          "get_admin_brief"
        ],
        "toolTimeout": 30
      }
    }
  }
}
