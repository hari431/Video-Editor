# BrowserVideoStudio — local-only configuration.
# Copy this file to .env and adjust. .env is git-ignored.

# ---- Server ----
NODE_ENV=development
PORT=3000

# Local sign-in password. Leave blank to run unprotected (local use only).
APP_PASSWORD=change-me
# Random value used to sign the session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-secret

# ---- Local FFmpeg (required for export / finalize) ----
# If unset, the app looks for ffmpeg/ffprobe on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# A .ttf file used to render text overlays and the watermark.
# VIDEO_EDITOR_FONT=C:\Windows\Fonts\arial.ttf

# ---- Editor / recorder limits ----
# Max upload size per video in MB (default 2048; clamped to 8192).
VIDEO_EDITOR_MAX_VIDEO_MB=2048
# Set to false to disable the editor/recorder export endpoints.
VIDEO_EDITOR_ENABLED=true
