NODE_ENV=development
PORT=3000
# BASE_URL is the public URL the app is served from. Locally this is the dev
# origin; in production it must be the Render app URL (e.g.
# https://learn-with-me.onrender.com). It drives the Google OAuth callback,
# same-origin checks, and the links in email notifications — so it must be
# updated whenever the app's public host changes.
BASE_URL=http://localhost:3100
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gosu_query_library

# Local-only personal Expense Tracker. Use a random passphrase of at least 8 characters.
# The tracker is denied unless NODE_ENV=development and this value is configured.
# Never set this on production; never commit the real passcode.
EXPENSE_TRACKER_PASSCODE=
# Separate local-only PostgreSQL database; host must be localhost/127.0.0.1/::1.
# Create this database locally first. Do not point it at DATABASE_URL or any remote/production host.
EXPENSE_TRACKER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_tracker_local

# Google OAuth
# The OAuth callback is derived from BASE_URL: <BASE_URL>/auth/google/callback.
# If BASE_URL changes (e.g. moving to a new Render URL), add the new
# .../auth/google/callback as an Authorized redirect URI in the Google Cloud
# OAuth client before the change, and remove the old one afterwards.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google email addresses of the library administrators.
# Admin authorization currently uses these emails (never trusting a client-supplied flag).
# Admin accounts are permanent: they are always status='active' with
# access_expires_at=NULL, never expire, and cannot be revoked/edited from /admin.
# Run `npm run normalize-admins` after deployment to normalize existing admin rows.
# These same addresses receive the "New Access Request" notification emails.
ADMIN_EMAILS=your-email@example.com

# SMTP email notifications.
# A new pending user logs in -> admin(s) get a "New Access Request" email.
# An admin approves a user -> the user gets an "Access Approved" email.
# Email is optional: if EMAIL_HOST is unset the application runs fine and merely
# skips sending. Delivery failures are logged server-side and never affect
# authentication or access-control decisions.
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="Learn with me <library@your-domain.com>"

# Local Learn with me query library source.
# The project-root queries/ directory is the single source of truth. Place .txt files
# under queries/ (e.g. queries/PC/Config/My Query.txt). Nothing else needs to be configured.

# How long the server caches the local query library, in seconds.
LIBRARY_CACHE_SECONDS=300

# Google AdSense (future, disabled by default — Phase 8A preparation)
# Live advertising is disabled unless ADSENSE_ENABLED=true AND a real publisher ID is provided.
# Placeholder mode is used for development/tests so placement can be verified without contacting Google.
# Do NOT enable live ads before public-launch approval. See docs/ADSENSE_SETUP.md for production steps.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
# Optional per-slot overrides (fallback to ADSENSE_SLOT_ID if unset)
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_QUERY=
ADSENSE_SLOT_WATCH=
ADSENSE_SLOT_BROWSE=
ADSENSE_SLOT_ITEM=

# ── Database retention / cleanup (free-tier storage control) ──────────────
# Master switch: cleanup only runs when RETENTION_ENABLED=true.
# Dry-run: RETENTION_DRY_RUN=true counts expired rows but performs NO DELETE.
# Every retention period MUST come from env — no hardcoded fallback. Missing/invalid => that table skipped with warning.
# Cleanup is batched (RETENTION_BATCH_SIZE rows per DELETE) to avoid long locks, idempotent and safe to re-run.
# Only these safe targets are cleaned — users/content_seen/item_likes/active discussions/RBAC/Guidewire content are NEVER touched.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_BATCH_SIZE=500
# Per-table retention days (positive integer). Example values — adjust per environment.
QUERY_USAGE_RETENTION_DAYS=90
VIDEO_VIEWS_RETENTION_DAYS=90
RECENTLY_VIEWED_RETENTION_DAYS=90
DAILY_USAGE_STATS_RETENTION_DAYS=365
DELETED_DISCUSSIONS_RETENTION_DAYS=30
DELETED_REPLIES_RETENTION_DAYS=30
VIDEO_PROTECTION_SESSIONS_RETENTION_DAYS=180
# Optional: override scheduler interval (ms). Default 24h.
# RETENTION_INTERVAL_MS=86400000

# Default initial access duration granted to new users upon admin approval (in days)
DEFAULT_ACCESS_DAYS=30

# Allow expired base accounts public access to browse free/non-paid content and purchase plans
EXPIRED_ACCOUNT_PUBLIC_ACCESS_ENABLED=false

# ── Premium Membership Payment Infrastructure ──────────────────────────────
# Master feature flag to enable/disable public premium membership registration.
# Keep disabled (false) until ready for production launch.
PREMIUM_MEMBERSHIP_ENABLED=false
PAID_PLANS_ENABLED=false
PREMIUM_MONTHLY_AMOUNT_INR=300
PREMIUM_ONE_TIME_AMOUNT_INR=300
PREMIUM_CURRENCY=INR
PREMIUM_ACCESS_DAYS=15

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREMIUM_PLAN_ID=

# Environment-driven promotion configurations in JSON format
# e.g. [{"code":"FIRST50","type":"percentage","value":50,"eligibilityDays":7,"maxRedemptions":50,"enabled":true,"recurringOfferId":"offer_xxxxx"}]
PREMIUM_PROMO_CODES_JSON=[]
LOCAL_USER_DELETE_ENABLED=false
USER_INACTIVE_DELETE_DAYS=60
# Inactive-user auto-deletion schedule – daily at INACTIVE_DELETE_TIME IST (default 02:00)
# Scheduler is disabled in test; in development it requires INACTIVE_DELETE_ENABLED=true to run destructively.
# Manual preview/dry-run and explicit Run remain available via Admin UI/API regardless.
INACTIVE_DELETE_TIME=02:00
INACTIVE_DELETE_ENABLED=false

# ── Public Knowledge Base ──────────────────────────────────────────────────
# Controls availability/visibility of the public, read-only educational Knowledge Base at /knowledge.
# When true: /knowledge is publicly accessible without login and crawlable by search engines.
# When false: the public Knowledge Base is disabled/hidden.
PUBLIC_KNOWLEDGE_ENABLED=true

PERF_DIAGNOSTICS=false
# Local-only Admin video editor upload cap (MB, default 2048 = 2 GB).
# Enforced identically by the editor UI pre-check and the server upload validation.
# Positive integer only (garbage/zero/negative falls back to 2048); values above 8192 clamp to 8192.
# The whole upload is buffered in server memory, so this is never unlimited. Has no effect in production (editor disabled there).
VIDEO_EDITOR_MAX_VIDEO_MB=2048

# Optional local Luna assistant. Keep false in production until explicitly enabled and tested.
# When false, no Luna route/API is registered and the feature is completely inactive.
LUNA_ENABLED=false

# Optional AI Admin Assistant LLM (Phase 5 Step 5, admin-only).
# Disabled unless ADMIN_ASSISTANT_LLM_ENABLED=true AND a provider + key are set.
# The model receives ONLY the sanitized admin brief/evidence — never DB access.
# Without these, the question endpoint keeps returning deterministic answers.
# ADMIN_ASSISTANT_LLM_ENABLED=false
# ADMIN_ASSISTANT_PROVIDER=gemini
# ADMIN_ASSISTANT_MODEL=
# ADMIN_ASSISTANT_API_KEY=

# ── AI Video Generation POC (LTX-Video, admin-only, disabled by default) ──
# Official upstream: https://github.com/Lightricks/LTX-Video
# (ltx_video.inference.infer / inference.py + pipeline YAML).
# The main Render web process NEVER runs the model: it only tracks
# queued/processing/completed/failed jobs and POSTs to the isolated GPU
# worker (scripts/ltx-worker.js). Nothing below is exposed to the browser.
# Disabled unless AI_VIDEO_ENABLED=true, so the existing Video Editor is
# untouched by default.
AI_VIDEO_ENABLED=false
# URL of the isolated worker (separate GPU host/process). Unset => POC mock
# loop completes jobs with a same-origin placeholder MP4; no GPU needed.
# AI_VIDEO_WORKER_URL=http://localhost:4100
# Bearer token the web process sends to the worker. Never put in client code.
# AI_VIDEO_WORKER_TOKEN=
# Mock mode (default true): worker emits a placeholder MP4 without downloading
# the multi-GB checkpoint or requiring a GPU. Set false for real runs.
AI_VIDEO_MOCK=true
# Worker-side only: LTX repo checkout containing official inference.py.
# LTX_REPO_DIR=/opt/LTX-Video
# Worker-side only: Python binary for the LTX env.
# LTX_PYTHON_BIN=python
# Pipeline YAML from the LTX repo (e.g. configs/ltxv-2b-0.9.8-distilled.yaml).
LTX_PIPELINE_CONFIG=configs/ltxv-2b-0.9.8-distilled.yaml
# Worker-side only: local safetensors checkpoint path. Never download here;
# the worker resolves it (or HF hub) only when AI_VIDEO_MOCK=false.
# LTX_CHECKPOINT_PATH=/models/ltxv-2b-0.9.8-distilled.safetensors
# Worker-side only: output dir for generated MP4s.
# AI_VIDEO_OUTPUT_DIR=./outputs
# Worker-side only: HTTP port when run with `node scripts/ltx-worker.js --serve`.
# AI_VIDEO_WORKER_PORT=4100

# ── Entertainment (Free-TV/IPTV, Active-only, disabled by default) ─────────
# Lightweight live-TV utility for users with status='active' only.
# Logged-out, expired, and all other inactive users get no link and no access.
# Master kill switch: nothing is registered visibly unless FREE_TV_ENABLED=true.
# No database, no Supabase, no storage, no watch history. Render never proxies
# video bytes: the browser plays the third-party HTTPS HLS URL directly, and
# the server only caches playlist *metadata* in memory (see TTL below).
FREE_TV_ENABLED=false
# Fixed upstream playlist metadata file (never user-supplied; must stay https).
# FREE_TV_PLAYLIST_URL=https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8
# In-memory metadata cache TTL, in seconds (one upstream fetch per TTL no
# matter how many viewers are online).
# FREE_TV_CACHE_SECONDS=3600
# Upstream fetch timeout, in milliseconds (clamped to 1000-30000).
# FREE_TV_UPSTREAM_TIMEOUT_MS=10000
# Maximum channels kept from the upstream playlist (clamped to 1-5000).
# FREE_TV_MAX_CHANNELS=2000

#dotnet run --project desktop-recorder\LearnWithMe.Recorder.csproj