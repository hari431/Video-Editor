<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Encoding Converter &amp; Formatter · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>Encoding Converter &amp; Formatter</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Encode or decode text contents instantly across common formats (Base64, URL encoding, HTML entities, and Unicode escapes). **Processes fully local inside your browser memory with zero risk of silent data corruption.**
    </p>

    <!-- Core Converter Panel -->
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      
      <!-- Option selection header -->
      <div class="flex items-center justify-between gap-4 mb-4 flex-wrap border-b border-slate-100 pb-3">
        <h2 style="font-size:16px; margin:0;">Target Format</h2>
        <div class="flex items-center gap-3 flex-wrap">
          <select id="encodingModeSelect" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs bg-slate-50 focus:bg-white focus:outline-none">
            <option value="base64">Base64 (Unicode Safe)</option>
            <option value="url">URL Encoding (RFC-3986)</option>
            <option value="html">HTML Entity escaping</option>
            <option value="unicode">Unicode Escape Sequences (\\uXXXX)</option>
          </select>
          <button type="button" class="button small secondary font-semibold" id="btnLoadSample">Load Sample</button>
        </div>
      </div>

      <!-- Input text area -->
      <div class="mb-4">
        <label for="rawInputText" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Input Text</label>
        <textarea id="rawInputText" placeholder="Enter or paste text here to translate..." style="width:100%; height:130px; font-family:monospace; font-size:12px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
      </div>

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="btnActionEncode">⚡ Encode Input</button>
        <button type="button" class="button small primary" id="btnActionDecode" style="background:#0284c7; border:1px solid #0369a1;">⚡ Decode Input</button>
        <button type="button" class="button small secondary" id="btnClearAll" data-testid="clear-btn">Clear</button>
      </div>

      <!-- Error display banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mb-6"></div>

      <!-- Result View Panel -->
      <div id="outputContainer" class="hidden">
        <hr style="border:0; border-top:1px solid #e2e8f0; margin:24px 0;">

        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path></svg>
              Translated Output
            </h3>
            <button type="button" class="px-2.5 py-1 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded border transition-colors shrink-0" id="copyOutputBtn">Copy Output</button>
          </div>
          <textarea id="outputResultText" readonly style="width:100%; height:130px; font-family:monospace; font-size:12px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#faf5ff; cursor:text;" class="select-all"></textarea>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-encoding-converter.js?v=<%= Date.now() %>"></script>
</body>
</html>
