<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Folder Permissions · Admin</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container">
<h1>Folder Permissions (RBAC)</h1>
<%- include('partials/admin-nav') %>
<p class="muted" style="margin-top:-10px;margin-bottom:18px">Manage roles, assign them to users, and configure which folders each role can access. Unrestricted folders are accessible to all authenticated users. Admins always have full access.</p>
<% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

<!-- ═══ SECTION 1: ROLES ═══ -->
<h2>Roles</h2>
<form method="post" action="/admin/folders/roles" class="admin-form" style="margin-bottom:14px">
  <input type="hidden" name="role_id" value="">
  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <div>
      <label style="font-weight:600;font-size:13px;display:block;margin-bottom:3px">Role name</label>
      <input type="text" name="name" required placeholder="e.g. Guidewire Team" style="border:1px solid #d8dee8;border-radius:8px;padding:7px 10px;font-size:14px;width:200px">
    </div>
    <div>
      <label style="font-weight:600;font-size:13px;display:block;margin-bottom:3px">Description</label>
      <input type="text" name="description" placeholder="Optional description" style="border:1px solid #d8dee8;border-radius:8px;padding:7px 10px;font-size:14px;width:240px">
    </div>
    <div style="display:flex;align-items:center;gap:6px;margin-top:18px;">
      <input type="checkbox" id="default_role_check" name="default_role" value="true" data-testid="new-role-default-check">
      <label for="default_role_check" style="font-weight:600;font-size:13px;cursor:pointer;">Default Role</label>
    </div>
    <div style="display:flex;align-items:center;gap:6px;margin-top:18px;">
      <input type="checkbox" id="ads_available_check" name="ads_available" value="true">
      <label for="ads_available_check" style="font-weight:600;font-size:13px;cursor:pointer;">Ads Available</label>
    </div>
    <div style="display:flex;align-items:center;gap:6px;margin-top:18px;">
      <input type="checkbox" id="notes_available_check" name="notes_available" value="true" data-testid="new-role-notes-check">
      <label for="notes_available_check" style="font-weight:600;font-size:13px;cursor:pointer;">Notes</label>
    </div>
    <div style="margin-top:18px;">
      <button type="submit" class="button small success">Add Role</button>
    </div>
  </div>
</form>
<% if (roles.length === 0) { %>
<p class="muted">No roles defined yet.</p>
<% } else { %>
<% roles.forEach(r => {
  const isBuiltIn = r.name === 'PREMIUM' || r.name === 'Active' || r.name === 'Expired' || r.isBuiltIn;
  if (!isBuiltIn) { %>
    <form id="delete-role-form-<%= r.id %>" method="post" action="/admin/folders/roles/<%= r.id %>/delete" style="display:none"></form>
  <% }
}) %>
<form method="post" action="/admin/folders/roles/update-ads" class="admin-form" id="roles-ads-form">
<table class="admin-table">
  <thead><tr><th>Name</th><th>Description</th><th>Default Role</th><th>Ads Available</th><th>Notes</th><th>Users</th><th>Actions</th></tr></thead>
  <tbody>
  <% roles.forEach(r => {
    const assignedCount = users.filter(u => u.roleIds.includes(r.id)).length;
    const isBuiltIn = r.name === 'PREMIUM' || r.name === 'Active' || r.name === 'Expired' || r.isBuiltIn;
    const isPremiumRole = r.name === 'PREMIUM';
  %>
    <tr data-role-id="<%= r.id %>" data-initial-ads="<%= r.ads_available ? 'true' : 'false' %>" data-initial-default="<%= r.default_role ? 'true' : 'false' %>" data-initial-notes="<%= r.notes_available ? 'true' : 'false' %>">
      <td><strong><%= r.name %></strong><% if (isBuiltIn) { %> <span class="badge badge-premium" style="font-size:10px;">Built-in</span><% } %></td>
      <td><%= r.description || '—' %></td>
      <td>
        <% if (isPremiumRole) { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:not-allowed;color:#94a3b8;" title="Built-in Premium role cannot be a default role">
            <input type="checkbox" disabled class="role-default-checkbox" data-testid="role-default-checkbox-<%= r.id %>">
            <span class="muted" style="font-size:12px;">Protected</span>
          </label>
        <% } else { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" name="role_default_<%= r.id %>" value="true" class="role-default-checkbox" data-role-id="<%= r.id %>" data-initial-default="<%= r.default_role ? 'true' : 'false' %>" data-testid="role-default-checkbox-<%= r.id %>" <%= r.default_role ? 'checked' : '' %>>
            <span style="font-size:13px;" class="role-default-label"><%= r.default_role ? 'Yes' : 'No' %></span>
          </label>
        <% } %>
      </td>
      <td>
        <% if (isPremiumRole) { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:not-allowed;color:#94a3b8;" title="Built-in Premium role cannot have ads enabled">
            <input type="checkbox" disabled class="role-ads-checkbox" data-testid="role-ads-checkbox-<%= r.id %>">
            <span class="muted" style="font-size:12px;">Protected</span>
          </label>
        <% } else { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" name="role_ads_<%= r.id %>" value="true" class="role-ads-checkbox" data-role-id="<%= r.id %>" data-initial-ads="<%= r.ads_available ? 'true' : 'false' %>" data-testid="role-ads-checkbox-<%= r.id %>" <%= r.ads_available ? 'checked' : '' %>>
            <span style="font-size:13px;" class="role-ads-label"><%= r.ads_available ? 'Enabled' : 'Disabled' %></span>
          </label>
        <% } %>
      </td>
      <td>
        <% if (isPremiumRole) { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" name="role_notes_<%= r.id %>" value="true" class="role-notes-checkbox" data-role-id="<%= r.id %>" data-initial-notes="true" data-testid="role-notes-checkbox-<%= r.id %>" checked disabled>
            <span style="font-size:13px;" class="role-notes-label">Enabled</span>
          </label>
        <% } else { %>
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" name="role_notes_<%= r.id %>" value="true" class="role-notes-checkbox" data-role-id="<%= r.id %>" data-initial-notes="<%= r.notes_available ? 'true' : 'false' %>" data-testid="role-notes-checkbox-<%= r.id %>" <%= r.notes_available ? 'checked' : '' %>>
            <span style="font-size:13px;" class="role-notes-label"><%= r.notes_available ? 'Enabled' : 'Disabled' %></span>
          </label>
        <% } %>
      </td>
      <td><%= assignedCount %> user<%= assignedCount !== 1 ? 's' : '' %></td>
      <td>
        <% if (isBuiltIn) { %>
          <span class="muted" style="font-size:12px;">Protected</span>
        <% } else { %>
          <button type="submit" form="delete-role-form-<%= r.id %>" class="button small danger" data-confirm="Delete role &quot;<%= r.name.replace(/"/g, '&quot;') %>&quot;? This removes all user assignments and folder grants for this role.">Delete</button>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<div style="margin-top:12px;display:flex;gap:10px;align-items:center;">
  <button type="submit" id="save-role-ads-btn" class="button success" data-testid="save-role-ads">Save Changes</button>
  <span id="role-ads-status" class="muted" style="font-size:13px"></span>
</div>
</form>
<% } %>

<!-- ═══ SECTION 2: USER ASSIGNMENTS ═══ -->
<h2 style="margin-top:28px">User Role Assignments</h2>
<% const premiumRole = roles.find(r => r.name === 'PREMIUM'); const premiumRoleId = premiumRole ? premiumRole.id : null; %>
<% if (roles.length === 0) { %>
<p class="muted">Create a role above before assigning users.</p>
<% } else if (users.length === 0) { %>
<p class="muted">No users found.</p>
<% } else { %>
<table class="admin-table" id="user-assignments-table">
  <thead><tr><th>User</th><th>Assigned Roles</th><th>Action</th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <% const hasPremiumTag = u.roleIds.some(id => { const r = roles.find(x => x.id === id); return r && r.name === 'PREMIUM'; }); %>
    <% const isProtectedUser = u.app_role === 'OWNER' || u.app_role === 'ADMIN'; %>
    <tr data-user-id="<%= u.id %>" data-initial-roles="<%= u.roleIds.join(',') %>" class="<%= isProtectedUser ? 'row-protected' : '' %>">
      <td><%= u.name || '—' %> <small class="muted">(<%= u.email %>)</small><% if (hasPremiumTag) { %> <span class="badge badge-premium" data-testid="premium-tag">Premium</span><% } %><% if (isProtectedUser) { %> <span class="badge badge-admin" style="font-size:10px;">Protected</span><% } %></td>
      <td>
        <form method="post" action="/admin/folders/assign" class="admin-form user-role-form" data-user-id="<%= u.id %>" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <input type="hidden" name="user_id" value="<%= u.id %>">
          <% roles.forEach(r => { %>
            <label style="font-size:13px;display:flex;align-items:center;gap:3px;white-space:nowrap">
              <input type="checkbox" name="role_ids" value="<%= r.id %>" class="role-checkbox" data-role-id="<%= r.id %>" <%= u.roleIds.includes(r.id) ? 'checked' : '' %> <%= isProtectedUser ? 'disabled' : '' %>>
              <%= r.name %>
            </label>
          <% }) %>
          <button type="submit" class="button small success" <%= isProtectedUser ? 'disabled' : '' %>>Save</button>
        </form>
      </td>
      <td><span class="row-dirty-indicator muted" style="font-size:12px; display:none;"><% if (!isProtectedUser) { %>● Modified<% } %></span></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<div id="bulk-assign-bar" style="margin-top:12px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
  <button id="bulk-assign-save" class="button success" disabled data-testid="bulk-save-changes">Save Changes</button>
  <span id="bulk-assign-status" class="muted" style="font-size:13px"></span>
</div>
<% } %>

<!-- ═══ SECTION 3: FOLDER ACCESS ═══ -->
<h2 style="margin-top:28px">Folder Access</h2>
<p class="muted" style="margin-top:-8px;margin-bottom:12px">Configure who can see each folder. More specific child-folder permissions override parent permissions.</p>

<form method="post" action="/admin/folders/folder" class="admin-form" style="margin-bottom:16px">
  <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
    <div>
      <label style="font-weight:600;font-size:13px;display:block;margin-bottom:3px">Folder path</label>
      <input type="text" name="folder_path" required placeholder="e.g. Guidewire/Gosu/PC" style="border:1px solid #d8dee8;border-radius:8px;padding:7px 10px;font-size:14px;width:300px">
    </div>
    <div>
      <label style="font-weight:600;font-size:13px;display:block;margin-bottom:3px">Access</label>
      <select id="folder-access-level" name="access_level" style="border:1px solid #d8dee8;border-radius:8px;padding:7px 10px;font-size:14px">
        <option value="all">All authenticated users</option>
        <option value="admin">Admin only</option>
        <option value="role">Specific roles…</option>
      </select>
    </div>
    <div id="folder-roles-row" style="display:none;margin-top:6px;">
      <label style="font-weight:600;font-size:13px;display:block;margin-bottom:8px">Select roles for this folder:</label>
      <div id="folder-role-checkboxes" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(180px, 1fr));gap:10px;">
        <% roles.forEach(r => { %>
          <label style="display:flex;align-items:center;gap:6px;font-size:14px;cursor:pointer;">
            <input type="checkbox" name="role_ids" value="<%= r.id %>" class="folder-role-cb">
            <%= r.name %>
          </label>
        <% }) %>
      </div>
    </div>
    <button type="submit" class="button small success">Save</button>
  </div>
</form>

<% if (folderPerms.length === 0) { %>
<p class="muted">No folder permissions configured. All folders are accessible to every authenticated user.</p>
<% } else { %>
<table class="admin-table">
  <thead><tr><th>Folder</th><th>Access</th><th>Granted Roles</th><th>Actions</th></tr></thead>
  <tbody>
  <% folderPerms.forEach(p => {
    let accessLabel;
    if (p.access_level === 'admin') accessLabel = 'Admin only';
    else if (p.access_level === 'role') {
      const granted = p.roleIds.map(id => { const r = roles.find(r => r.id === id); return r ? r.name : 'Deleted'; });
      accessLabel = granted.length ? 'Role' + (granted.length > 1 ? 's' : '') : 'Role (none)';
    } else accessLabel = 'All users';
  %>
    <tr>
      <td><a href="/browse/<%= p.folder_path.split('/').map(encodeURIComponent).join('/') %>" target="_blank" rel="noopener noreferrer" style="color:#0284c7;text-decoration:none;"><strong><%= p.folder_path %></strong> &nearr;</a></td>
      <td><span class="badge <%= p.access_level === 'admin' ? 'badge-admin' : p.access_level === 'role' ? 'badge-info' : 'badge-neutral' %>"><%= accessLabel %></span></td>
      <td><% if (p.access_level === 'role') { %><%= p.roleIds.map(id => { const r = roles.find(r => r.id === id); return r ? r.name : '?'; }).join(', ') %><% } else { %>—<% } %></td>
      <td>
        <button type="button" class="button small secondary edit-folder-btn" data-path="<%= p.folder_path %>" style="margin-right:4px;">Edit</button>
        <form method="post" action="/admin/folders/folder/<%= encodeURIComponent(p.folder_path) %>/delete" class="admin-form" style="display:inline">
          <button type="submit" class="button small danger" data-confirm="Remove access restriction for &quot;<%= p.folder_path.replace(/"/g, '&quot;') %>&quot;? Folder will become accessible to all users.">Remove</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>

</main>
<%- include('partials/footer') %>
<script>
(function() {
  var accessSelect = document.getElementById('folder-access-level');
  var rolesRow = document.getElementById('folder-roles-row');
  var pathInput = document.querySelector('input[name="folder_path"]');
  
  function toggle() { rolesRow.style.display = accessSelect.value === 'role' ? '' : 'none'; }
  accessSelect.addEventListener('change', toggle);
  toggle();

  var existingPerms = <%- JSON.stringify(folderPerms.map(p => ({ path: p.folder_path, access: p.access_level, roleIds: p.roleIds }))) %>;
  
  if (pathInput) {
    pathInput.addEventListener('input', function() {
      var val = pathInput.value.trim();
      var match = existingPerms.find(function(p) { return p.path === val; });
      var roleCheckboxes = document.querySelectorAll('.folder-role-cb');
      roleCheckboxes.forEach(function(cb) { cb.checked = false; });
      if (match) {
        accessSelect.value = match.access;
        if (match.access === 'role' && match.roleIds && match.roleIds.length > 0) {
          roleCheckboxes.forEach(function(cb) {
            if (match.roleIds.includes(Number(cb.value))) {
              cb.checked = true;
            }
          });
        }
        toggle();
      }
    });
  }

  document.querySelectorAll('.edit-folder-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var path = this.getAttribute('data-path');
      if (pathInput) {
        pathInput.value = path;
        pathInput.dispatchEvent(new Event('input'));
        pathInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        pathInput.focus();
      }
    });
  });

  document.querySelectorAll('button[data-confirm]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      if (!confirm(this.dataset.confirm)) {
        e.preventDefault();
      }
    });
  });
})();
</script>
<script>
(function() {
  var table = document.getElementById('user-assignments-table');
  if (!table) return;
  var bulkBtn = document.getElementById('bulk-assign-save');
  var statusEl = document.getElementById('bulk-assign-status');
  function getRowInitial(row) {
    var val = row.getAttribute('data-initial-roles') || '';
    if (!val) return [];
    return val.split(',').filter(Boolean).map(function(s){ return s.trim(); }).sort();
  }
  function getRowCurrent(row) {
    var checks = row.querySelectorAll('.role-checkbox:checked');
    var ids = [];
    for (var i=0;i<checks.length;i++) ids.push(checks[i].value);
    return ids.sort();
  }
  function isDirty(row) {
    var init = getRowInitial(row);
    var cur = getRowCurrent(row);
    if (init.length !== cur.length) return true;
    for (var i=0;i<init.length;i++) if (init[i] !== cur[i]) return true;
    return false;
  }
  function updateBulkState() {
    var rows = table.querySelectorAll('tbody tr[data-user-id]');
    var dirtyCount = 0;
    for (var i=0;i<rows.length;i++) {
      var row = rows[i];
      var dirty = isDirty(row);
      row.classList.toggle('row-dirty', dirty);
      var indicator = row.querySelector('.row-dirty-indicator');
      if (indicator) indicator.style.display = dirty ? '' : 'none';
      if (dirty) dirtyCount++;
    }
    if (bulkBtn) {
      bulkBtn.disabled = dirtyCount === 0;
      if (statusEl) statusEl.textContent = dirtyCount ? dirtyCount + ' user(s) modified' : '';
    }
  }
  table.addEventListener('change', function(e){
    if (e.target && e.target.classList.contains('role-checkbox')) {
      updateBulkState();
    }
  });
  updateBulkState();
  if (bulkBtn) {
    bulkBtn.addEventListener('click', async function(){
      var rows = table.querySelectorAll('tbody tr[data-user-id]');
      var assignments = [];
      for (var i=0;i<rows.length;i++) {
        var row = rows[i];
        if (!isDirty(row)) continue;
        var userId = row.getAttribute('data-user-id');
        var cur = getRowCurrent(row);
        assignments.push({ user_id: parseInt(userId,10), role_ids: cur.map(function(v){ return parseInt(v,10); }).filter(function(n){ return Number.isFinite(n); }) });
      }
      if (!assignments.length) return;
      bulkBtn.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving...';
      try {
        var res = await fetch('/admin/folders/assign-bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ assignments: assignments })
        });
        var data = await res.json().catch(function(){ return {}; });
        if (!res.ok) throw new Error(data.error || 'Failed to save');
        window.location.href = '/admin/folders?msg=assignmentSaved';
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Failed');
        bulkBtn.disabled = false;
      }
    });
  }
})();
</script>
<script>
(function() {
  var form = document.getElementById('roles-ads-form');
  if (!form) return;
  var saveBtn = document.getElementById('save-role-ads-btn');
  var statusEl = document.getElementById('role-ads-status');

  function updateRoleSettingsState() {
    var adsCheckboxes = form.querySelectorAll('.role-ads-checkbox[data-role-id]');
    var defCheckboxes = form.querySelectorAll('.role-default-checkbox[data-role-id]');
    var notesCheckboxes = form.querySelectorAll('.role-notes-checkbox[data-role-id]');
    var dirtyCount = 0;
    var modifiedRoles = new Set();

    adsCheckboxes.forEach(function(cb) {
      var initial = cb.getAttribute('data-initial-ads') === 'true';
      var current = cb.checked;
      var labelSpan = cb.parentNode.querySelector('.role-ads-label');
      if (labelSpan) {
        labelSpan.textContent = current ? 'Enabled' : 'Disabled';
      }
      if (initial !== current) {
        modifiedRoles.add(cb.getAttribute('data-role-id'));
      }
    });

    defCheckboxes.forEach(function(cb) {
      var initial = cb.getAttribute('data-initial-default') === 'true';
      var current = cb.checked;
      var labelSpan = cb.parentNode.querySelector('.role-default-label');
      if (labelSpan) {
        labelSpan.textContent = current ? 'Yes' : 'No';
      }
      if (initial !== current) {
        modifiedRoles.add(cb.getAttribute('data-role-id'));
      }
    });

    notesCheckboxes.forEach(function(cb) {
      if (cb.disabled) return;
      var initial = cb.getAttribute('data-initial-notes') === 'true';
      var current = cb.checked;
      var labelSpan = cb.parentNode.querySelector('.role-notes-label');
      if (labelSpan) {
        labelSpan.textContent = current ? 'Enabled' : 'Disabled';
      }
      if (initial !== current) {
        modifiedRoles.add(cb.getAttribute('data-role-id'));
      }
    });

    dirtyCount = modifiedRoles.size;
    if (statusEl) {
      statusEl.textContent = dirtyCount ? dirtyCount + ' role(s) modified' : '';
    }
  }

  form.addEventListener('change', function(e) {
    if (e.target && (e.target.classList.contains('role-ads-checkbox') || e.target.classList.contains('role-default-checkbox') || e.target.classList.contains('role-notes-checkbox'))) {
      updateRoleSettingsState();
    }
  });

  form.addEventListener('submit', async function(e) {
    if (e.submitter && e.submitter.getAttribute('form') && e.submitter.getAttribute('form') !== 'roles-ads-form') {
      return;
    }
    e.preventDefault();
    var rows = form.querySelectorAll('tr[data-role-id]');
    var updates = [];
    rows.forEach(function(row) {
      var roleId = parseInt(row.getAttribute('data-role-id'), 10);
      if (Number.isFinite(roleId) && roleId > 0) {
        var adsCb = row.querySelector('.role-ads-checkbox[data-role-id]');
        var defCb = row.querySelector('.role-default-checkbox[data-role-id]');
        var notesCb = row.querySelector('.role-notes-checkbox[data-role-id]');
        var item = { id: roleId };
        if (adsCb) item.ads_available = adsCb.checked;
        if (defCb) item.default_role = defCb.checked;
        if (notesCb && !notesCb.disabled) item.notes_available = notesCb.checked;
        updates.push(item);
      }
    });

    if (saveBtn) saveBtn.disabled = true;
    if (statusEl) statusEl.textContent = 'Saving...';

    try {
      var res = await fetch('/admin/folders/roles/update-ads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ roles: updates })
      });
      var data = await res.json().catch(function() { return {}; });
      if (!res.ok) throw new Error(data.error || 'Failed to save');
      window.location.href = '/admin/folders?msg=roleSaved';
    } catch (err) {
      if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Failed');
      if (saveBtn) saveBtn.disabled = false;
    }
  });
})();
</script>
</body></html>
