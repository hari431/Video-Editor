<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>PCF / XML Path Explorer · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>PCF / XML Formatter, Validator &amp; Path Explorer</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Paste any XML or Guidewire PCF configuration snippet to instantly format/beautify, validate syntax well-formedness (detect mismatched tags, missing brackets, unclosed comments with exact coordinates), and recursively search or navigate elements with automatic XPath generation. <strong>Does not require Guidewire proprietary schemas — everything runs completely local &amp; in-memory.</strong>
    </p>

    <!-- Parser Options & Input Grid -->
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
        <h2 style="font-size:16px; margin:0;">Input Configuration</h2>
        <div class="flex items-center gap-2">
          <button type="button" class="button small secondary font-semibold" id="loadSampleBtn">Load Sample PCF</button>
        </div>
      </div>

      <div class="mb-4">
        <textarea id="pcfInput" placeholder="Paste your XML or PCF content here..." style="width:100%; height:280px; font-family:monospace; font-size:12px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
      </div>

      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-2">
          <button type="button" class="button small primary" id="validateBtn">⚡ Validate &amp; Explore</button>
          <button type="button" class="button small secondary" id="formatBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Format / Beautify</button>
          <button type="button" class="button small secondary" id="clearBtn" data-testid="clear-btn">Clear</button>
        </div>
        <button type="button" class="button small secondary" id="copyFormattedBtn">Copy Raw Output</button>
      </div>

      <!-- Error display banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mt-6"></div>

      <!-- Analysis Results panel -->
      <div id="resultsPanel" class="hidden mt-8 border-t border-slate-200 pt-8">
        
        <!-- Stats Summary grid -->
        <div class="grid grid-cols-3 gap-4 mb-6">
          <div class="bg-slate-50 border rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Elements</span>
            <span id="statElements" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Attributes</span>
            <span id="statAttributes" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Comments</span>
            <span id="statComments" class="text-2xl font-black text-slate-800">0</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
          
          <!-- XML Interactive Tree View -->
          <div class="md:col-span-2 bg-slate-50 border border-slate-200 rounded-xl p-6 shadow-sm overflow-auto max-h-[550px]">
            
            <!-- Search nodes block -->
            <div class="flex items-center gap-2 mb-4 border-b border-slate-200 pb-3">
              <input type="text" id="searchNodeInput" placeholder="Search element or attribute..." class="px-3 py-1.5 border rounded-lg text-xs w-full bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500" />
              <button type="button" id="btnSearchNode" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg whitespace-nowrap">Find Node</button>
              <span id="searchCount" class="text-[11px] font-semibold text-slate-500 shrink-0"></span>
            </div>

            <div id="xmlTreeContainer" class="space-y-1">
              <!-- Rendered recursively -->
            </div>
          </div>

          <!-- Selected Element Sidebar Panel -->
          <div id="detailsPanel" class="hidden bg-white border border-indigo-100 rounded-xl p-5 shadow-sm space-y-4">
            <h3 class="text-xs font-bold text-indigo-800 uppercase tracking-wider border-b border-indigo-50 pb-2 flex items-center justify-between">
              Selected Element Details
              <span class="text-[10px] bg-indigo-50 text-indigo-700 px-1.5 py-0.5 rounded font-mono">PCF Element</span>
            </h3>

            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Element Name</span>
              <span id="detailName" class="font-mono text-sm font-bold text-slate-900 break-all select-all"></span>
            </div>

            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Parent Tag</span>
              <span id="detailParent" class="font-mono text-xs font-semibold text-slate-600 break-all"></span>
            </div>

            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Direct Children</span>
              <span id="detailChildren" class="font-mono text-xs font-bold text-slate-800">0</span>
            </div>

            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider block">XPath Selector</span>
              <div class="flex items-center gap-1.5 mt-1">
                <code id="detailXPath" class="bg-indigo-50/50 border border-indigo-100 rounded p-1.5 text-[10px] text-indigo-950 font-mono break-all select-all flex-1 min-h-[26px] inline-block"></code>
                <button type="button" id="btnCopyXPath" class="px-2 py-1 bg-white hover:bg-slate-50 border text-[10px] font-bold text-slate-700 rounded transition-colors shrink-0">Copy</button>
              </div>
            </div>

            <hr class="border-t border-slate-100 my-2">

            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider block mb-2">Attributes</span>
              <ul id="detailAttributes" class="space-y-1.5">
                <!-- Attributes list -->
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-pcf-explorer.js?v=<%= Date.now() %>"></script>
</body>
</html>
