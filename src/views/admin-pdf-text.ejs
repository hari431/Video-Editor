<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PDF to Text · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>PDF to Text</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Extract the selectable text of a local PDF, page by page, and download it as <strong>.txt</strong>. Scanned or image-only pages contain no selectable text — this tool performs <strong>no OCR</strong> and will honestly report empty pages. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfTextAvailable !== 'undefined' ? !!pdfTextAvailable : false; %>
<% const _maxMb = (typeof pdfTextMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfTextMaxFileMb)) && Number(pdfTextMaxFileMb) >= 1) ? Math.floor(Number(pdfTextMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-text-disabled">PDF to Text is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-text-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfTextPick" data-testid="pdf-text-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfTextFile" data-testid="pdf-text-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB · selectable text only, no OCR</span>
  </div>
  <p class="muted" id="pdfTextFileInfo" data-testid="pdf-text-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Pages to extract</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfTextScope" value="all" data-testid="pdf-text-scope-all" checked <%= _available ? '' : 'disabled' %>>
      All pages
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfTextScope" value="range" data-testid="pdf-text-scope-range" <%= _available ? '' : 'disabled' %>>
      Selected pages
      <input type="text" id="pdfTextSelection" data-testid="pdf-text-selection" placeholder="e.g. 1-3,5" autocomplete="off" spellcheck="false" style="width:200px;margin-left:8px;" <%= _available ? '' : 'disabled' %>>
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small secondary" id="pdfTextPreviewBtn" data-testid="pdf-text-preview" <%= _available ? '' : 'disabled' %>>Preview text</button>
    <button type="button" class="button small primary" id="pdfTextBtn" data-testid="pdf-text-submit" <%= _available ? '' : 'disabled' %>>📄 Download .txt</button>
    <button type="button" class="button small secondary" id="pdfTextClear" data-testid="pdf-text-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <pre id="pdfTextPreview" data-testid="pdf-text-preview-output" style="display:none;white-space:pre-wrap;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px;font-size:12px;max-height:320px;overflow:auto;"></pre>
  <div id="pdfTextProgress" data-testid="pdf-text-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Extracting… <span id="pdfTextProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-text-status" id="pdfTextStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-text-result" id="pdfTextResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-text.js?v=<%= Date.now() %>"></script>
</body></html>
