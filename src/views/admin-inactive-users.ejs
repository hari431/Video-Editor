<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Inactive Users · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container">
<h1>Inactive User Cleanup</h1>
<%- include('partials/admin-nav') %>
<% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

<section style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin:16px 0;">
  <h2 style="margin:0 0 8px;font-size:15px;">Configuration</h2>
  <p class="muted" style="margin:4px 0;">Automatic deletion removes <strong>non-active</strong> users (pending/expired/revoked) whose <code>last_activity_at</code> is older than the threshold. <strong>Active</strong> users are never deleted. <code>OWNER</code>/<code>ADMIN</code> and <code>ADMIN_EMAILS</code> are protected.</p>
  <ul style="margin:8px 0 0 18px;font-size:13px;color:#334155;">
    <li>Threshold: <strong><%= typeof thresholdDays !== 'undefined' && thresholdDays ? thresholdDays + ' days' : 'NOT SET (USER_INACTIVE_DELETE_DAYS)' %></strong> <span class="muted">(cutoff: <%= cutoff || '—' %>)</span></li>
    <li>Scheduled daily at: <strong><%= scheduleTime || '02:00 IST' %></strong> <span class="muted">(auto-run <%= schedulerEnabled ? 'ENABLED' : 'DISABLED' %> – <%= schedulerEnabled ? 'next run ' + (nextRun || '—') : 'requires INACTIVE_DELETE_ENABLED=true or NODE_ENV=production' %>)</span></li>
    <li>Eligible users (dry-run): <strong><%= typeof eligibleCount !== 'undefined' ? eligibleCount : '—' %></strong></li>
  </ul>
</section>

<section style="display:flex;gap:10px;flex-wrap:wrap;margin:12px 0;">
  <form method="post" action="/admin/inactive-users/cleanup" style="display:inline">
    <input type="hidden" name="dryRun" value="true">
    <button type="submit" class="button small" data-testid="inactive-dryrun">Preview / Dry-Run</button>
  </form>
  <form method="post" action="/admin/inactive-users/cleanup" style="display:inline" onsubmit="return confirm('Permanently delete all eligible inactive users? This cannot be undone.')">
    <button type="submit" class="button small secondary" data-testid="inactive-run">Run Cleanup (Delete)</button>
  </form>
  <a href="/admin/inactive-users?refresh=1" class="button small" style="text-decoration:none;">Refresh Count</a>
</section>

<% if (typeof dryRunResult !== 'undefined' && dryRunResult) { %>
<section style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px;margin:12px 0;">
  <h3 style="margin:0 0 6px;font-size:14px;">Dry-Run Result</h3>
  <p class="muted" style="margin:0;font-size:12px;">Would process <strong><%= dryRunResult.processed %></strong>, would delete <strong><%= dryRunResult.wouldDelete %></strong>, skipped <strong><%= dryRunResult.skipped %></strong>, failed <strong><%= dryRunResult.failed %></strong> (cutoff <%= dryRunResult.cutoff %>).</p>
  <% if (dryRunResult.failedIds && dryRunResult.failedIds.length) { %><pre style="font-size:11px;white-space:pre-wrap;"><%= JSON.stringify(dryRunResult.failedIds,null,2) %></pre><% } %>
</section>
<% } %>

<% if (eligibleUsers && eligibleUsers.length > 0) { %>
<h2 style="margin-top:18px;">Eligible Users (up to <%= eligibleUsers.length %> shown)</h2>
<p class="muted" style="font-size:12px;">Showing users with <code>last_activity_at &lt; cutoff</code> and <code>status != 'active'</code>. Active users never appear here.</p>
<table class="admin-table">
  <thead><tr><th>ID</th><th>Email</th><th>Name</th><th>Status</th><th>Last Activity</th><th>Role</th></tr></thead>
  <tbody>
  <% eligibleUsers.forEach(u => { %>
    <tr>
      <td><%= u.id %></td>
      <td><%= u.email %></td>
      <td><%= u.name || '—' %></td>
      <td><span class="badge badge-<%= u.status %>"><%= u.status %></span></td>
      <td><%= u.last_activity_at ? new Date(u.last_activity_at).toLocaleString(undefined,{timeZone:'Asia/Kolkata'}) : '—' %></td>
      <td><%= u.app_role || 'USER' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } else if (typeof eligibleCount !== 'undefined' && eligibleCount === 0) { %>
<p class="muted">No eligible users found for current threshold. Active users are never eligible.</p>
<% } %>

<% if (lastResult) { %>
<section style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px;margin:12px 0;">
  <h3 style="margin:0 0 6px;font-size:14px;">Last Run Result</h3>
  <pre style="font-size:11px;white-space:pre-wrap;"><%= JSON.stringify(lastResult,null,2) %></pre>
</section>
<% } %>

</main>
<%- include('partials/footer') %>
</body></html>
