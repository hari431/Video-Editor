<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>SQL Log Stitcher · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>Guidewire SQL Log Parameter Stitcher</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Paste raw log outputs from your Guidewire environment. This utility parses SQL statements with <code>?</code> placeholders, extracts associated bind parameters (e.g., <code>[Param: 1, Type: varchar, Value: 'TC_ACTIVE']</code>), and outputs clean, executable SQL. <strong>Runs completely offline in your browser. No database connection or external service is used.</strong>
    </p>

    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <h2 style="font-size:16px; margin-top:0; margin-bottom:12px;">Pasted Log Input</h2>
      <div style="margin-bottom:16px;">
        <textarea id="rawLogsInput" data-testid="raw-logs-input" placeholder="Paste your Guidewire log snippet here...&#10;&#10;Example:&#10;10:15:30.123 DEBUG [gw.database.Query] SELECT * FROM pc_policyperiod WHERE ID = ? AND Status = ?&#10;10:15:30.124 DEBUG [gw.database.Query] Parameters: [Param: 1, Type: varchar, Value: '01:2345'], [Param: 2, Type: varchar, Value: 'TC_ACTIVE']" style="width:100%; height:200px; font-family:monospace; font-size:13px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
      </div>

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="stitchBtn" data-testid="stitch-btn">⚡ Stitch Parameters</button>
        <button type="button" class="button small secondary" id="clearBtn" data-testid="clear-btn">Clear</button>
        <button type="button" class="button small secondary" id="loadExampleBtn">Load Example</button>
      </div>

      <div id="resultsWrapper" style="display:none;">
        <hr style="border:0; border-top:1px solid #e2e8f0; margin:24px 0;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
          <h2 style="font-size:18px; margin:0; color:#0f172a;">Reconstructed Statements (<span id="statementCount">0</span>)</h2>
          <button type="button" class="button small" id="copyAllBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">📋 Copy All Stitched SQL</button>
        </div>

        <div id="statusMessage" class="flash" style="display:none; margin-bottom:16px;"></div>

        <div id="statementsList" style="display:flex; flex-direction:column; gap:24px;">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-sql-stitcher.js?v=<%= Date.now() %>"></script>
</body>
</html>
