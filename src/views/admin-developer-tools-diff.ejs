<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>JSON / XML / Text Diff · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>JSON / XML / Text Diff</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. A local, real-time comparison utility for text payloads, JSON configurations, or XML/SOAP messages. **JSON and XML modes automatically format, normalize, and sort object keys recursively** so cosmetic differences in spacing, line endings, or key ordering do not clutter your results. **Everything runs safely offline in your browser memory.**
    </p>

    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <!-- Options Bar -->
      <div class="flex items-center justify-between gap-4 mb-4 flex-wrap pb-3 border-b border-slate-100">
        <h2 style="font-size:16px; margin:0;">Comparison Configuration</h2>
        <div class="flex items-center gap-3 flex-wrap">
          <select id="diffModeSelect" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs bg-slate-50 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <option value="auto">Auto-Detect Format</option>
            <option value="text">Plain Text Mode</option>
            <option value="json">JSON Mode (Sorted &amp; Normalized)</option>
            <option value="xml">XML Mode (Formatted &amp; Normalized)</option>
          </select>
          <button type="button" class="button small secondary font-semibold" id="loadJsonSampleBtn">Load JSON Sample</button>
          <button type="button" class="button small secondary font-semibold" id="loadXmlSampleBtn">Load XML/PCF Sample</button>
        </div>
      </div>

      <!-- Compare Panels Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
        <div>
          <label for="leftInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Original (Left / Old)</label>
          <textarea id="leftInput" placeholder="Paste original text, JSON, or XML here..." style="width:100%; height:250px; font-family:monospace; font-size:12px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
        </div>
        <div>
          <label for="rightInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Modified (Right / New)</label>
          <textarea id="rightInput" placeholder="Paste modified text, JSON, or XML here..." style="width:100%; height:250px; font-family:monospace; font-size:12px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
        </div>
      </div>

      <!-- Actions Row -->
      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="compareBtn" data-testid="compare-btn">⚡ Compare Inputs</button>
        <button type="button" class="button small secondary" id="clearBtn" data-testid="clear-btn">Clear</button>
      </div>

      <!-- Non-blocking Warning banner -->
      <div id="warningBanner" class="hidden bg-amber-50 border border-amber-200 text-amber-900 rounded-xl p-4 mb-6 text-sm font-medium"></div>

      <!-- Comparison Results Presentation Panel -->
      <div id="resultsPanel" class="hidden mt-8 border-t border-slate-200 pt-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div id="statSummary" class="flex items-center gap-2 flex-wrap">
            <!-- Populated dynamically -->
          </div>

          <!-- View Mode Toggle Buttons -->
          <div class="inline-flex rounded-lg border border-slate-200 bg-slate-50 p-1">
            <button type="button" id="toggleSplitBtn" class="px-3 py-1 rounded-md text-xs font-semibold bg-slate-900 text-white transition-all shadow-sm">Side-by-Side View</button>
            <button type="button" id="toggleUnifiedBtn" class="px-3 py-1 rounded-md text-xs font-semibold text-slate-700 hover:text-slate-950 transition-all">Inline View</button>
          </div>
        </div>

        <!-- Split (Side by Side) View -->
        <div id="splitView" class="grid grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200 overflow-hidden shadow-inner min-h-[100px]">
          <div id="leftDiffCol" class="overflow-x-auto min-w-0 pr-2 border-r border-slate-200/60"></div>
          <div id="rightDiffCol" class="overflow-x-auto min-w-0 pl-2"></div>
        </div>

        <!-- Unified (Inline) View -->
        <div id="unifiedView" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200 overflow-x-auto shadow-inner min-h-[100px]"></div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-diff.js?v=<%= Date.now() %>"></script>
</body>
</html>
