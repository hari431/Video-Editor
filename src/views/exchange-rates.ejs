<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Exchange Rates · Learn with me</title>
<meta name="description" content="Free public currency converter with latest exchange rates. No sign-in or API key required.">
<link rel="stylesheet" href="/styles.css">
<%- include('partials/adsense-verification') %>
<style>
  .fx-hero{margin:28px 0 22px;padding:24px;border:1px solid #dbeafe;border-radius:14px;background:linear-gradient(135deg,#eff6ff,#f8fafc)}
  .fx-hero h1{margin:0 0 8px}
  .fx-hero p{margin:0;color:#475569;max-width:900px;line-height:1.6}
  .fx-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin:20px 0}
  .fx-card{border:1px solid #e2e8f0;border-radius:12px;padding:18px;background:#fff;display:flex;flex-direction:column;gap:12px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
  .fx-card h2{font-size:18px;margin:0}
  .fx-field{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:600;color:#475569}
  .fx-field select,.fx-field input{padding:9px 10px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;font-size:14px}
  .fx-result{font-size:22px;font-weight:800;color:#0f172a}
  .fx-meta{font-size:13px;color:#64748b}
  .fx-table{width:100%;border-collapse:collapse;font-size:14px}
  .fx-table th,.fx-table td{text-align:left;padding:8px 10px;border-bottom:1px solid #e2e8f0}
  .fx-table th{color:#475569;font-size:12px;text-transform:uppercase;letter-spacing:.04em}
  .fx-error{color:#b91c1c;font-size:13px}
  .fx-source{font-size:13px;color:#64748b;margin:18px 0}
</style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <a class="nav-link" href="/knowledge">📖 Knowledge Base</a>
  <a class="nav-link" href="/exchange-rates" style="font-weight:700;color:#1e40af;">💱 Exchange Rates</a>
  <% if (typeof user !== 'undefined' && user) { %>
    <a class="nav-link" href="/account">Account</a>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  <% } else { %>
    <a class="nav-link" href="/login">Sign in</a>
  <% } %>
</header>

<main class="container">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Exchange Rates</span></div>

  <section class="fx-hero">
    <h1>💱 Exchange Rates</h1>
    <p>Free public currency converter with the latest rates. No sign-in or API key required. Rates refresh automatically on the server.</p>
  </section>

  <div class="fx-grid">
    <section class="fx-card" aria-label="Currency converter">
      <h2>Converter</h2>
      <label class="fx-field">Amount
        <input id="fxAmount" type="number" min="0" step="any" value="100" inputmode="decimal" aria-label="Amount">
      </label>
      <label class="fx-field">Base currency
        <select id="fxBase" aria-label="Base currency"></select>
      </label>
      <label class="fx-field">Target currency
        <select id="fxTarget" aria-label="Target currency"></select>
      </label>
      <div class="fx-result" id="fxConverted" role="status" aria-live="polite">—</div>
      <div class="fx-meta" id="fxRateLine">Select currencies to convert.</div>
      <div class="fx-error" id="fxError" hidden></div>
    </section>

    <section class="fx-card" aria-label="Popular currencies">
      <h2>Popular currencies</h2>
      <div class="fx-meta" id="fxUpdated">Loading latest rates…</div>
      <table class="fx-table">
        <thead><tr><th scope="col">Currency</th><th scope="col">Rate</th><th scope="col">1 unit</th></tr></thead>
        <tbody id="fxPopular"><tr><td colspan="3">Loading…</td></tr></tbody>
      </table>
    </section>
  </div>

  <p class="fx-source">Source: <a href="https://github.com/fawazahmed0/exchange-api" target="_blank" rel="noopener noreferrer">fawazahmed0/exchange-api</a> (free, no rate limits, daily updated).</p>
</main>
<%- include('partials/footer') %>
<script>
(function () {
  var baseEl = document.getElementById('fxBase');
  var targetEl = document.getElementById('fxTarget');
  var amountEl = document.getElementById('fxAmount');
  var convertedEl = document.getElementById('fxConverted');
  var rateLineEl = document.getElementById('fxRateLine');
  var updatedEl = document.getElementById('fxUpdated');
  var popularEl = document.getElementById('fxPopular');
  var errorEl = document.getElementById('fxError');
  var state = { base: 'usd', date: null, rates: {} };
  var POPULAR = ['eur', 'gbp', 'inr', 'jpy', 'aud', 'cad', 'sgd', 'aed', 'chf', 'usd'];

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = !msg;
  }

  function fillSelectors(codes, base, target) {
    function fill(el, selected) {
      el.innerHTML = '';
      codes.forEach(function (code) {
        var opt = document.createElement('option');
        opt.value = code;
        opt.textContent = code.toUpperCase();
        if (code === selected) opt.selected = true;
        el.appendChild(opt);
      });
    }
    fill(baseEl, base);
    fill(targetEl, target);
  }

  function render() {
    var amount = parseFloat(amountEl.value);
    if (!isFinite(amount) || amount < 0) amount = 0;
    var target = (targetEl.value || 'eur').toLowerCase();
    var rate = state.rates[target];
    if (rate == null) {
      convertedEl.textContent = '—';
      rateLineEl.textContent = 'Rate unavailable for ' + target.toUpperCase() + '.';
      return;
    }
    var converted = amount * rate;
    convertedEl.textContent = converted.toLocaleString(undefined, { maximumFractionDigits: 4 }) + ' ' + target.toUpperCase();
    rateLineEl.textContent = '1 ' + state.base.toUpperCase() + ' = ' + rate + ' ' + target.toUpperCase();
    var rows = POPULAR.filter(function (c) { return c !== state.base; }).slice(0, 8).map(function (code) {
      var r = state.rates[code];
      var cell = (r == null) ? '—' : String(r);
      var one = (r == null) ? '—' : (1 * r).toLocaleString(undefined, { maximumFractionDigits: 4 });
      return '<tr><td><strong>' + code.toUpperCase() + '</strong></td><td>' + cell + '</td><td>' + one + '</td></tr>';
    }).join('');
    popularEl.innerHTML = rows || '<tr><td colspan="3">No rates available.</td></tr>';
    updatedEl.textContent = state.date ? ('Last updated: ' + state.date + ' (base ' + state.base.toUpperCase() + ')') : 'Latest rates loaded.';
  }

  function load(base) {
    showError('');
    updatedEl.textContent = 'Loading latest rates…';
    fetch('/api/exchange-rates?base=' + encodeURIComponent(base), { headers: { Accept: 'application/json' } })
      .then(function (res) {
        if (!res.ok) throw new Error('Rates unavailable (HTTP ' + res.status + ').');
        return res.json();
      })
      .then(function (data) {
        if (!data || !data.ok || !data.rates) throw new Error('Rates unavailable.');
        state = { base: data.base, date: data.date, rates: data.rates };
        var codes = Object.keys(data.rates).sort();
        var keepTarget = targetEl.value || 'eur';
        if (!data.rates[keepTarget.toLowerCase()]) keepTarget = codes.indexOf('eur') >= 0 ? 'eur' : codes[0];
        fillSelectors(codes, data.base, keepTarget.toLowerCase());
        render();
      })
      .catch(function (err) {
        showError(err && err.message ? err.message : 'Rates unavailable.');
        updatedEl.textContent = 'Could not load latest rates.';
      });
  }

  baseEl.addEventListener('change', function () { load((baseEl.value || 'usd').toLowerCase()); });
  targetEl.addEventListener('change', render);
  amountEl.addEventListener('input', render);
  load('usd');
})();
</script>
</body>
</html>
