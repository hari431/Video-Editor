<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Guidewire Typelist Generator · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>Guidewire Typelist Generator</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Create and manage custom Guidewire Typelist configurations, extensions, and filters locally in-memory. **Directly define, edit, delete, and reorder typecodes** using a simple form-table, and generate clean, well-escaped XML formats (supporting `.tti` typelists, `.ttx` extensions, and `.fnt` filters) with download or clipboard copy features.
    </p>

    <!-- Main Generator UI -->
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      
      <!-- List Metadata Form -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 border-b border-slate-100 pb-5">
        <div>
          <label for="listNameInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Typelist Name</label>
          <input type="text" id="listNameInput" placeholder="e.g. PolicyStatus" class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-full focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-slate-50" />
        </div>
        <div>
          <label for="listDescInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Typelist Description</label>
          <input type="text" id="listDescInput" placeholder="System typelist representing policy period..." class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-full focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-slate-50" />
        </div>
        <div>
          <label for="formatSelect" class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1.5">Output File Extension</label>
          <select id="formatSelect" class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-full focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-slate-50">
            <option value="tti">.tti (Typelist Definition)</option>
            <option value="ttx">.ttx (Typelist Extension)</option>
            <option value="fnt">.fnt (Filter Definition)</option>
          </select>
        </div>
      </div>

      <!-- Typecodes Interactive Table Section -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
          <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wide">Typecode Entries</h3>
          <div class="flex items-center gap-2">
            <button type="button" class="button small secondary font-semibold" id="btnLoadSample">Load Sample Typelist</button>
            <button type="button" class="button small secondary" id="btnClearAll" data-testid="clear-btn">Clear All</button>
          </div>
        </div>

        <div class="overflow-x-auto border border-slate-200 rounded-xl bg-slate-50/30">
          <table class="w-full text-left border-collapse" style="min-width: 800px;">
            <thead>
              <tr class="bg-slate-100 border-b border-slate-200 text-[10px] text-slate-500 uppercase tracking-wider font-bold">
                <th class="p-3">Typecode</th>
                <th class="p-3">Name</th>
                <th class="p-3">Description</th>
                <th class="p-3" style="width: 80px;">Priority</th>
                <th class="p-3">Category</th>
                <th class="p-3">Parent Code</th>
                <th class="p-3 text-center" style="width: 60px;">Retired</th>
                <th class="p-3 text-center" style="width: 120px;">Actions</th>
              </tr>
            </thead>
            <tbody id="typecodesTableBody">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>

        <div class="mt-3">
          <button type="button" class="px-4 py-2 border border-indigo-200 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-lg transition-colors" id="btnAddTypecode">+ Add New Typecode</button>
        </div>
      </div>

      <!-- Generate actions block -->
      <div class="flex items-center justify-between gap-3 flex-wrap border-t border-slate-100 pt-5 mt-6">
        <button type="button" class="button small primary" id="btnGenerate">⚡ Generate Typelist XML</button>
      </div>

      <!-- Generated Raw XML View Panel -->
      <div id="xmlOutputContainer" class="hidden mt-8 border-t border-slate-200 pt-8">
        <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
          <div>
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              Generated Typelist XML View
            </h3>
            <span class="text-xs text-slate-500">Preview generated XML before copying or exporting.</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="px-3 py-1.5 border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-lg transition-colors" id="copyXmlBtn">Copy XML</button>
            <button type="button" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg transition-colors" id="downloadXmlBtn">Download File</button>
          </div>
        </div>

        <pre id="rawXmlPre" class="bg-slate-950 text-slate-100 p-6 rounded-xl overflow-x-auto border border-slate-800 text-xs font-mono max-h-[400px] leading-relaxed select-all"></pre>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-typelist-generator.js?v=<%= Date.now() %>"></script>
</body>
</html>
