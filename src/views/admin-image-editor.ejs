<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Image Effects Editor · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:1500px;margin:0 auto;padding:16px;">
<%- include('partials/admin-nav') %>
  <div class="ve-standard-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <div>
      <h1 style="font-size:22px;margin:0 0 4px 0;display:flex;align-items:center;gap:8px;">
        🖼️ Image Effects Editor <span class="muted" style="font-weight:400;font-size:13px;">(Classified Documents & Cinematic Headlines)</span>
      </h1>
      <p class="muted" style="margin:0;font-size:13px;">Design classified redaction bars, yellow highlights, stamps, and cinematic headlines on canvas images.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <a href="/admin" class="button secondary small">← Admin Dashboard</a>
      <a href="/admin/video-editor" class="button secondary small">🎬 Video Editor</a>
    </div>
  </div>

  <section id="mainImageUploadCard" style="background:#eaf2ff;border:2px solid #93c5fd;border-radius:14px;padding:20px 22px;margin-bottom:16px;color:#0f172a;">
    <label for="bgImageInput" style="display:block;font-size:20px;font-weight:800;margin-bottom:6px;cursor:pointer;">1. Upload Main / Background Image</label>
    <p style="font-size:14px;margin:0 0 12px;color:#334155;">This is the base picture or canvas. Added images, shapes, blur, redactions, and text are separate layers placed on top of it.</p>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
      <input type="file" id="bgImageInput" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" style="display:block;font-size:15px;max-width:100%;padding:10px;background:white;border:1px solid #94a3b8;border-radius:8px;flex:1;min-width:240px;box-sizing:border-box;">
      <button type="button" id="btnRemoveMainImage" class="button secondary" disabled>✕ Remove Main Image</button>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:12px;">
      <label style="font-size:14px;font-weight:700;">Main image shape / mask
        <select id="bgShapeInput" style="display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #94a3b8;border-radius:6px;">
          <option value="rectangle">Original rectangle</option><option value="rounded-rectangle">Rounded rectangle</option><option value="circle">Circle / ellipse</option><option value="triangle">Triangle</option><option value="diamond">Diamond</option><option value="star">Five-point star</option><option value="heart">Heart</option><option value="hexagon">Hexagon</option><option value="octagon">Octagon</option><option value="arch">Arch</option><option value="speech-bubble">Speech bubble</option><option value="ticket">Ticket / coupon</option><option value="blob">Organic blob</option><option value="scalloped">Scalloped badge</option><option value="torn-paper">Torn paper collage</option>
        </select>
      </label>
      <label style="font-size:14px;font-weight:700;">Paper edge size (px)<input id="bgEdgeSize" type="number" min="1" max="80" value="18" style="display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #94a3b8;border-radius:6px;box-sizing:border-box;"></label>
      <label style="font-size:14px;font-weight:700;">Edge irregularity (%)<input id="bgIrregularity" type="number" min="0" max="100" value="70" style="display:block;width:100%;margin-top:5px;padding:8px;border:1px solid #94a3b8;border-radius:6px;box-sizing:border-box;"></label>
      <label style="font-size:14px;font-weight:700;">Mask edge / paper color<input id="bgEdgeColor" type="color" value="#f8f7f2" style="display:block;width:100%;height:36px;margin-top:5px;"></label>
      <label style="font-size:14px;font-weight:700;">Default canvas background<input id="canvasBgInput" type="color" value="#1e293b" style="display:block;width:100%;height:36px;margin-top:5px;"></label>
      <label style="font-size:14px;font-weight:700;">Transparent canvas (PNG/WebP)<input id="canvasBgTransparentInput" type="checkbox" style="display:block;width:20px;height:20px;margin-top:10px;"></label>
    </div>
    <p style="font-size:12px;margin:8px 0 0;color:#334155;">With no main image the canvas background fills the entire canvas. Added images and shapes are independent layers on top. The mask changes the visible outline of the main image. PNG/WebP exports keep the area outside the mask transparent; JPEG uses a solid background.</p>
  </section>

  <!-- Presets & Layer Toolbar -->
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px;background:#1e293b;color:#f8fafc;border-radius:10px;margin-bottom:16px;">
    <span style="font-weight:700;font-size:12px;color:#94a3b8;text-transform:uppercase;">Quick Presets:</span>
    <button type="button" class="button small primary" id="btnPresetClassified">📄 Classified Document</button>
    <button type="button" class="button small primary" id="btnPresetCinematic">🎬 Cinematic Headlines</button>
    <div style="width:1px;height:24px;background:#334155;margin:0 4px;"></div>
    <button type="button" class="button small secondary" id="btnUndo" disabled title="Undo (Ctrl+Z)">↶ Undo</button>
    <button type="button" class="button small secondary" id="btnRedo" disabled title="Redo (Ctrl+Y / Ctrl+Shift+Z)">↷ Redo</button>

    <div style="width:1px;height:24px;background:#334155;margin:0 4px;"></div>

    <span style="font-weight:700;font-size:12px;color:#94a3b8;text-transform:uppercase;">Add Layer:</span>
    <button type="button" class="button small secondary" id="btnAddRedaction">⬛ + Redaction Bar</button>
    <button type="button" class="button small secondary" id="btnAddHighlight">🟨 + Highlight</button>
    <button type="button" class="button small secondary" id="btnAddStamp">🏷️ + Stamp</button>
    <button type="button" class="button small secondary" id="btnAddHeadline">📰 + Headline</button>
    <button type="button" class="button small secondary" id="btnAddBlur">🌫️ + Blur Box</button>
    <label class="button small secondary" for="imageLayerInput" style="cursor:pointer;">🖼️ + Add Image(s)</label>
    <input type="file" id="imageLayerInput" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" multiple style="display:none;">

    <div style="width:1px;height:24px;background:#334155;margin:0 4px;"></div>
    <span style="font-weight:700;font-size:12px;color:#94a3b8;text-transform:uppercase;">Shapes:</span>
    <button type="button" class="button small secondary" id="btnShapeRectangle">▭ Rectangle</button>
    <button type="button" class="button small secondary" id="btnShapeRoundedRectangle">▢ Rounded</button>
    <button type="button" class="button small secondary" id="btnShapeCircle">◯ Ellipse</button>
    <button type="button" class="button small secondary" id="btnShapeTriangle">△ Triangle</button>
    <button type="button" class="button small secondary" id="btnShapeDiamond">◇ Diamond</button>
    <button type="button" class="button small secondary" id="btnShapeStar">☆ Star</button>

    <div style="width:1px;height:24px;background:#334155;margin:0 4px;"></div>

    <span style="font-size:12px;color:#cbd5e1;">2. Add layers and edit them below</span>
  </div>

  <!-- Main Canvas & Inspector Layout -->
  <div style="display:grid;grid-template-columns:1fr 360px;gap:16px;align-items:start;">
    
    <!-- Canvas Viewport -->
    <div style="background:#0b1120;border:1px solid #334155;border-radius:12px;padding:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:540px;">
      <div style="position:relative;max-width:100%;max-height:75vh;overflow:visible;box-shadow:0 10px 30px rgba(0,0,0,0.5);border-radius:8px;">
        <canvas id="imageCanvas" style="display:block;max-width:100%;max-height:75vh;width:auto;height:auto;cursor:crosshair;touch-action:none;user-select:none;-webkit-user-select:none;"></canvas>
      </div>
      <p id="statusMsg" style="font-size:12px;font-weight:600;margin:12px 0 0 0;color:#059669;"></p>
    </div>

    <!-- Inspector & Layer Panel -->
    <div style="display:flex;flex-direction:column;gap:16px;">
      
      <!-- Layer Order Panel -->
      <div style="background:#0f172a;border:1px solid #334155;border-radius:12px;padding:12px;color:#f8fafc;">
        <div style="font-weight:700;font-size:12px;color:#38bdf8;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
          <span>📚 Layer Order & Stack</span>
          <span class="muted" style="font-size:11px;">(Topmost renders on top)</span>
        </div>
        <div id="layerList" style="max-height:180px;overflow-y:auto;padding-right:4px;">
          <p class="muted" style="font-size:12px;margin:0;">Loading layers...</p>
        </div>
      </div>

      <!-- Effect Inspector -->
      <div style="background:#0f172a;border:1px solid #334155;border-radius:12px;padding:12px;color:#f8fafc;">
        <div style="font-weight:700;font-size:12px;color:#38bdf8;margin-bottom:8px;">
          📐 Layer Properties Inspector
        </div>
        <div id="effectInspector">
          <p class="muted" style="margin:0;font-size:13px;">Select a layer on canvas or list to edit properties.</p>
        </div>
      </div>

      <!-- Export Panel -->
      <div style="background:#0f172a;border:1px solid #334155;border-radius:12px;padding:12px;color:#f8fafc;">
        <div style="font-weight:700;font-size:12px;color:#38bdf8;margin-bottom:8px;">
          🚀 Image Export Options
        </div>
        <div style="display:flex;gap:8px;margin-bottom:10px;align-items:center;">
          <label style="flex:1;font-size:12px;">Format
            <select id="exportFormat" style="width:100%;margin-top:2px;background:#1e293b;color:#fff;border:1px solid #475569;border-radius:6px;padding:4px;">
              <option value="png" selected>PNG (High Quality / Lossless)</option>
              <option value="jpeg">JPEG (Compressed Photo)</option>
              <option value="webp">WEBP (Modern Web)</option>
            </select>
          </label>
        </div>
        <button type="button" class="button primary" id="btnExportImage" style="width:100%;">Download Edited Image</button>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script type="module" src="/admin-image-editor.js?v=<%= Date.now() %>"></script>
