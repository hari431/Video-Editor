<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create Paid Product · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container" style="max-width:600px;margin-top:24px;margin-bottom:48px;">
  <%- include('partials/admin-nav') %>

  <a href="/admin/paid-products" class="nav-link" style="display:inline-block;margin-bottom:16px;">&larr; Back to Paid Products</a>
  
  <h1>Create Paid Product</h1>
  <p class="muted">Define a new product. Products are mapped to system roles to control feature access.</p>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form method="post" action="/admin/paid-products/create" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:24px;margin-top:16px;">
    <% if (csrfToken) { %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% } %>

    <div style="margin-bottom:18px;">
      <label for="code" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Product Code</label>
      <input type="text" id="code" name="code" value="<%= (form && form.code) || '' %>" required placeholder="e.g. PREMIUM_PLUS" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;text-transform:uppercase;">
      <p class="muted" style="margin-top:4px;font-size:12px;">Unique identifier. Only uppercase letters, numbers, and underscores are allowed.</p>
    </div>

    <div style="margin-bottom:18px;">
      <label for="name" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Product Name</label>
      <input type="text" id="name" name="name" value="<%= (form && form.name) || '' %>" required placeholder="e.g. Premium Plus Membership" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
    </div>

    <div style="margin-bottom:18px;">
      <label for="description" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Description</label>
      <textarea id="description" name="description" rows="3" placeholder="Describe what features this product grants..." style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;font-family:sans-serif;"><%= (form && form.description) || '' %></textarea>
    </div>

    <div style="margin-bottom:18px;">
      <label for="role_id" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">RBAC Role Mapping</label>
      <select id="role_id" name="role_id" required style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;background:#fff;">
        <option value="">-- Select Target System Role --</option>
        <% roles.forEach(role => { %>
          <option value="<%= role.id %>" <%= (form && Number(form.role_id) === Number(role.id)) ? 'selected' : '' %>><%= role.name %> (<%= role.description || 'No description' %>)</option>
        <% }) %>
      </select>
      <p class="muted" style="margin-top:4px;font-size:12px;">When purchased, users are automatically granted this role.</p>
    </div>

    <div style="margin-bottom:18px;">
      <label for="max_active_members" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Maximum Active Members</label>
      <input type="number" id="max_active_members" name="max_active_members" value="<%= (form && form.max_active_members) || '' %>" min="1" placeholder="Unlimited" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
      <p class="muted" style="margin-top:4px;font-size:12px;">Optional capacity restriction. Leave empty/unset for unlimited members.</p>
    </div>

    <div style="margin-bottom:24px;display:flex;align-items:center;gap:8px;">
      <input type="checkbox" id="is_enabled" name="is_enabled" value="true" <%= (!form || form.is_enabled === 'true' || form.is_enabled === true) ? 'checked' : '' %>>
      <label for="is_enabled" style="font-weight:600;color:#2d3748;margin:0;">Enable product immediately</label>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end;">
      <a href="/admin/paid-products" class="button secondary" style="padding:10px 20px;text-decoration:none;">Cancel</a>
      <button type="submit" class="button success" style="padding:10px 20px;">Create Product</button>
    </div>
  </form>
</main>
</body>
</html>
