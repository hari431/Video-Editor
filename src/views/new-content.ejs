<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>New Content · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar"><a class="brand" href="/">Learn with me</a><% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %><a class="nav-link" href="/plans">💎 Available Plans</a><% } %><% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %><% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %><a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a><% } %><% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %><a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a><% } %><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<%- include('partials/access-expiry') %>
<main class="container">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>New Content</span></div>
  <section class="page-heading">
    <div><h1>📢 New content available</h1><p>You have new content to explore. Some items may have been added since your last login.</p></div>
  </section>
  <% if (items && items.length) { %>
  <div class="grid" data-testid="new-content-list">
    <% for (const item of items) { %>
      <div class="card new-content-card" data-testid="new-content-item" data-path="<%= item.path %>">
        <a class="new-content-link" href="<%= item.href %>">
          <div class="icon" aria-hidden="true"><%= item.kind === 'video' ? '🎬' : item.kind === 'pdf' ? '📕' : item.kind === 'document' ? '📝' : item.kind === 'spreadsheet' ? '📊' : item.kind === 'presentation' ? '📊' : item.kind === 'image' ? '🖼️' : item.kind === 'markdown' ? '📝' : item.kind === 'archive' ? '📦' : item.kind === 'text' ? '📄' : '📄' %></div>
          <div class="new-content-info">
            <strong class="new-content-title"><%= item.title %></strong>
            <small class="new-content-meta"><%= item.typeLabel %> · <%= item.category %> · <%= new Date(item.addedAt).toLocaleDateString() %></small>
          </div>
        </a>
        <div class="new-content-actions">
          <!-- Like Button Overlay -->
          <% const _canLike = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLike) { %>
          <% const itemLikes = (typeof likesMap !== 'undefined' && likesMap[item.path]) ? likesMap[item.path] : { liked: false, likeCount: 0 }; %>
          <div class="card-like-control like-control">
            <button class="card-like-btn like-btn <%= itemLikes.liked ? 'liked' : '' %>" data-path="<%= item.path %>" style="background: rgba(255, 255, 255, 0.95); border: 1px solid #cbd5e1; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 13px; color: <%= itemLikes.liked ? '#ef4444' : '#64748b' %>; padding: 6px 10px; border-radius: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); font-weight: 500; transition: all 0.2s; min-width: 54px; justify-content: center;">
              <span class="heart-icon"><%= itemLikes.liked ? '❤️' : '🤍' %></span>
              <span class="like-count"><%= itemLikes.likeCount %></span>
            </button>
          </div>
          <% } %>
          <form method="post" action="/my/new-content/ignore/<%= item.path.split('/').map(encodeURIComponent).join('/') %>" class="ignore-form">
            <button type="submit" class="ignore-btn" data-testid="ignore-item" aria-label="Ignore <%= item.title %>">Ignore</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
  <% } else { %>
    <p class="empty-folder" data-testid="new-content-empty">You're all caught up. New library content will appear here.</p>
  <% } %>
</main>
<%- include('partials/footer') %>
<script src="/like.js" defer></script>
</body></html>
