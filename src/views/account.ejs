<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>My Account · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .account-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 12px rgba(15,23,42,0.03);
      margin-bottom: 24px;
    }
    .product-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px;
      border-bottom: 1px solid #f1f5f9;
    }
    .product-row:last-child {
      border-bottom: none;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans">
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <a class="nav-link" href="/">📚 Browse Library</a>
  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <a class="nav-link" href="/plans">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container" style="max-width: 800px; margin: 40px auto; padding: 0 16px;">
  <h1 style="font-size: 32px; font-weight: 800; color: #1e293b; margin-bottom: 24px;">My Account</h1>
  
  <div class="account-card">
    <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 16px;">Profile Details</h2>
    <p><strong>Name:</strong> <%= user.name || 'N/A' %></p>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Status:</strong> <%= user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active' %></p>
    <p><strong>Access Until:</strong> <%= user.access_expires_at ? new Date(user.access_expires_at).toLocaleDateString() : 'N/A' %></p>
  </div>

  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <div class="account-card">
      <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 16px;">Paid Products & Grants</h2>
      <% if (allProducts && allProducts.length > 0) { %>
        <% allProducts.forEach(prod => { %>
          <div class="product-row">
            <div>
              <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 4px;"><%= prod.product_name %></h3>
              <p style="font-size: 14px; color: #64748b; margin: 0;">Plan: <%= prod.plan_name || 'Generic Grant' %> (<%= prod.billing_type === 'recurring' ? 'Recurring' : 'One-Time' %>)</p>
            </div>
            <div style="text-align: right;">
              <% const isActive = prod.status === 'active' && (!prod.valid_until || new Date(prod.valid_until) > new Date()); %>
              <% if (isActive) { %>
                <span class="badge badge-healthy" style="padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #ecfdf5; color: #047857;">ACTIVE</span>
              <% } else { %>
                <span class="badge badge-expired" style="padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #f1f5f9; color: #64748b;">EXPIRED</span>
              <% } %>
              <p style="font-size: 12px; color: #64748b; margin: 4px 0 0;">Until <%= prod.valid_until ? new Date(prod.valid_until).toLocaleDateString() : 'Forever' %></p>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: #64748b;">You do not have any paid products or grants.</p>
        <a href="/plans" style="display: inline-block; margin-top: 12px; padding: 8px 16px; background: #0284c7; color: white; border-radius: 6px; text-decoration: none; font-weight: 600;">View Available Plans</a>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
</body>
</html>
