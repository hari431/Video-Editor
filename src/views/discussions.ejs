<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Discussions · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <a class="nav-link" href="/plans">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<%- include('partials/access-expiry') %>
<main class="container">
  <% const contentHref = contentRouteForPath(itemPath) + itemPath.split('/').map(encodeURIComponent).join('/'); %>
  <div class="breadcrumbs">
    <a href="/">Home</a>
    <span>/</span>
    <a href="<%= contentHref %>"><%= itemPath.split('/').at(-1) %></a>
    <span>/</span>
    <span>Discussions</span>
  </div>

  <section class="page-heading">
    <h1>Discussions for <%= displayName(itemPath.split('/').at(-1)) %></h1>
    <p><a href="<%= contentHref %>">Back to content</a></p>
  </section>

  <% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <div class="discussion-filters">
    <% const filters = [{key:'all',label:'All'},{key:'unanswered',label:'Unanswered'},{key:'answered',label:'Answered'},{key:'most-replies',label:'Most Replies'},{key:'newest',label:'Newest'}]; %>
    <% filters.forEach(f => { %>
      <a href="/discussions?path=<%= encodeURIComponent(itemPath) %>&filter=<%= f.key %>" class="discussion-filter<%= f.key === currentFilter ? ' active' : '' %>"><%= f.label %></a>
    <% }) %>
  </div>

  <% const _canDiscuss = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
  <% if (_canDiscuss) { %>
  <form method="post" action="/discussions" class="discussion-new-form">
    <input type="hidden" name="item_path" value="<%= itemPath %>">
    <input type="text" name="title" placeholder="Question title" required maxlength="200" class="discussion-input-title">
    <textarea name="body" placeholder="Details (optional)" rows="3" maxlength="50000" class="discussion-input-body"></textarea>
    <button type="submit" class="button primary">Ask a Question</button>
  </form>
  <% } else { %>
  <div class="flash flash-ok" data-testid="discussions-readonly-msg" style="margin: 12px 0; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">Discussions are available in read-only mode. Posting, replying and liking requires active access.</div>
  <% } %>

  <% if (discussions.length === 0) { %>
    <p class="muted">No questions yet. Be the first to ask!</p>
  <% } else { %>
    <div class="discussion-list">
      <% discussions.forEach(d => { %>
        <% const _ac = Number(d.accepted_count || 0); %>
        <div class="discussion-card<%= d.status === 'hidden' ? ' discussion-hidden' : '' %><%= _ac ? ' discussion-accepted' : '' %>">
          <div class="discussion-card-main">
            <h3><a href="/discussions/<%= d.id %>"><%- (typeof linkifyBody === 'function' ? linkifyBody(d.title) : String(d.title||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></a><% if (_ac) { %> <span class="badge" style="background:#2e7d32;color:#fff;font-size:11px;vertical-align:middle;margin-left:6px">✓ <%= _ac %> Accepted</span><% } %></h3>
            <p class="discussion-meta">
              <span class="discussion-author"><%= user.isAdmin ? (d.author_name || 'Unknown') : (d.user_id === user.id ? 'You' : (d.status === 'hidden' ? 'Hidden' : 'Anonymous')) %></span>
              <span class="discussion-date"><%= new Date(d.created_at).toLocaleDateString() %></span>
              <span class="discussion-replies"><%= d.reply_count %> <%= d.reply_count === 1 ? 'reply' : 'replies' %></span>
              <% if (d.status === 'pending') { %>
                <span class="badge" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:2px 6px;border-radius:4px;font-size:11px;">Pending Approval</span>
              <% } else if (d.status === 'approved') { %>
                <span class="badge" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:2px 6px;border-radius:4px;font-size:11px;">Approved</span>
              <% } %>
            </p>
            <% if (d.body) { %><p class="discussion-preview"><%- (typeof linkifyBody === 'function' ? linkifyBody(d.body.length > 200 ? d.body.slice(0, 200) + '...' : d.body) : String(d.body.length > 200 ? d.body.slice(0, 200) + '...' : d.body).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></p><% } %>
          </div>
          <div class="discussion-card-actions">
            <% if (!user.isAdmin && d.user_id === user.id) { %>
              <form method="post" action="/discussions/<%= d.id %>/delete" class="discussion-delete-form" style="display:inline">
                <button type="submit" class="button small danger discussion-delete-btn">Delete</button>
              </form>
            <% } %>
            <% if (user.isAdmin) { %>
              <% if (d.status === 'pending') { %>
                <form method="post" action="/admin/discussions/<%= d.id %>/approve" style="display:inline">
                  <button type="submit" class="button small success" style="font-weight: bold;">Approve</button>
                </form>
              <% } %>
              <% if (d.status === 'visible' || d.status === 'approved') { %>
                <form method="post" action="/admin/discussions/<%= d.id %>/hide" style="display:inline">
                  <button type="submit" class="button small">Hide</button>
                </form>
              <% } else if (d.status === 'hidden') { %>
                <form method="post" action="/admin/discussions/<%= d.id %>/unhide" style="display:inline">
                  <button type="submit" class="button small">Unhide</button>
                </form>
              <% } %>
              <% if (d.status !== 'deleted') { %>
                <form method="post" action="/admin/discussions/<%= d.id %>/delete" style="display:inline" class="discussion-delete-form">
                  <button type="submit" class="button small danger discussion-delete-btn">Delete</button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
<script src="/discussions.js" defer></script>
</body></html>
