<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PDF Metadata · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>PDF Metadata</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. View and edit a local PDF's title, author, subject, keywords, creator and producer, then download a <strong>new</strong> file. Everything else in the document is preserved. Emptying a field clears it. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfMetadataAvailable !== 'undefined' ? !!pdfMetadataAvailable : false; %>
<% const _maxMb = (typeof pdfMetadataMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfMetadataMaxFileMb)) && Number(pdfMetadataMaxFileMb) >= 1) ? Math.floor(Number(pdfMetadataMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-metadata-disabled">PDF metadata is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-metadata-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfMetadataPick" data-testid="pdf-metadata-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfMetadataFile" data-testid="pdf-metadata-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfMetadataFileInfo" data-testid="pdf-metadata-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Document metadata</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">Title
      <input type="text" id="pdfMetadataTitle" data-testid="pdf-metadata-title" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">Author
      <input type="text" id="pdfMetadataAuthor" data-testid="pdf-metadata-author" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">Subject
      <input type="text" id="pdfMetadataSubject" data-testid="pdf-metadata-subject" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">Keywords (comma-separated)
      <input type="text" id="pdfMetadataKeywords" data-testid="pdf-metadata-keywords" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">Creator
      <input type="text" id="pdfMetadataCreator" data-testid="pdf-metadata-creator" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">Producer
      <input type="text" id="pdfMetadataProducer" data-testid="pdf-metadata-producer" maxlength="500" style="width:100%;max-width:480px;" <%= _available ? '' : 'disabled' %>>
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfMetadataBtn" data-testid="pdf-metadata-submit" <%= _available ? '' : 'disabled' %>>💾 Save &amp; download</button>
    <button type="button" class="button small secondary" id="pdfMetadataClear" data-testid="pdf-metadata-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfMetadataProgress" data-testid="pdf-metadata-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Saving… <span id="pdfMetadataProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-metadata-status" id="pdfMetadataStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-metadata-result" id="pdfMetadataResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-metadata.js?v=<%= Date.now() %>"></script>
</body></html>
