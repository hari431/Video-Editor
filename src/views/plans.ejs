<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Available Plans · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans">
<header class="topbar">
  <a class="brand" href="/" id="brandLink">Learn with me</a>
  <a class="nav-link" href="/" id="libraryLink">📚 Browse Library</a>
  <% if ((typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) || (typeof user !== 'undefined' && user && user.app_role === 'ADMIN')) { %>
    <a class="nav-link font-bold" href="/plans" id="plansLink" style="text-decoration: underline;">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes" id="likesLink">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>

<main class="container" style="max-width: 1040px; margin: 40px auto; padding: 0 16px;">
  <section class="page-heading" style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 34px; font-weight: 800; color: #0f172a; letter-spacing: -0.025em; margin-bottom: 8px;">💎 Premium Upgrades & Products</h1>
    <p class="muted" style="font-size: 16px; color: #64748b; max-width: 620px; margin: 0 auto; line-height: 1.6;">Unlock specialized modules, professional learning materials, and ad-free capabilities to enhance your learning experience.</p>
  </section>

  <% if (successMessage) { %>
    <div class="flash flash-ok" style="margin-bottom: 24px; text-align: center; background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 14px; border-radius: 10px; font-weight: 600;" id="successBanner">
      <%= successMessage %>
    </div>
  <% } %>
  
  <% if (errorMessage) { %>
    <div class="flash flash-error" style="margin-bottom: 24px; text-align: center; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px; border-radius: 10px; font-weight: 600;" id="errorBanner">
      <%= errorMessage %>
    </div>
  <% } %>

  <div style="display: flex; flex-direction: column; gap: 32px;" id="productsContainer">
    <% if (products && products.length > 0) { %>
      <% products.forEach(product => { %>
        <div class="card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px; box-shadow: 0 4px 16px rgba(15,23,42,0.04);" id="product-card-<%= product.id %>">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 18px; margin-bottom: 22px;">
            <div>
              <div style="display: flex; align-items: center; gap: 10px;">
                <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0;"><%= product.name %></h2>
              </div>
              <p style="color: #64748b; font-size: 14px; margin: 4px 0 0; line-height: 1.5;"><%= product.description || 'Comprehensive learning modules and resources.' %></p>
            </div>
            <div>
              <% if (product.entitlement && product.entitlement.hasEntitlement) { 
                   let ownedPlanForBadge = null;
                   if (product.entitlement.primaryGrantType === 'one_time_purchase') {
                     ownedPlanForBadge = product.plans.find(p => p.billing_type === 'one_time');
                   } else if (product.entitlement.primaryGrantType === 'subscription_cycle') {
                     ownedPlanForBadge = product.plans.find(p => p.billing_type === 'recurring');
                   }
                   if (!ownedPlanForBadge && product.entitlement.activeGrants && product.entitlement.activeGrants.length > 0) {
                     const grantPlanId = product.entitlement.activeGrants[0].plan_id;
                     if (grantPlanId) ownedPlanForBadge = product.plans.find(p => p.id === grantPlanId);
                     if (!ownedPlanForBadge) {
                       const grantType = product.entitlement.activeGrants[0].grant_type;
                       if (grantType === 'one_time_purchase') ownedPlanForBadge = product.plans.find(p => p.billing_type === 'one_time');
                       else if (grantType === 'subscription_cycle') ownedPlanForBadge = product.plans.find(p => p.billing_type === 'recurring');
                     }
                   }
              %>
                <span class="badge badge-healthy" style="padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;" id="entitlement-status-<%= product.id %>">
                  ✓ ACTIVE <%= ownedPlanForBadge ? '— ' + ownedPlanForBadge.name.toUpperCase() : 'ACCESS' %> <%= product.entitlement.furthestExpiry ? '(Until ' + new Date(product.entitlement.furthestExpiry).toLocaleDateString() + ')' : '' %>
                </span>
              <% } else if (product.atCapacity) { %>
                <span class="badge badge-error" style="padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #fef2f2; color: #991b1b; border: 1px solid #fee2e2;" id="entitlement-status-<%= product.id %>" data-testid="capacity-status-badge-<%= product.code %>">
                  Currently at Capacity
                </span>
              <% } else { %>
                <span class="badge badge-neutral" style="padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;" id="entitlement-status-<%= product.id %>">
                  AVAILABLE TO PURCHASE
                </span>
              <% } %>
              <% if (typeof isDev !== 'undefined' ? isDev : (['development', 'test'].includes(process.env.NODE_ENV))) { %>
                <div style="margin-top: 8px; text-align: right;">
                  <button type="button" 
                          onclick="simulateCancellationForProduct(<%= product.id %>)" 
                          id="simulate-cancel-btn-<%= product.id %>" 
                          style="background: #f8fafc; color: #475569; border: 1px dashed #94a3b8; padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 600; cursor: pointer;"
                          title="Dev tool: simulate provider cancellation for testing repurchase">
                    🧪 Simulate Provider Cancellation (Local)
                  </button>
                </div>
              <% } %>
            </div>
          </div>

          <% if (product.pendingCancellation) { %>
            <div style="margin-bottom:16px; background:#fffbeb; border:1px solid #fde68a; color:#92400e; padding:14px 16px; border-radius:10px; font-size:13.5px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;" id="pending-cancel-<%= product.id %>">
              <span>⚠️ This subscription was cancelled and will expire on <%= new Date(product.pendingCancellation.current_period_end).toLocaleDateString() %>. You can resume before expiry without a new charge.</span>
              <button type="button" onclick="resumeSubscription(<%= product.id %>)" id="resume-btn-<%= product.id %>" style="background:#0284c7; color:#fff; border:none; padding:8px 16px; border-radius:8px; font-weight:700; cursor:pointer; font-size:13px; white-space:nowrap;">↩ Resume Subscription</button>
            </div>
          <% } %>
          <% if (product.plans && product.plans.length > 0) { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 10px;">
              <% product.plans.forEach(plan => { 
                   let isPlanOwned = false;
                   let isRepurchaseBlocked = false;

                   if (product.entitlement && product.entitlement.hasEntitlement) {
                     // Check specific plan ownership from active grants (exact plan_id match)
                     if (product.entitlement.activeGrants && product.entitlement.activeGrants.some(g => g.plan_id === plan.id)) {
                       isPlanOwned = true;
                     } else if (product.entitlement.activeGrants && product.entitlement.activeGrants.length > 0) {
                        // Fallback for legacy grants where plan_id is null or mismatched: use grant_type + billing_type (product-scoped)
                        const hasMatchingTypeGrant = product.entitlement.activeGrants.some(g => {
                          if (g.product_id != null && String(g.product_id) !== String(product.id)) return false;
                          if (g.grant_type === 'one_time_purchase' && plan.billing_type === 'one_time') return true;
                          if (g.grant_type === 'subscription_cycle' && plan.billing_type === 'recurring') return true;
                          return false;
                        });
                       if (hasMatchingTypeGrant) {
                         if ((plan.billing_type === 'one_time' && product.entitlement.primaryGrantType === 'one_time_purchase') ||
                             (plan.billing_type === 'recurring' && product.entitlement.primaryGrantType === 'subscription_cycle')) {
                           isPlanOwned = true;
                         } else if (!product.entitlement.primaryGrantType && hasMatchingTypeGrant) {
                           isPlanOwned = true;
                         }
                       }
                     } else if (product.entitlement.activeGrants && product.entitlement.activeGrants.length === 0) {
                       // Legacy fallback when no active grants but entitlement via users table (access_expires_at)
                       if (plan.billing_type === 'recurring' && product.entitlement.primaryGrantType === 'subscription_cycle') {
                         isPlanOwned = true;
                       } else if (plan.billing_type === 'one_time' && product.entitlement.primaryGrantType === 'one_time_purchase') {
                         isPlanOwned = true;
                       }
                     }
                     
                     // Repurchase block rules
                     if (isPlanOwned) {
                       isRepurchaseBlocked = true;
                     } else if (product.entitlement.primaryGrantType === 'subscription_cycle') {
                       // Active subscription prevents buying one-time passes or other subs for the same product
                       isRepurchaseBlocked = true;
                     } else if (plan.billing_type === 'one_time' && product.entitlement.primaryGrantType === 'one_time_purchase') {
                       // Active one-time prevents buying other one-time passes
                       isRepurchaseBlocked = true;
                     }
                   }
                   const isRecurring = plan.billing_type === 'recurring';
                   const isSelectionAllowed = !isRepurchaseBlocked && !product.atCapacity;
              %>
                <div class="plan-selector-box" 
                     id="plan-box-<%= plan.id %>" 
                     data-plan-id="<%= plan.id %>"
                     data-product-id="<%= product.id %>"
                     <% if (isSelectionAllowed) { %>onclick="selectPlan(<%= plan.id %>, '<%= plan.billing_type %>', <%= plan.price_amount_paise %>, '<%= plan.currency %>', '<%= plan.name %>', '<%= product.name %>', <%= product.id %>)"<% } %>
                     style="display: flex; flex-direction: column; justify-content: space-between; border: 2px solid #e2e8f0; border-radius: 12px; padding: 22px; transition: all 0.2s ease; position: relative; background: <%= !isSelectionAllowed ? '#f8fafc' : '#ffffff' %>; cursor: <%= !isSelectionAllowed ? 'not-allowed' : 'pointer' %>; opacity: <%= !isSelectionAllowed ? '0.6' : '1' %>; box-shadow: 0 2px 6px rgba(15,23,42,0.03);">
                  
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                      <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 3px 8px; border-radius: 6px; background: <%= isRecurring ? '#eef2ff' : '#ecfdf5' %>; color: <%= isRecurring ? '#4338ca' : '#047857' %>; border: 1px solid <%= isRecurring ? '#c7d2fe' : '#a7f3d0' %>;">
                        <%= isRecurring ? '🔄 Monthly Auto-Renew' : (plan.duration_days ? '⚡ ' + plan.duration_days + '-Day Pass' : '⚡ One-Time Pass') %>
                      </span>
                      <div style="background: #0284c7; color: #ffffff; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; display: none;" id="plan-selected-badge-<%= plan.id %>">✓ SELECTED</div>
                      <% if (isPlanOwned) { %>
                        <div style="background: #f1f5f9; color: #475569; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;">ALREADY OWNED</div>
                      <% } else if (product.atCapacity) { %>
                        <div style="background: #fee2e2; color: #991b1b; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;" data-testid="capacity-badge-<%= plan.id %>">AT CAPACITY</div>
                      <% } else if (isRepurchaseBlocked) { %>
                        <div style="background: #f1f5f9; color: #475569; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;">UNAVAILABLE</div>
                      <% } %>
                    </div>
                    
                    <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 10px;"><%= plan.name %></h3>
                    
                    <div style="margin-bottom: 16px;">
                      <span style="font-size: 28px; font-weight: 800; color: #0f172a;"><%= plan.currency === 'INR' ? '₹' : plan.currency + ' ' %><%= (plan.price_amount_paise / 100).toFixed(2) %></span>
                      <span style="font-size: 14px; color: #64748b; font-weight: 500;">
                        <%= isRecurring ? '/ month' : (plan.duration_days ? ' for ' + plan.duration_days + ' days' : ' one-time') %>
                      </span>
                    </div>
                    
                    <ul style="list-style: none; padding: 0; margin: 0 0 20px; font-size: 13.5px; color: #475569; line-height: 1.7;">
                      <% if (isRecurring) { %>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span>Automatic monthly renewal</span>
                        </li>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span>Continuous uninterrupted access</span>
                        </li>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span>Cancel anytime with 1-click</span>
                        </li>
                      <% } else { %>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span><%= plan.duration_days ? plan.duration_days + ' days of full access' : 'Full access period' %></span>
                        </li>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span>No recurring billing or surprises</span>
                        </li>
                        <li style="margin-bottom: 6px; display: flex; align-items: flex-start; gap: 8px;">
                          <span style="color: #10b981; font-weight: bold;">✓</span> <span>One-time secure payment</span>
                        </li>
                      <% } %>
                    </ul>
                  </div>

                  <div>
                    <% if (isSelectionAllowed) { %>
                      <button type="button" class="plan-cta-btn" id="plan-btn-<%= plan.id %>" style="width: 100%; border: 1px solid #cbd5e1; font-size: 14px; font-weight: 700; padding: 10px; border-radius: 8px; cursor: pointer; transition: all 0.15s; background: #f8fafc; color: #1e293b;">
                        <%= isRecurring ? 'Choose Monthly' : (plan.duration_days ? 'Get ' + plan.duration_days + ' Days' : 'Get Access') %>
                      </button>
                    <% } else if (product.atCapacity && !isPlanOwned) { %>
                      <button type="button" class="plan-cta-btn" id="plan-btn-<%= plan.id %>" disabled style="width: 100%; border: 1px solid #fee2e2; font-size: 14px; font-weight: 700; padding: 10px; border-radius: 8px; cursor: not-allowed; background: #fef2f2; color: #991b1b;" data-testid="disabled-purchase-btn-<%= plan.id %>">
                        Currently at Capacity
                      </button>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="muted" style="text-align: center; margin: 12px 0;">No active plans available for this product at this time.</p>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <div style="background: #fff; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 40px; text-align: center;" id="emptyState">
        <p class="muted" style="margin: 0; font-size: 15px;">No customer-facing paid products or plans are currently available.</p>
      </div>
    <% } %>
  </div>

  <!-- CHECKOUT SECTION (DYNAMIC ON SELECTION) -->
  <div id="checkoutSummarySection" style="display: none; background: #0f172a; color: #f8fafc; border-radius: 14px; padding: 28px; margin-top: 40px; box-shadow: 0 12px 30px rgba(15,23,42,0.25); border: 1px solid #1e293b;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 14px; margin-bottom: 20px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #ffffff; margin: 0; display: flex; align-items: center; gap: 8px;">
        <span>🔒</span> Secure Checkout Summary
      </h2>
      <span style="font-size: 12px; color: #94a3b8; font-weight: 500;">Encrypted & Verified</span>
    </div>
    
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; background: #1e293b; padding: 18px 20px; border-radius: 10px; border: 1px solid #334155;">
      <div>
        <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;" id="summaryProductLabel">SELECTED PRODUCT & PLAN</span>
        <h3 style="font-size: 18px; font-weight: 700; margin: 4px 0 2px; color: #f8fafc;" id="summaryProductName"></h3>
        <span style="font-size: 13.5px; color: #38bdf8; font-weight: 600;" id="summaryPlanName"></span>
      </div>
      <div style="text-align: right;">
        <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">TOTAL AMOUNT</span>
        <div style="font-size: 28px; font-weight: 800; color: #38bdf8;" id="summaryFinalPrice"></div>
      </div>
    </div>

    <!-- PROMO ENTRY -->
    <div style="background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 20px; margin-bottom: 24px;">
      <!-- ADVERTISED PROMOTIONS CONTAINER (Filtered per selected product and one-time billing only) -->
      <div id="advertisedPromosContainer" style="display: none; margin-bottom: 16px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 14px;">
        <span style="font-size: 11.5px; font-weight: 700; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 10px;">✨ Available One-Time Offers</span>
        <div style="display: flex; flex-direction: column; gap: 8px;" id="advertisedPromosList">
          <% if (typeof activePromotions !== 'undefined' && activePromotions && activePromotions.length > 0) { %>
            <% activePromotions.forEach(promo => { %>
              <% 
                const discountStr = promo.discount_type === 'percentage' 
                  ? promo.discount_value + '%' 
                  : '₹' + (promo.discount_value / 100);
              %>
              <div class="promo-badge" 
                   id="promo-item-<%= promo.id %>"
                   data-product-id="<%= promo.product_id %>"
                   data-promo-code="<%= promo.code %>"
                   onclick="selectAdvertisedPromo('<%= promo.code %>')" 
                   style="display: none; align-items: center; justify-content: space-between; border: 1px dashed #38bdf8; border-radius: 8px; padding: 10px 14px; background: #1e293b; cursor: pointer; transition: all 0.15s; font-size: 13px; color: #f8fafc;" 
                   onmouseover="this.style.background='#283548'; this.style.borderColor='#7dd3fc';" 
                   onmouseout="this.style.background='#1e293b'; this.style.borderColor='#38bdf8';">
                <span>Use code <strong style="font-family: monospace; background: #0f172a; padding: 3px 8px; border-radius: 4px; border: 1px solid #334155; color: #38bdf8; font-size: 13px;"><%= promo.code %></strong> for <strong><%= discountStr %></strong> off</span>
                <span style="font-weight: 700; color: #38bdf8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Click to Apply</span>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <label for="promoCodeInput" style="display: block; font-size: 12.5px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Have a Promotion or Coupon Code?</label>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <input type="text" id="promoCodeInput" placeholder="ENTER CODE" style="flex: 1; min-width: 200px; padding: 11px 16px; border: 1px solid #334155; border-radius: 8px; font-size: 14px; background: #0f172a; color: #ffffff; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">
        <button id="applyPromoBtn" onclick="applyPromoCode()" style="background: #38bdf8; color: #0f172a; border: none; padding: 11px 24px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; transition: all 0.15s; min-height: 42px;">Apply</button>
      </div>
      <div id="promoMessage" style="font-size: 13.5px; margin-top: 10px; min-height: 20px;"></div>
    </div>

    <!-- PAYMENT LAUNCH BUTTON -->
    <div style="text-align: center;">
      <button id="checkoutBtn" onclick="launchPayment()" style="background: #38bdf8; color: #0f172a; border: none; font-size: 16px; font-weight: 800; padding: 14px 36px; border-radius: 10px; cursor: pointer; transition: all 0.15s; width: 100%; max-width: 360px; box-shadow: 0 4px 16px rgba(56,189,248,0.3);">
        Pay and Subscribe Securely
      </button>
      <div style="margin-top: 10px; font-size: 12px; color: #94a3b8;">Protected by 256-bit encryption · Official Payment Gateway</div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  window.addEventListener('unhandledrejection', function(e){ console.error('Unhandled rejection:', e.reason); });
  function fetchWithTimeout(url, opts, ms){
    ms = ms || 10000;
    var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
    var tid = null;
    if(ctrl){ opts = opts || {}; opts.signal = ctrl.signal; tid = setTimeout(function(){ try{ ctrl.abort(); }catch(e){} }, ms); }
    var p = fetch(url, opts);
    if(tid) p = p.finally(function(){ clearTimeout(tid); });
    return p;
  }
  let selectedPlanId = null;
  let selectedProductId = null;
  let selectedBillingType = null;
  let selectedBasePricePaise = 0;
  let selectedCurrency = 'INR';
  let appliedPromoCode = '';
  let discountInfo = null;

  function selectAdvertisedPromo(code) {
    const input = document.getElementById('promoCodeInput');
    if (input) {
      input.value = code;
      applyPromoCode();
    }
  }
  window.selectAdvertisedPromo = selectAdvertisedPromo;

  function selectPlan(planId, billingType, pricePaise, currency, planName, productName, productId) {
    selectedPlanId = planId;
    selectedProductId = productId;
    selectedBillingType = billingType;
    selectedBasePricePaise = pricePaise;
    selectedCurrency = currency;
    appliedPromoCode = '';
    discountInfo = null;

    // Reset input and messages
    const promoInput = document.getElementById('promoCodeInput');
    if (promoInput) promoInput.value = '';
    const promoMsg = document.getElementById('promoMessage');
    if (promoMsg) promoMsg.innerHTML = '';

    // Update active visual selections on plan selector boxes
    document.querySelectorAll('.plan-selector-box').forEach(box => {
      box.style.border = '2px solid #e2e8f0';
      box.style.background = '#ffffff';
      box.style.boxShadow = '0 2px 6px rgba(15,23,42,0.03)';
    });

    document.querySelectorAll('.plan-cta-btn').forEach(btn => {
      btn.style.background = '#f8fafc';
      btn.style.color = '#1e293b';
      btn.style.borderColor = '#cbd5e1';
    });

    const activeBox = document.getElementById('plan-box-' + planId);
    if (activeBox) {
      activeBox.style.border = '2px solid #0284c7';
      activeBox.style.background = '#f0f9ff';
      activeBox.style.boxShadow = '0 6px 18px rgba(2,132,199,0.12)';
    }

    const activeBtn = document.getElementById('plan-btn-' + planId);
    if (activeBtn) {
      activeBtn.style.background = '#0284c7';
      activeBtn.style.color = '#ffffff';
      activeBtn.style.borderColor = '#0284c7';
    }

    // Update badges
    document.querySelectorAll('[id^="plan-selected-badge-"]').forEach(badge => {
      badge.style.display = 'none';
    });
    const selectedBadge = document.getElementById('plan-selected-badge-' + planId);
    if (selectedBadge) {
      selectedBadge.style.display = 'block';
    }

    // Filter advertised promotions strictly for ONE_TIME billing and matching productId
    const promoContainer = document.getElementById('advertisedPromosContainer');
    if (promoContainer) {
      if (billingType === 'one_time') {
        let matchingPromoCount = 0;
        document.querySelectorAll('.promo-badge[data-product-id]').forEach(badge => {
          const promoProdId = badge.getAttribute('data-product-id');
          if (String(promoProdId) === String(productId)) {
            badge.style.display = 'flex';
            matchingPromoCount++;
          } else {
            badge.style.display = 'none';
          }
        });
        promoContainer.style.display = matchingPromoCount > 0 ? 'block' : 'none';
      } else {
        // Recurring payments have NO advertised promos
        document.querySelectorAll('.promo-badge[data-product-id]').forEach(badge => {
          badge.style.display = 'none';
        });
        promoContainer.style.display = 'none';
      }
    }

    // Show secure checkout summary
    document.getElementById('summaryProductName').innerText = productName;
    document.getElementById('summaryPlanName').innerText = planName + ' (' + (billingType === 'recurring' ? 'Monthly Auto-Renew Subscription' : 'One-Time Pass') + ')';
    
    updateSummaryPrice();
    
    const checkoutSummary = document.getElementById('checkoutSummarySection');
    checkoutSummary.style.display = 'block';
    
    // Smooth scroll to checkout summary
    checkoutSummary.scrollIntoView({ behavior: 'smooth' });
  }

  function updateSummaryPrice() {
    const currencySym = selectedCurrency === 'INR' ? '₹' : selectedCurrency + ' ';
    let finalAmount = selectedBasePricePaise / 100;
    
    if (discountInfo && discountInfo.valid) {
      finalAmount = discountInfo.finalAmount;
      document.getElementById('summaryFinalPrice').innerHTML = `<span style="text-decoration: line-through; color: #94a3b8; font-size: 16px; margin-right: 8px;">${currencySym}${(selectedBasePricePaise / 100).toFixed(2)}</span> ${currencySym}${finalAmount.toFixed(2)}`;
    } else {
      document.getElementById('summaryFinalPrice').innerText = currencySym + finalAmount.toFixed(2);
    }

    const checkoutBtn = document.getElementById('checkoutBtn');
    if (checkoutBtn) {
      if (selectedBillingType === 'recurring') {
        checkoutBtn.innerText = 'Pay and Subscribe Securely';
      } else {
        checkoutBtn.innerText = 'Pay and Unlock Access';
      }
    }
  }

  async function applyPromoCode() {
    const code = document.getElementById('promoCodeInput').value.trim();
    const applyBtn = document.getElementById('applyPromoBtn');
    const msgEl = document.getElementById('promoMessage');

    if (!code) {
      msgEl.innerHTML = `<span style="color: #f87171; font-weight: 600;">Please enter a promo code first.</span>`;
      return;
    }

    applyBtn.disabled = true;
    applyBtn.innerText = 'Applying...';

    try {
      const res = await fetchWithTimeout('/api/payments/validate-promo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ promoCode: code, planId: selectedPlanId })
      }, 8000);
      const data = await res.json();
      if (data.status === 'success' && data.valid) {
        discountInfo = data;
        appliedPromoCode = code;
        msgEl.innerHTML = `<span style="color: #34d399; font-weight: 600;">✓ Coupon applied: Saved ${selectedCurrency === 'INR' ? '₹' : selectedCurrency + ' '}${data.discountAmount.toFixed(2)}!</span>`;
        updateSummaryPrice();
      } else {
        discountInfo = null;
        appliedPromoCode = '';
        msgEl.innerHTML = `<span style="color: #f87171; font-weight: 600;">${data.message || 'Invalid or expired promotion code.'}</span>`;
        updateSummaryPrice();
      }
    } catch (err) {
      console.error(err);
      if(err && err.name==='AbortError') msgEl.innerHTML = `<span style="color: #f87171; font-weight: 600;">Request timed out. Please try again.</span>`;
      else msgEl.innerHTML = `<span style="color: #f87171; font-weight: 600;">Failed to validate promotion code.</span>`;
    } finally {
      applyBtn.disabled = false;
      applyBtn.innerText = 'Apply';
    }
  }

  let checkoutProcessing = false;
  async function launchPayment() {
    if (checkoutProcessing) return;
    checkoutProcessing = true;
    const checkoutBtn = document.getElementById('checkoutBtn');
    checkoutBtn.disabled = true;
    checkoutBtn.style.opacity = '0.6';
    checkoutBtn.style.pointerEvents = 'none';
    checkoutBtn.innerText = 'Preparing Checkout...';

    try {
      if (selectedBillingType === 'recurring') {
        // Recurring subscription payment flow (bounded)
        const response = await fetchWithTimeout('/api/payments/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId: selectedPlanId, promoCode: appliedPromoCode })
        }, 15000);
        if (!response.ok) {
          const err = await response.json();
          if (err.resumeRequired || err.code === 'PENDING_CANCELLATION') {
            // Pending cancellation — offer resume instead of duplicate checkout
            if (confirm((err.message || 'Pending cancellation') + '\n\nWould you like to resume your existing subscription without a new charge?')) {
              checkoutBtn.innerText = 'Resuming...';
              const resumeRes = await fetchWithTimeout('/api/payments/resume', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId: selectedProductId }) }, 10000);
              const resumeData = await resumeRes.json();
              if (!resumeRes.ok || resumeData.status !== 'success') throw new Error(resumeData.message || 'Resume failed');
              window.location.reload();
              return;
            }
          }
          throw new Error(err.message || 'Failed to initialize subscription');
        }
        const data = await response.json();
        
        const options = {
          key: '<%= razorpayKeyId %>',
          subscription_id: data.subscriptionId,
          name: 'Learn with me',
          description: 'Recurring Access Subscription',
          handler: async function (paymentResponse) {
            checkoutBtn.innerText = 'Verifying payment...';
            try {
              const verifyRes = await fetchWithTimeout('/api/payments/verify-subscription', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_payment_id: paymentResponse.razorpay_payment_id,
                  razorpay_subscription_id: paymentResponse.razorpay_subscription_id,
                  razorpay_signature: paymentResponse.razorpay_signature,
                  promoCode: appliedPromoCode
                })
              }, 12000);
              if (!verifyRes.ok) {
                const err = await verifyRes.json();
                throw new Error(err.message || 'Verification failed');
              }
              window.location.href = '/plans?success=true';
            } catch (err) {
              alert('Payment verification failed: ' + err.message);
              checkoutBtn.disabled = false;
              checkoutBtn.style.opacity = '';
              checkoutBtn.style.pointerEvents = '';
              checkoutProcessing = false;
              updateSummaryPrice();
            }
          },
          prefill: {
            name: '<%= user.name %>',
            email: '<%= user.email %>'
          },
          theme: { color: '#0284c7' },
          modal: {
            ondismiss: function() {
              checkoutBtn.disabled = false;
              checkoutBtn.style.opacity = '';
              checkoutBtn.style.pointerEvents = '';
              checkoutProcessing = false;
              updateSummaryPrice();
            }
          }
        };
        const rzp = new Razorpay(options);
        rzp.open();

      } else {
        // One-time order flow (bounded)
        const response = await fetchWithTimeout('/api/payments/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId: selectedPlanId, promoCode: appliedPromoCode })
        }, 15000);
        if (!response.ok) {
          const err = await response.json();
          throw new Error(err.message || 'Failed to initialize payment order');
        }
        const data = await response.json();

        const options = {
          key: data.keyId,
          amount: data.amount,
          currency: data.currency,
          name: 'Learn with me',
          description: 'One-Time Access Purchase',
          order_id: data.orderId,
          handler: async function (paymentResponse) {
            checkoutBtn.innerText = 'Verifying payment...';
            try {
              const verifyRes = await fetchWithTimeout('/api/payments/verify-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_payment_id: paymentResponse.razorpay_payment_id,
                  razorpay_order_id: paymentResponse.razorpay_order_id,
                  razorpay_signature: paymentResponse.razorpay_signature,
                  promoCode: appliedPromoCode
                })
              }, 12000);
              if (!verifyRes.ok) {
                const err = await verifyRes.json();
                throw new Error(err.message || 'Verification failed');
              }
              window.location.href = '/plans?success=true';
            } catch (err) {
              alert('Payment verification failed: ' + err.message);
              checkoutBtn.disabled = false;
              checkoutBtn.style.opacity = '';
              checkoutBtn.style.pointerEvents = '';
              checkoutProcessing = false;
              updateSummaryPrice();
            }
          },
          prefill: {
            name: '<%= user.name %>',
            email: '<%= user.email %>'
          },
          theme: { color: '#0284c7' },
          modal: {
            ondismiss: function() {
              checkoutBtn.disabled = false;
              checkoutBtn.style.opacity = '';
              checkoutBtn.style.pointerEvents = '';
              checkoutProcessing = false;
              updateSummaryPrice();
            }
          }
        };
        const rzp = new Razorpay(options);
        rzp.open();
      }
    } catch (err) {
      if(err && err.name==='AbortError') alert('Request timed out. Please try again.');
      else alert(err.message || 'An error occurred during payment launch.');
      checkoutBtn.disabled = false;
      checkoutBtn.style.opacity = '';
      checkoutBtn.style.pointerEvents = '';
      checkoutProcessing = false;
      updateSummaryPrice();
    }
  }
  async function resumeSubscription(productId) {
    const btn = document.getElementById('resume-btn-' + productId);
    if (btn) { btn.disabled = true; btn.innerText = 'Resuming...'; }
    try {
      const res = await fetchWithTimeout('/api/payments/resume', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId }) }, 10000);
      const data = await res.json();
      if (!res.ok || data.status !== 'success') throw new Error(data.message || 'Resume failed');
      window.location.reload();
    } catch (e) {
      alert(e.message);
      if (btn) { btn.disabled = false; btn.innerText = '↩ Resume Subscription'; }
    }
  }
  async function simulateCancellationForProduct(productId) {
    const btn = document.getElementById('simulate-cancel-btn-' + productId);
    if (btn) { btn.disabled = true; btn.innerText = 'Simulating...'; }
    try {
      const res = await fetch('/api/dev/simulate-provider-cancellation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId })
      });
      const data = await res.json();
      if (data.status === 'success') {
        alert('🧪 Provider subscription simulated as cancelled!\n\nSubscription ID: ' + data.subscriptionId + '\n\nYou can now test repurchasing this plan.');
        window.location.reload();
      } else {
        alert('Simulation notice: ' + (data.message || 'Failed to simulate cancellation.'));
        if (btn) { btn.disabled = false; btn.innerText = '🧪 Simulate Provider Cancellation (Local)'; }
      }
    } catch (e) {
      alert('Error: ' + e.message);
      if (btn) { btn.disabled = false; btn.innerText = '🧪 Simulate Provider Cancellation (Local)'; }
    }
  }
  // Handle 409 PENDING_CANCELLATION from checkout — offer to resume instead of duplicate
  const _origFetch = window.fetch;
  // Intercept subscribe 409 to auto-prompt resume (minimal)
  document.addEventListener('DOMContentLoaded', () => {
    // no-op: resume is explicit via button; subscribe now returns resumeRequired flag
  });
</script>
</body>
</html>
