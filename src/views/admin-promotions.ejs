<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Promotion Management Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container">
  <h1>⚙️ Promotion Codes & Discounts</h1>
  <p class="muted" style="margin-top:-10px;margin-bottom:20px;">Manage database-backed, product-scoped discount promotions, validation limits, and eligibility parameters.</p>
  
  <%- include('partials/admin-nav') %>

  <% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <div style="display:flex; justify-content:space-between; align-items:center; margin-top:24px; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
    <div style="display:flex; align-items:center; gap:12px;">
      <h2 style="margin:0;">Active Campaigns</h2>
      <select id="productFilter" onchange="filterPromotions()" style="padding:6px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:14px; background:#fff;">
        <option value="all">All Products</option>
        <% products.forEach(prod => { %>
          <option value="<%= prod.id %>"><%= prod.name %> (<%= prod.code %>)</option>
        <% }) %>
      </select>
    </div>
    <a href="/admin/promotions/create" class="button success" style="text-decoration:none;" data-testid="create-promo-btn">Create New Promotion</a>
  </div>

  <div style="background:#fff; border:1px solid #e1e6ee; border-radius:12px; padding:20px; overflow-x:auto;">
    <% if (promotions && promotions.length > 0) { %>
      <table class="admin-table" style="margin-bottom:0; width:100%;">
        <thead>
          <tr>
            <th>Promo Code</th>
            <th>Applicable Product</th>
            <th>Type & Discount</th>
            <th>User Eligibility</th>
            <th>Validity Period</th>
            <th>Usage Tracking</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% promotions.forEach(promo => { %>
            <tr class="promo-row" data-product-id="<%= promo.product_id %>" data-testid="promo-row-<%= promo.code %>">
              <td>
                <code style="font-size:14px; font-weight:bold; color:#0f172a; background:#f1f5f9; padding:2px 6px; border-radius:4px;"><%= promo.code %></code>
              </td>
              <td>
                <strong style="color:#334155;"><%= promo.product_name %></strong><br>
                <span class="muted" style="font-size:11px;">Code: <%= promo.product_code %></span>
              </td>
              <td>
                <span class="badge badge-neutral" style="text-transform:capitalize;"><%= promo.discount_type %></span><br>
                <strong style="font-size:14px;">
                  <%= promo.discount_type === 'percentage' ? promo.discount_value + '%' : '₹' + (promo.discount_value / 100).toFixed(2) %>
                </strong>
              </td>
              <td>
                <%= promo.eligibility_days ? 'First ' + promo.eligibility_days + ' registration days' : 'All users / No age restriction' %>
              </td>
              <td>
                <% if (promo.valid_from || promo.valid_until) { %>
                  <span style="font-size:12px; color:#475569;">
                    From: <%= promo.valid_from ? new Date(promo.valid_from).toLocaleDateString() : 'Immediate' %><br>
                    To: <%= promo.valid_until ? new Date(promo.valid_until).toLocaleDateString() : 'Infinite' %>
                  </span>
                <% } else { %>
                  <span class="muted" style="font-size:12px;">Continuous</span>
                <% } %>
              </td>
              <td>
                <strong><%= promo.redemption_count %></strong> / <%= promo.max_redemptions || '∞' %><br>
                <% if (promo.max_redemptions) { %>
                  <% const remaining = promo.max_redemptions - promo.redemption_count; %>
                  <span style="font-size:11px; color:<%= remaining <= 5 ? '#dc2626' : '#16a34a' %>;">
                    <%= remaining <= 0 ? 'Fully Exhausted' : remaining + ' remaining' %>
                  </span>
                <% } else { %>
                  <span class="muted" style="font-size:11px;">Unlimited capacity</span>
                <% } %>
              </td>
              <td>
                <% if (promo.is_enabled) { %>
                  <span class="badge badge-healthy" data-testid="promo-status-<%= promo.code %>">Active</span>
                <% } else { %>
                  <span class="badge badge-revoked" data-testid="promo-status-<%= promo.code %>">Disabled</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; gap:6px; align-items:center;">
                  <a href="/admin/promotions/<%= promo.id %>/edit" class="button small secondary" style="padding:4px 8px; font-size:12px; text-decoration:none;" data-testid="edit-promo-<%= promo.code %>">Edit</a>
                  
                  <form method="post" action="/admin/promotions/<%= promo.id %>/toggle" style="margin:0;">
                    <% if (promo.is_enabled) { %>
                      <input type="hidden" name="enabled" value="false">
                      <button type="submit" class="button small warning" style="padding:4px 8px; font-size:12px;" data-testid="toggle-promo-<%= promo.code %>">Disable</button>
                    <% } else { %>
                      <input type="hidden" name="enabled" value="true">
                      <button type="submit" class="button small success" style="padding:4px 8px; font-size:12px;" data-testid="toggle-promo-<%= promo.code %>">Enable</button>
                    <% } %>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted" style="margin:0; text-align:center; padding:20px 0;">No promotions configured in the database.</p>
    <% } %>
  </div>
</main>

<script>
function filterPromotions() {
  const selectedProdId = document.getElementById('productFilter').value;
  const rows = document.querySelectorAll('.promo-row');
  rows.forEach(row => {
    const prodId = row.getAttribute('data-product-id');
    if (selectedProdId === 'all' || prodId === selectedProdId) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}
</script>
</body>
</html>
