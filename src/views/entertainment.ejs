<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🍿 Entertainment · Learn with me</title>
<meta name="description" content="Free live TV channels for active members. Streams play directly from third-party providers.">
<link rel="stylesheet" href="/styles.css">
<%- include('partials/adsense-verification') %>
<style>
  .ftv-hero{margin:28px 0 22px;padding:24px;border:1px solid #dbeafe;border-radius:14px;background:linear-gradient(135deg,#eff6ff,#f8fafc)}
  .ftv-hero h1{margin:0 0 8px}
  .ftv-hero p{margin:0;color:#475569;max-width:900px;line-height:1.6}
  .ftv-player-wrap{margin:20px 0;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;background:#000}
  .ftv-player-wrap video{width:100%;max-height:60vh;display:block;background:#000}
  .ftv-now{padding:10px 14px;background:#fff;color:#0f172a;font-size:14px;font-weight:600}
  .ftv-controls{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}
  .ftv-controls label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:600;color:#475569}
  .ftv-controls select,.ftv-controls input{padding:9px 10px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;font-size:14px;min-width:220px}
  .ftv-status{font-size:13px;color:#64748b;margin:8px 0}
  .ftv-error{color:#b91c1c;font-size:13px;margin:8px 0}
  .ftv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin:16px 0}
  .ftv-card{display:flex;align-items:center;gap:10px;border:1px solid #e2e8f0;border-radius:10px;padding:10px;background:#fff;cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%}
  .ftv-card:hover{border-color:#93c5fd;background:#f8fafc}
  .ftv-card[aria-pressed="true"]{border-color:#2563eb;background:#eff6ff}
  .ftv-card img{width:44px;height:44px;object-fit:contain;border-radius:6px;background:#f1f5f9;flex:none}
  .ftv-card .ftv-name{font-size:13px;font-weight:700;color:#0f172a;line-height:1.3}
  .ftv-card .ftv-sub{font-size:11px;color:#64748b;margin-top:2px}
  .ftv-badge{display:inline-block;font-size:10px;font-weight:700;border:1px solid #cbd5e1;border-radius:6px;padding:1px 6px;margin-left:4px;color:#475569}
  .ftv-source{font-size:13px;color:#64748b;margin:18px 0}
</style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <a class="nav-link" href="/account">Account</a>
  <form method="post" action="/logout"><button type="submit">Sign out</button></form>
</header>

<main class="container">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>🍿 Entertainment</span></div>

  <section class="ftv-hero">
    <h1>🍿 Entertainment</h1>
    <p>Free live TV channels from around the world for active members. Channel lists refresh automatically on the server; streams play directly from third-party providers in your browser.</p>
  </section>

  <section class="ftv-player-wrap" aria-label="Live player">
    <video id="ftvPlayer" controls preload="none" playsinline aria-label="Live channel player"></video>
    <div class="ftv-now" id="ftvNowPlaying">Select a channel below to start watching.</div>
  </section>

  <div class="ftv-controls">
    <label>Country
      <select id="ftvCountry" aria-label="Filter by country">
        <option value="">All countries</option>
      </select>
    </label>
    <label>Search channels
      <input id="ftvSearch" type="search" maxlength="80" placeholder="Search by name…" aria-label="Search channels" autocomplete="off">
    </label>
  </div>

  <div class="ftv-status" id="ftvStatus" role="status" aria-live="polite">Loading channels…</div>
  <div class="ftv-error" id="ftvError" hidden></div>

  <div class="ftv-grid" id="ftvGrid"></div>

  <p class="ftv-source">Source: <a href="https://github.com/Free-TV/IPTV" target="_blank" rel="noopener noreferrer">Free-TV/IPTV</a> (free channels only). Streams are provided by third parties; availability and quality vary by region and network.</p>
</main>
<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<script>
(function () {
  var gridEl = document.getElementById('ftvGrid');
  var countryEl = document.getElementById('ftvCountry');
  var searchEl = document.getElementById('ftvSearch');
  var statusEl = document.getElementById('ftvStatus');
  var errorEl = document.getElementById('ftvError');
  var video = document.getElementById('ftvPlayer');
  var nowEl = document.getElementById('ftvNowPlaying');
  var HLS_MIME = 'application/vnd.apple.mpegurl';
  var state = { channels: [], selectedId: null };
  var hlsInstance = null;

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = !msg;
  }

  function setStatus(msg) {
    statusEl.textContent = msg;
  }

  // Upstream metadata is untrusted: validate before touching the player or DOM.
  function isUsableChannel(ch) {
    return ch && typeof ch.url === 'string' &&
      /^https:\/\//i.test(ch.url) && /\.m3u8(?:[?#]|$)/i.test(ch.url);
  }

  function stopPlayback() {
    try {
      if (hlsInstance) { hlsInstance.destroy(); }
    } catch (e) {}
    hlsInstance = null;
    try {
      video.pause();
      video.removeAttribute('src');
      video.load();
    } catch (e) {}
  }

  function playChannel(ch) {
    showError('');
    if (!isUsableChannel(ch)) {
      showError('This channel is unavailable right now. Please try another.');
      return;
    }
    stopPlayback();
    nowEl.textContent = 'Now playing: ' + ch.name;
    Array.prototype.forEach.call(gridEl.querySelectorAll('.ftv-card'), function (btn) {
      btn.setAttribute('aria-pressed', btn.getAttribute('data-id') === ch.id ? 'true' : 'false');
    });
    state.selectedId = ch.id;
    if (video.canPlayType(HLS_MIME)) {
      // Native HLS (e.g. Safari): no library needed.
      video.src = ch.url;
      var p = video.play();
      if (p && typeof p.catch === 'function') { p.catch(function () {}); }
    } else if (window.Hls && window.Hls.isSupported()) {
      var hls = new window.Hls({ maxBufferLength: 30 });
      hlsInstance = hls;
      hls.on(window.Hls.Events.ERROR, function (_ev, data) {
        if (data && data.fatal) {
          stopPlayback();
          showError('This stream is unavailable right now. Please try another channel.');
        }
      });
      hls.loadSource(ch.url);
      hls.attachMedia(video);
      hls.on(window.Hls.Events.MANIFEST_PARSED, function () {
        var started = video.play();
        if (started && typeof started.catch === 'function') { started.catch(function () {}); }
      });
    } else {
      showError('Live playback is not supported in this browser. Try Safari, Chrome, Edge, or Firefox.');
    }
  }

  function filteredChannels() {
    var country = (countryEl.value || '').toLowerCase();
    var q = (searchEl.value || '').trim().toLowerCase();
    return state.channels.filter(function (ch) {
      if (country && String(ch.group || '').toLowerCase() !== country) return false;
      if (q && String(ch.name || '').toLowerCase().indexOf(q) === -1) return false;
      return true;
    });
  }

  function render() {
    var list = filteredChannels();
    gridEl.innerHTML = '';
    if (!list.length) {
      setStatus(state.channels.length ? 'No channels match your filters.' : 'No channels available right now.');
      return;
    }
    setStatus('Showing ' + list.length + ' of ' + state.channels.length + ' channels.');
    list.slice(0, 500).forEach(function (ch) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ftv-card';
      btn.setAttribute('data-id', ch.id);
      btn.setAttribute('aria-pressed', state.selectedId === ch.id ? 'true' : 'false');
      if (ch.logo && /^https:\/\//i.test(ch.logo)) {
        var img = document.createElement('img');
        img.src = ch.logo;
        img.alt = '';
        img.loading = 'lazy';
        img.referrerPolicy = 'no-referrer';
        img.onerror = function () { img.remove(); };
        btn.appendChild(img);
      }
      var wrap = document.createElement('span');
      var name = document.createElement('span');
      name.className = 'ftv-name';
      name.textContent = ch.name;
      wrap.appendChild(name);
      var sub = document.createElement('span');
      sub.className = 'ftv-sub';
      sub.textContent = ch.group;
      if (ch.sd) {
        var sd = document.createElement('span');
        sd.className = 'ftv-badge';
        sd.textContent = 'SD';
        sub.appendChild(sd);
      }
      if (ch.geoBlocked) {
        var geo = document.createElement('span');
        geo.className = 'ftv-badge';
        geo.textContent = 'Geo-blocked';
        sub.appendChild(geo);
      }
      wrap.appendChild(sub);
      btn.appendChild(wrap);
      btn.addEventListener('click', function () { playChannel(ch); });
      gridEl.appendChild(btn);
    });
    if (list.length > 500) {
      setStatus('Showing 500 of ' + list.length + ' matches — refine your search.');
    }
  }

  function fillCountries(groups) {
    countryEl.innerHTML = '';
    var all = document.createElement('option');
    all.value = '';
    all.textContent = 'All countries';
    countryEl.appendChild(all);
    (groups || []).forEach(function (g) {
      var opt = document.createElement('option');
      opt.value = g;
      opt.textContent = g;
      countryEl.appendChild(opt);
    });
  }

  countryEl.addEventListener('change', render);
  searchEl.addEventListener('input', render);

  // Channel metadata comes only from our backend API — never from upstream directly.
  fetch('/api/entertainment/channels', { headers: { Accept: 'application/json' } })
    .then(function (res) {
      if (res.status === 401 || res.status === 403) throw new Error('Entertainment is available only to users with active access.');
      if (res.status === 404) throw new Error('Entertainment is currently unavailable.');
      if (!res.ok) throw new Error('Entertainment service unavailable (HTTP ' + res.status + ').');
      return res.json();
    })
    .then(function (data) {
      if (!data || !data.ok || !Array.isArray(data.channels)) throw new Error('Entertainment service unavailable.');
      state.channels = data.channels.filter(isUsableChannel);
      fillCountries(data.groups);
      render();
      if (data.stale) setStatus(statusEl.textContent + ' (served from cache while upstream recovers.)');
    })
    .catch(function (err) {
      setStatus('Could not load channels.');
      showError(err && err.message ? err.message : 'Entertainment service unavailable.');
    });
})();
</script>
</body>
</html>
