<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Flatten PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Flatten PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Bake fillable form fields into page content and download a <strong>new</strong> flattened copy. Filled values stay visible but can no longer be edited. Markup annotations (highlights, notes) are preserved as-is — only form fields are flattened. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfFlattenAvailable !== 'undefined' ? !!pdfFlattenAvailable : false; %>
<% const _maxMb = (typeof pdfFlattenMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfFlattenMaxFileMb)) && Number(pdfFlattenMaxFileMb) >= 1) ? Math.floor(Number(pdfFlattenMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-flatten-disabled">PDF flatten is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-flatten-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfFlattenPick" data-testid="pdf-flatten-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfFlattenFile" data-testid="pdf-flatten-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <button type="button" class="button small primary" id="pdfFlattenBtn" data-testid="pdf-flatten-submit" <%= _available ? '' : 'disabled' %>>🗜 Flatten &amp; download</button>
    <button type="button" class="button small secondary" id="pdfFlattenClear" data-testid="pdf-flatten-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfFlattenFileInfo" data-testid="pdf-flatten-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <div id="pdfFlattenProgress" data-testid="pdf-flatten-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Flattening… <span id="pdfFlattenProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-flatten-status" id="pdfFlattenStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-flatten-result" id="pdfFlattenResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-flatten.js?v=<%= Date.now() %>"></script>
</body></html>
