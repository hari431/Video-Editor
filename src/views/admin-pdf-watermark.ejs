<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Watermark PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Watermark PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Stamp a text watermark onto a local PDF and download a <strong>new</strong> file. The watermark is drawn over the pages; underlying content is otherwise untouched. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfWatermarkAvailable !== 'undefined' ? !!pdfWatermarkAvailable : false; %>
<% const _maxMb = (typeof pdfWatermarkMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfWatermarkMaxFileMb)) && Number(pdfWatermarkMaxFileMb) >= 1) ? Math.floor(Number(pdfWatermarkMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-watermark-disabled">Watermarks are disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-watermark-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfWatermarkPick" data-testid="pdf-watermark-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfWatermarkFile" data-testid="pdf-watermark-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <label style="font-size:13px;">Text <input type="text" id="pdfWatermarkText" data-testid="pdf-watermark-text" value="DRAFT" maxlength="200" style="width:140px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Position
      <select id="pdfWatermarkPosition" data-testid="pdf-watermark-position" <%= _available ? '' : 'disabled' %>>
        <option value="center" selected>Center</option>
        <option value="top-left">Top left</option>
        <option value="top-right">Top right</option>
        <option value="bottom-left">Bottom left</option>
        <option value="bottom-right">Bottom right</option>
      </select>
    </label>
    <label style="font-size:13px;">Size (pt) <input type="number" id="pdfWatermarkSize" data-testid="pdf-watermark-size" value="64" min="12" max="200" step="1" style="width:64px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Color <input type="color" id="pdfWatermarkColor" data-testid="pdf-watermark-color" value="#888888" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Opacity <input type="number" id="pdfWatermarkOpacity" data-testid="pdf-watermark-opacity" value="0.25" min="0" max="1" step="0.05" style="width:64px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Angle <input type="number" id="pdfWatermarkAngle" data-testid="pdf-watermark-angle" value="-45" min="-90" max="90" step="1" style="width:64px;" <%= _available ? '' : 'disabled' %>></label>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfWatermarkFileInfo" data-testid="pdf-watermark-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Pages to watermark</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfWatermarkScope" value="all" data-testid="pdf-watermark-scope-all" checked <%= _available ? '' : 'disabled' %>>
      All pages
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfWatermarkScope" value="range" data-testid="pdf-watermark-scope-range" <%= _available ? '' : 'disabled' %>>
      Selected pages
      <input type="text" id="pdfWatermarkSelection" data-testid="pdf-watermark-selection" placeholder="e.g. 1-3,5" autocomplete="off" spellcheck="false" style="width:200px;margin-left:8px;" <%= _available ? '' : 'disabled' %>>
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfWatermarkBtn" data-testid="pdf-watermark-submit" <%= _available ? '' : 'disabled' %>>💧 Add watermark &amp; download</button>
    <button type="button" class="button small secondary" id="pdfWatermarkClear" data-testid="pdf-watermark-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfWatermarkProgress" data-testid="pdf-watermark-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Watermarking… <span id="pdfWatermarkProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-watermark-status" id="pdfWatermarkStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-watermark-result" id="pdfWatermarkResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-watermark.js?v=<%= Date.now() %>"></script>
</body></html>
