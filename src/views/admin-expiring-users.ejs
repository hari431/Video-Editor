<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Expiring Users · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container">
<h1>Expiring Users</h1>
<%- include('partials/admin-nav') %>
<% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
<p class="muted">Users whose access expires within the next 7 days (based on server time). Only active, non-admin users are shown. <span class="badge badge-warning">Expiring soon</span> indicates warning; <span class="badge badge-critical">1 day</span> indicates critical.</p>
<% if (!users || users.length === 0) { %>
<p>No users are expiring within the next 7 days.</p>
<% } else { %>
<div class="admin-bulk-warning">
  <div>Selected users: <strong id="selected-count">0</strong> <span class="badge badge-warning" style="margin-left:6px">Expiring soon</span></div>
  <label for="bulk-expiry" style="margin-left:12px">Extend selected users until:</label>
  <input type="date" id="bulk-expiry" name="bulkExpiry">
  <form id="bulk-form" method="post" action="/admin/expiring-users/bulk-extend" style="display:inline">
    <input type="hidden" name="expiry" id="bulk-expiry-hidden">
    <button type="submit" id="bulk-extend-btn" class="button warning">Extend Access</button>
  </form>
</div>
<table class="admin-table">
  <thead><tr><th><input type="checkbox" id="select-all"> Select All</th><th>User</th><th>Email</th><th>Current Status</th><th>Current Expiry Date</th><th>Days Remaining</th><th>Individual New Expiry Date</th><th>Action</th></tr></thead>
  <tbody>
  <% function fmtIST(date) { if (!date) return '—'; return new Date(date).toLocaleDateString(undefined, { timeZone: 'Asia/Kolkata' }); } %>
  <% users.forEach(u => { %>
    <tr>
      <td><input type="checkbox" class="expiring-checkbox" value="<%= u.id %>" data-email="<%= u.email %>"></td>
      <td><%= u.name || '—' %></td>
      <td><%= u.email %></td>
      <td><span class="badge badge-active">Active</span></td>
      <td><span class="badge badge-warning"><%= fmtIST(u.access_expires_at) %></span></td>
      <td><span class="badge badge-warning"><%= u.daysRemaining %> day<%= u.daysRemaining === 1 ? '' : 's' %></span></td>
      <td>
        <form method="post" action="/admin/expiring-users/<%= u.id %>/extend" class="individual-form" style="display:flex;gap:6px;align-items:center">
          <input type="date" name="expiry" required>
          <button type="submit" class="button small warning">Update</button>
        </form>
      </td>
      <td><span class="muted">—</span></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
</main>
<%- include('partials/footer') %>
<script>
(function(){
  const selectAll = document.getElementById('select-all');
  const boxes = document.querySelectorAll('.expiring-checkbox');
  const countEl = document.getElementById('selected-count');
  const bulkForm = document.getElementById('bulk-form');
  const bulkExpiry = document.getElementById('bulk-expiry');
  const bulkExpiryHidden = document.getElementById('bulk-expiry-hidden');
  function updateCount(){
    const n = document.querySelectorAll('.expiring-checkbox:checked').length;
    if(countEl) countEl.textContent = String(n);
    if(selectAll){
      if(n===boxes.length && n>0) { selectAll.checked = true; selectAll.indeterminate = false; }
      else if(n===0) { selectAll.checked = false; selectAll.indeterminate = false; }
      else { selectAll.checked = false; selectAll.indeterminate = true; }
    }
  }
  if(selectAll){
    selectAll.addEventListener('change', function(){
      const checked = this.checked;
      boxes.forEach(b=>{ b.checked = checked; });
      updateCount();
    });
  }
  boxes.forEach(b=>{ b.addEventListener('change', updateCount); });
  updateCount();
  if(bulkForm){
    bulkForm.addEventListener('submit', function(e){
      const selected = Array.from(document.querySelectorAll('.expiring-checkbox:checked')).map(cb=>cb.value);
      if(selected.length===0){
        e.preventDefault();
        alert('Please select at least one user.');
        return;
      }
      const dateVal = bulkExpiry ? bulkExpiry.value : '';
      if(!dateVal){
        e.preventDefault();
        alert('Please select an expiry date.');
        return;
      }
      const chosen = new Date(dateVal + 'T23:59:59.999Z');
      if(isNaN(chosen.getTime()) || chosen.getTime() <= Date.now()){
        e.preventDefault();
        alert('Expiry date must be in the future.');
        return;
      }
      const displayLabel = (()=>{ try{ return new Date(dateVal+'T23:59:59.999Z').toLocaleDateString(undefined,{timeZone:'Asia/Kolkata'});}catch{return dateVal;}})();
      if(!confirm('You are about to extend access for ' + selected.length + ' users until ' + displayLabel + '.')){
        e.preventDefault();
        return;
      }
      if(bulkExpiryHidden) bulkExpiryHidden.value = dateVal;
      bulkForm.querySelectorAll('input[name="userIds"]').forEach(el=>el.remove());
      selected.forEach(id=>{
        const inp = document.createElement('input');
        inp.type='hidden';
        inp.name='userIds';
        inp.value=id;
        bulkForm.appendChild(inp);
      });
    });
  }
  try{
    const tomorrow = new Date(Date.now()+86400000);
    const iso = tomorrow.toISOString().slice(0,10);
    document.querySelectorAll('input[type="date"]').forEach(inp=>{ inp.min = iso; });
  }catch{}
})();
</script>
</body></html>
