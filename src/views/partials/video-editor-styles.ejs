  #veTrimBar.ve-selected { outline: 2px solid #1d4ed8; }
  .ve-trim-handle { position: absolute; top: 0; bottom: 0; width: 12px; cursor: ew-resize; touch-action: none; background: #2563eb; }
  .ve-trim-handle-l { left: 0; border-radius: 6px 0 0 6px; }
  .ve-trim-handle-r { right: 0; border-radius: 0 6px 6px 0; }
  /* Preview box resize handles and overflow */
  .ve-pbox { position: absolute; box-sizing: border-box; border: 2px dashed rgba(255,255,255,.7); user-select: none; -webkit-user-select: none; overflow: visible !important; contain: none !important; }
  .ve-pbox.ve-active { pointer-events: auto; cursor: move; border: 2px solid #fff; touch-action: none; z-index: 30; }
  .ve-corner { position: absolute; width: 12px; height: 12px; background: #fff; border: 2px solid #1d4ed8; border-radius: 3px; touch-action: none; user-select: none; -webkit-user-select: none; z-index: 35; box-sizing: border-box; pointer-events: auto; }
  .ve-textedit { width: 100%; height: 100%; box-sizing: border-box; font: inherit; color: inherit; background: rgba(0,0,0,.65); border: none; outline: 2px solid #1d4ed8; border-radius: 4px; padding: 0 4px; user-select: text; -webkit-user-select: text; resize: none; }
  .ve-corner-nw { left: -6px; top: -6px; cursor: nwse-resize; }
  .ve-corner-ne { right: -6px; top: -6px; cursor: nesw-resize; }
  .ve-corner-sw { left: -6px; bottom: -6px; cursor: nesw-resize; }
  .ve-corner-se { right: -6px; bottom: -6px; cursor: nwse-resize; }
  .ve-corner-n { left: calc(50% - 6px); top: -6px; cursor: ns-resize; }
  .ve-corner-s { left: calc(50% - 6px); bottom: -6px; cursor: ns-resize; }
  .ve-corner-w { left: -6px; top: calc(50% - 6px); cursor: ew-resize; }
  .ve-corner-e { right: -6px; top: calc(50% - 6px); cursor: ew-resize; }
  .ve-pbox-edge { position: absolute; touch-action: none; z-index: 25; box-sizing: border-box; pointer-events: auto; }
  .ve-pbox-edge::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; border: 2px solid #1d4ed8; border-radius: 3px; box-sizing: border-box; pointer-events: none; }
  .ve-pbox-edge-n::after, .ve-pbox-edge-s::after { width: 12px; height: 8px; }
  .ve-pbox-edge-w::after, .ve-pbox-edge-e::after { width: 8px; height: 12px; }
  .ve-pbox-edge-n { left: 8px; right: 8px; top: -6px; bottom: auto; height: 12px; width: auto; cursor: ns-resize; }
  .ve-pbox-edge-s { left: 8px; right: 8px; bottom: -6px; top: auto; height: 12px; width: auto; cursor: ns-resize; }
  .ve-pbox-edge-w { top: 8px; bottom: 8px; left: -6px; right: auto; width: 12px; height: auto; cursor: ew-resize; }
  .ve-pbox-edge-e { top: 8px; bottom: 8px; right: -6px; left: auto; width: 12px; height: auto; cursor: ew-resize; }

  /* Hide native scrollbars on #veScroll so custom #veHScrollbarWrap handles horizontal navigation */
  #veScroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #veScroll::-webkit-scrollbar {
    display: none;
  }

  /* Dedicated high-visibility horizontal scrollbar */
  .ve-hscrollbar-wrap {
    display: flex !important;
    align-items: center;
    flex: 0 0 32px !important;
    width: 100%;
    height: 32px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    position: relative;
    z-index: 60;
    padding: 6px 12px;
    background: #0f172a;
    border: 1px solid #334155;
    border-top: none;
    border-radius: 0 0 8px 8px;
    user-select: none;
    -webkit-user-select: none;
    margin-top: 0;
    box-sizing: border-box;
    visibility: visible !important;
    opacity: 1 !important;
  }
  body:not(.ve-workspace-active) .ve-hscrollbar-wrap {
    background: #f1f5f9;
