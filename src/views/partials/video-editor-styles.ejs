  .ve-clip { position: absolute; top: 4px; height: 26px; border-radius: 6px; font-size: 10px; font-weight: 600; color: #fff; overflow: hidden; white-space: nowrap; cursor: grab; user-select: none; -webkit-user-select: none; touch-action: none; display: flex; align-items: center; padding: 0 10px; box-sizing: border-box; }
  .ve-clip-video { background: #2563eb; }
  .ve-clip-audio { background: #b45309; }
  .ve-clip.ve-selected { outline: 2px solid #1d4ed8; outline-offset: 0; }
