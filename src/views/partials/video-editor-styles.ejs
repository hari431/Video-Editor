    width: 100%;
    height: 14px;
    min-height: 14px;
    background: #1e293b;
    border: 1px solid #475569;
    border-radius: 7px;
    overflow: hidden;
    cursor: pointer;
    visibility: visible !important;
  }
  body:not(.ve-workspace-active) .ve-hscrollbar-track {
    background: #cbd5e1;
  }
  .ve-hscrollbar-thumb {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 20%;
    background: #3b82f6;
    border-radius: 7px;
    cursor: grab;
