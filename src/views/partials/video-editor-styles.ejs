  .ve-edge { position: absolute; top: 0; bottom: 0; width: 10px; cursor: ew-resize; touch-action: none; z-index: 10; }
  .ve-edge-l { left: 0; border-left: 3px solid rgba(255,255,255,.85); }
  .ve-edge-r { right: 0; border-right: 3px solid rgba(255,255,255,.85); }
