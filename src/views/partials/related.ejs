<% if (typeof relatedItems !== 'undefined' && relatedItems && relatedItems.length) { %>
<section class="related-content" data-testid="related-content">
  <h2>Related Content</h2>
  <p class="muted">More from the library you may want to explore next.</p>
  <div class="grid">
    <% for (const item of relatedItems) { %>
      <a class="card" href="<%= item.href %>">
        <div class="icon"><%= item.kind === 'folder' ? '📁' : item.kind === 'video' ? '🎬' : item.kind === 'pdf' ? '📕' : item.kind === 'document' ? '📝' : item.kind === 'spreadsheet' ? '📊' : item.kind === 'presentation' ? '📊' : item.kind === 'image' ? '🖼️' : item.kind === 'markdown' ? '📝' : item.kind === 'archive' ? '📦' : item.kind === 'text' ? '📄' : '📄' %></div>
        <div><strong><%= item.title %></strong><small><%= item.typeLabel %> · <%= item.category %></small></div>
      </a>
    <% } %>
  </div>
</section>
<% } %>
