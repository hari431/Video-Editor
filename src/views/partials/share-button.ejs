<% if (typeof sharePath !== 'undefined' && sharePath) { %>
<span class="share-control" data-testid="share-control" style="display:inline-flex;align-items:center;gap:8px;">
  <button type="button" class="button small" data-testid="share-button" data-path="<%= sharePath %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg><span data-testid="share-button-label">Share</span></button>
  <span data-testid="share-output" hidden>
    <input type="text" readonly data-testid="share-link" style="width:280px;max-width:60vw;border:1px solid #cbd5e1;border-radius:8px;padding:6px 10px;font-size:13px;">
    <button type="button" class="button small" data-testid="share-copy">Copy</button>
    <span data-testid="share-copied" hidden style="font-size:12px;font-weight:700;color:#15803d;">Copied</span>
  </span>
</span>
<script>
(function () {
  // Short Share Links: runtime-only UI state. POSTs the CURRENT item path to
  // /api/share (server re-checks access + existence), displays the returned
  // short URL. No persistence here; the short URL itself grants no access.
  function init(root) {
    var btn = root.querySelector('[data-testid="share-button"]');
    var output = root.querySelector('[data-testid="share-output"]');
    var link = root.querySelector('[data-testid="share-link"]');
    var copyBtn = root.querySelector('[data-testid="share-copy"]');
    var copied = root.querySelector('[data-testid="share-copied"]');
    if (!btn || !output || !link || !copyBtn) return;
    // Label span holds the text so status updates never disturb the icon.
    var label = root.querySelector('[data-testid="share-button-label"]') || btn;
    btn.addEventListener('click', function () {
      var original = label.textContent;
      label.textContent = 'Sharing…';
      btn.disabled = true;
      fetch('/api/share', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ itemPath: btn.getAttribute('data-path') })
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, body: d }; }); })
      .then(function (res) {
        label.textContent = original;
        btn.disabled = false;
        if (res.ok && res.body && res.body.ok && res.body.urlPath) {
          link.value = window.location.origin + res.body.urlPath;
          output.hidden = false;
          output.style.display = 'inline-flex';
          output.style.alignItems = 'center';
          output.style.gap = '8px';
          if (copied) copied.hidden = true;
        } else {
          label.textContent = 'Share failed';
          setTimeout(function () { label.textContent = original; }, 1400);
        }
      }).catch(function () {
        label.textContent = original;
        btn.disabled = false;
      });
    });
    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise(function (resolve, reject) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          if (document.execCommand('copy')) resolve();
          else reject(new Error('copy failed'));
        } catch (e) {
          reject(e);
        } finally {
          document.body.removeChild(ta);
        }
      });
    }
    copyBtn.addEventListener('click', function () {
      var original = copyBtn.textContent;
      copyText(link.value).then(function () {
        if (copied) copied.hidden = false;
        copyBtn.textContent = 'Copied';
      }).catch(function () {
        copyBtn.textContent = 'Copy failed';
      }).then(function () {
        setTimeout(function () {
          copyBtn.textContent = original;
          if (copied) copied.hidden = true;
        }, 1400);
      });
    });
  }
  document.querySelectorAll('[data-testid="share-control"]').forEach(init);
})();
</script>
<% } %>
