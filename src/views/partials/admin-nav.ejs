<style>
  /* Editors dropdown: native <details> toggle (click/touch/keyboard/Esc, no JS),
     styled in the existing admin-nav language (.nav-link / .active). */
  .admin-nav-bar .nav-dropdown { position: relative; display: inline-flex; align-items: center; }
  .admin-nav-bar .nav-dropdown > summary { list-style: none; cursor: pointer; }
  .admin-nav-bar .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .admin-nav-bar .nav-dropdown > summary::marker { content: ''; }
  .admin-nav-bar .nav-dropdown > summary::after { content: ' ▾'; font-size: 11px; color: #94a3b8; }
  .admin-nav-bar .nav-dropdown[open] > summary::after { content: ' ▴'; }
  .admin-nav-bar .nav-menu {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 230px;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.18);
    padding: 6px 6px 8px; z-index: 200;
  }
  .admin-nav-bar .nav-group-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; color: #64748b; padding: 6px 10px 2px;
  }
  .admin-nav-bar .nav-menu .nav-link { display: block; padding: 6px 10px; border-radius: 6px; }
  .admin-nav-bar .nav-menu .nav-link:hover { background: #f1f5f9; text-decoration: none; }
  .admin-nav-bar .nav-menu .nav-link.active { background: #eef2ff; }
  /* Narrow screens: the bar wraps, so let the open menu flow in place instead
     of overlaying (avoids viewport overflow on mobile). */
  @media (max-width: 640px) {
    .admin-nav-bar .nav-dropdown { display: inline-flex; }
    .admin-nav-bar .nav-dropdown[open] { flex-basis: 100%; }
    .admin-nav-bar .nav-menu { position: static; width: 100%; box-shadow: none; margin-top: 6px; }
  }
</style>
