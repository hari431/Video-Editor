<% // Isolated AI Video Generation POC panel (LTX-Video). Rendered only when
   // aiVideoEnabled is true (AI_VIDEO_ENABLED=true, admin-only page).
   // No model paths, credentials or config reach the browser: the client only
   // sends a text prompt and polls job id/state, then previews the MP4. %>
<% const _aiEnabled = typeof aiVideoEnabled !== 'undefined' ? !!aiVideoEnabled : false; %>
<% if (_aiEnabled) { %>
<section id="aiVideoSection" data-testid="ai-video-panel" style="flex:1 1 100%;min-width:280px;">
  <details data-testid="ai-video-details" style="border:1px solid #e2e8f0;border-radius:12px;padding:10px;background:#fff;">
    <summary data-testid="ai-video-toggle" style="cursor:pointer;font-size:14px;font-weight:700;">🤖 AI Video Generation <span class="muted" style="font-weight:400;">(POC · LTX-Video worker)</span></summary>
    <p class="muted" data-testid="ai-video-note" style="font-size:12px;">Enter a text prompt and generate a short clip on the isolated GPU worker. Preview it here, then add it to the Video Editor timeline above. Generation never runs inside the main web process.</p>
    <label style="display:block;margin:8px 0;font-size:13px;">Text prompt
      <textarea id="aiPrompt" data-testid="ai-video-prompt" rows="3" spellcheck="false" maxlength="1000" placeholder="A river at dawn, slow aerial push-in…" style="margin-top:4px;width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px;font-size:13px;"></textarea>
    </label>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:center;">
      <button type="button" class="button primary" id="aiGenerateBtn" data-testid="ai-video-generate">Generate</button>
      <button type="button" class="button small secondary" id="aiAddTimelineBtn" data-testid="ai-video-add-timeline" disabled>Add to Timeline</button>
      <span class="muted" data-testid="ai-video-status" id="aiStatus" style="font-size:12px;font-weight:600;"></span>
    </div>
    <div id="aiPreviewWrap" data-testid="ai-video-preview-wrap" style="display:none;margin-top:10px;">
      <video id="aiPreview" data-testid="ai-video-preview" controls preload="metadata" playsinline style="width:100%;max-width:640px;display:block;background:#000;border-radius:8px;"></video>
    </div>
  </details>
</section>
<% } %>
