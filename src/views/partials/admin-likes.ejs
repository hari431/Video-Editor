<% if (user && user.isAdmin) { %>
<div class="admin-likes-control">
  <button class="admin-likes-btn">Who liked this?</button>
  <div class="admin-likes-panel" style="display: none;">
    <span class="admin-likes-loading">Loading...</span>
    <div class="admin-likes-list">
      <span class="admin-likes-no-likes">No likes yet.</span>
      <ul class="admin-likes-entries"></ul>
    </div>
  </div>
</div>
<% } %>
<% if (user && user.isAdmin) { %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var btn = document.querySelector('.admin-likes-btn');
  var panel = document.querySelector('.admin-likes-panel');
  var loading = document.querySelector('.admin-likes-loading');
  var list = document.querySelector('.admin-likes-list');
  var entries = document.querySelector('.admin-likes-entries');
  var noLikes = document.querySelector('.admin-likes-no-likes');
  if (!btn || !panel) return;
  btn.addEventListener('click', function () {
    if (panel.style.display === 'none') {
      panel.style.display = '';
      loading.style.display = '';
      list.style.display = 'none';
      var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var tid = ctrl ? setTimeout(function(){ try{ ctrl.abort(); }catch(e){} }, 6000) : null;
      fetch('/admin/likes/<%= itemPath.split("/").map(encodeURIComponent).join("/") %>', { signal: ctrl ? ctrl.signal : undefined })
        .then(function (r) { if(tid) clearTimeout(tid); if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
        .then(function (data) {
          loading.style.display = 'none';
          list.style.display = '';
          var likers = data.likers || [];
          if (likers.length === 0) {
            noLikes.style.display = '';
            entries.innerHTML = '';
          } else {
            noLikes.style.display = 'none';
            entries.innerHTML = likers.map(function (l) {
              return '<li><strong>' + (l.name || l.email) + '</strong> ' +
                (l.name ? '<span class="muted">(' + l.email + ')</span> ' : '') +
                '<span class="muted">' + new Date(l.created_at).toLocaleString() + '</span></li>';
            }).join('');
          }
        })
        .catch(function (err) {
          if(tid) clearTimeout(tid);
          loading.style.display = 'none';
          list.style.display = '';
          if(err && err.name==='AbortError'){ noLikes.textContent='Request timed out. Try again.'; }
          else noLikes.textContent = 'Failed to load.';
          noLikes.style.display = '';
        });
    } else {
      panel.style.display = 'none';
    }
  });
});
</script>
<% } %>