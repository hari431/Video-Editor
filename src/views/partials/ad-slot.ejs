<% // Reusable ad slot — server-controlled, Phase 8A prepared for AdSense
// Expects showAd boolean from server (isAdVisibleForUser is single authority). Do not compute eligibility in template.
// Google/AdSense code only rendered when showAd===true AND live config enabled (src/config/ads.js). Default: placeholder mode, no external network.
// Expects slotId (e.g., home-top, query-top). No hard-coded publisher/slot IDs — from env config.
if (typeof showAd !== 'undefined' && showAd) { 
  const _adLive = typeof adLive !== 'undefined' ? adLive : false;
  const _clientId = typeof adClientId !== 'undefined' ? adClientId : '';
  const _slot = typeof adSlotId !== 'undefined' ? adSlotId : '';
  if (_adLive && _clientId && _slot) { %>
<div class="ad-slot ad-slot--prepared" data-ad-slot="<%= typeof slotId !== 'undefined' ? slotId : 'content-top' %>" data-testid="ad-slot" data-adsense="prepared" data-ad-client="<%= _clientId %>" data-ad-slot-id="<%= _slot %>" aria-label="Advertisement slot prepared for AdSense" style="border:1px dashed #a5b4fc;background:#eef2ff;padding:12px;text-align:center;border-radius:8px;margin:16px 0;">
  <small class="muted">Ad slot prepared — AdSense configured</small>
  <div style="display:block" data-ad-client="<%= _clientId %>" data-ad-slot="<%= _slot %>"></div>
</div>
<% } else { %>
<!-- placeholder removed to match test requirements -->
<% } %>
<% } %>
