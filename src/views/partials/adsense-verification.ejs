<% // Phase 8B: Google AdSense site ownership verification — only for verification, not live ads
// Publisher ID sourced from ADSENSE_CLIENT_ID env via res.locals.adsenseClientId (src/config/ads.js)
// Render safely: only when ID is present, no hard-coded fallback
if (typeof adsenseClientId !== 'undefined' && adsenseClientId) { %>
<meta name="google-adsense-account" content="<%= adsenseClientId %>">
<% } %>
<script>window.__IS_PRIVILEGED__ = <%= (typeof isPrivileged !== 'undefined' && isPrivileged) ? 'true' : 'false' %>; window.__IS_AUTHENTICATED__ = <%= (typeof isAuthenticated !== 'undefined' && isAuthenticated) ? 'true' : 'false' %>;</script>
<script src="/devtools-restrict.js" defer></script>
