<% if (typeof accessExpiryReminder !== 'undefined' && accessExpiryReminder) { %>
<div class="access-expiry-banner access-expiry-<%= accessExpiryReminder.level %>" data-testid="access-expiry-reminder" role="status">
  <span class="access-expiry-text"><% if (accessExpiryReminder.level === 'urgent') { %>⚠️ Your Learn with Me access expires on <%= accessExpiryReminder.expiryIST %> (less than 1 day remaining). Please contact your administrator to retain access.<% } else { %>⚠️ Your Learn with Me access expires on <%= accessExpiryReminder.expiryIST %> (<%= accessExpiryReminder.daysRemaining %> day<%= accessExpiryReminder.daysRemaining === 1 ? '' : 's' %> remaining).<% } %></span>
  <button type="button" class="access-expiry-dismiss" aria-label="Dismiss access expiry reminder">✕</button>
</div>
<script>
(function () {
  try {
    var key = 'accessExpiryDismissed';
    var banner = document.querySelector('[data-testid="access-expiry-reminder"]');
    if (!banner) return;
    if (sessionStorage.getItem(key) === '1') { banner.remove(); return; }
    var btn = banner.querySelector('.access-expiry-dismiss');
    if (btn) btn.addEventListener('click', function () {
      try { sessionStorage.setItem(key, '1'); } catch (e) {}
      banner.remove();
    });
  } catch (e) {}
})();
</script>
<% } %>
