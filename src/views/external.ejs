  <% if (_vpx && _vpx.enabled && isYouTube && externalVideoToken) { %>
  <style>
    /* Recording-protection watermark above the YouTube iframe (z-index 4
       sits above the existing click-block overlays but is pointer-events
       none, so the Expand control stays clickable). Moved by JS. */
    #youtubeContainer .video-watermark.is-protected {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 4;
      pointer-events: none;
      user-select: none;
      display: flex;
      flex-direction: column;
      gap: 2px;
      color: rgba(255,255,255,0.9);
      font-size: 12px;
      line-height: 1.4;
      background: rgba(0,0,0,0.55);
      padding: 6px 10px;
      border-radius: 8px;
      transition: top 0.6s ease, left 0.6s ease, right 0.6s ease, bottom 0.6s ease;
    }
    #youtubeContainer .video-watermark.is-protected .wm-learn { font-weight: 600; }
    #youtubeContainer .video-watermark.is-protected .wm-viewer { font-size: 11px; color: rgba(255,255,255,0.85); }
    #youtubeContainer .video-watermark.is-protected .wm-email { font-size: 11px; color: rgba(255,255,255,0.8); }
    /* Branding overlay (separate from the moving viewer pill): large,
       low-opacity "Learn with me" brand mark over the YouTube player. */
    #youtubeContainer .wm-brand {
      position: absolute;
      pointer-events: none;
      user-select: none;
      z-index: 3;
      /* Color comes from the per-video branding config (inline style). */
      font-weight: 800;
      white-space: nowrap;
    }
    /* Option 2: Diagonal tiled watermark — many small brand marks spread
       evenly across the full video area at ~32°. The oversized inner layer
       keeps the rotated corners covered (edge tiles clip, as usual for
       tiled watermarks). Color/opacity come from the inline style. */
    #youtubeContainer .wm-brand-opt2 {
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      overflow: hidden;
      font-size: clamp(10px, 1.5vw, 16px);
      letter-spacing: 1px;
    }
    #youtubeContainer .wm-brand-opt2 .wm-tile-layer {
      position: absolute;
      inset: -45% -10%;
      display: flex;
      flex-wrap: wrap;
      align-content: space-evenly;
      justify-content: space-evenly;
      transform: rotate(-32deg);
    }
    /* Option 3: Centered Large (default). */
    #youtubeContainer .wm-brand-opt3 {
      top: 50%;
      left: 50%;
      font-size: clamp(32px, 7vw, 72px);
      letter-spacing: 3px;
      transform: translate(-50%, -50%);
    }
    #youtubeContainer .prot-warn {
      position: absolute;
      left: 50%;
      bottom: 78px;
      transform: translateX(-50%);
      z-index: 5;
      pointer-events: none;
      background: rgba(127,29,29,0.92);
      color: #fff;
      font-size: 12px;
      padding: 8px 14px;
      border-radius: 8px;
      max-width: 90%;
      text-align: center;
    }
  </style>
  <% } %>
</main>
