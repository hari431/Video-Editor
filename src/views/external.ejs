<script src="/video-protection.js"></script>
<script>
// Page-level right-click prevention (outside the video): inline and
// non-deferred so it applies immediately for the whole external page without
// waiting for /devtools-restrict.js. Server-gated on _vpx.enabled, so admins
// never render this and keep native right-click. The YouTube shield above
// covers right-clicks inside the cross-origin iframe.
(function () {
  try {
    document.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  } catch (err) {}
})();
</script>
