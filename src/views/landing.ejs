<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Video Editor</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('partials/app-nav') %>
<main class="container">
  <h1>Video Editor</h1>
  <p class="muted">A self-contained, local tool for editing video and recording your screen. Files are processed on this machine with FFmpeg; nothing is uploaded to a remote service.</p>
  <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:20px;">
    <a class="button primary" href="/editor" style="text-decoration:none;padding:16px 22px;font-weight:700;">🎬 Video Editor</a>
    <a class="button secondary" href="/recorder" style="text-decoration:none;padding:16px 22px;font-weight:700;">⏺ Screen Recorder</a>
  </div>
  <section class="muted" style="margin-top:28px;max-width:640px;line-height:1.5;">
    <p><strong>Video Editor</strong> — trim, crop, overlay text, images and video, add a watermark, mix audio tracks and export an MP4.</p>
    <p><strong>Screen Recorder</strong> — capture a screen, window or browser tab with optional microphone audio, then finalize it to MP4.</p>
  </section>
</main>
</body>
</html>
