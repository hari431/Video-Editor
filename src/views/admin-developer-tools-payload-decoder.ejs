<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Integration Payload Decoder · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>Integration Payload Decoder</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Decodes and reformats complex integration payloads, logs, or message-queue outputs. Paste raw inputs containing URL-encoding, HTML/XML entity escaping, Base64 encoding, Gzip compression, raw hex, XML, SOAP or JSON. <strong>This utility detects nested encoding layers and decompresses them recursively completely local to your browser.</strong>
    </p>

    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <h2 style="font-size:16px; margin-top:0; margin-bottom:12px;">Pasted Payload Input</h2>
      <div style="margin-bottom:16px;">
        <textarea id="rawPayloadInput" data-testid="raw-payload-input" placeholder="Paste your integration payload, JSON/XML log snippet, or encoded string here..." style="width:100%; height:180px; font-family:monospace; font-size:13px; padding:12px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical; background:#f8fafc;"></textarea>
      </div>

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="decodeBtn" data-testid="decode-btn">⚡ Decode Payload</button>
        <button type="button" class="button small secondary" id="clearBtn" data-testid="clear-btn">Clear</button>
        <button type="button" class="button small secondary" id="loadSampleSoapBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Load Sample SOAP (Gzip + Base64)</button>
        <button type="button" class="button small secondary" id="loadSampleJsonBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Load Sample JSON</button>
      </div>

      <!-- Error banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mb-6"></div>

      <!-- Decoder steps timeline -->
      <div id="stepsContainer"></div>

      <!-- Result presentation -->
      <div id="resultPanel" class="hidden mt-8 border-t border-slate-200 pt-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-4 gap-3">
          <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Final Decoded Result
          </h3>
          <button type="button" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg shadow-sm transition-all text-sm flex items-center gap-1.5" id="copyFinalBtn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
            Copy Decoded Result
          </button>
        </div>
        <pre class="bg-slate-950 text-slate-100 font-mono text-sm p-5 rounded-xl overflow-x-auto whitespace-pre-wrap leading-relaxed border border-slate-800 max-h-[500px] shadow-inner"><code id="finalResultCode"></code></pre>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-payload-decoder.js?v=<%= Date.now() %>"></script>
</body>
</html>
