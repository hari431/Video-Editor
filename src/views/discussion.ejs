<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= discussion.title %> · Discussions · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <a class="nav-link" href="/plans">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<%- include('partials/access-expiry') %>
<main class="container">
  <% const contentHref = contentRouteForPath(discussion.item_path) + discussion.item_path.split('/').map(encodeURIComponent).join('/'); %>
  <div class="breadcrumbs">
    <a href="/">Home</a>
    <span>/</span>
    <a href="<%= contentHref %>"><%= discussion.item_path.split('/').at(-1) %></a>
    <span>/</span>
    <a href="/discussions?path=<%= encodeURIComponent(discussion.item_path) %>">Discussions</a>
    <span>/</span>
    <span><%= discussion.title %></span>
  </div>

  <% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <article class="discussion-thread">
    <div class="discussion-question">
      <h1><%- (typeof linkifyBody === 'function' ? linkifyBody(discussion.title) : String(discussion.title||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></h1>
      <% const _acceptedCount = (typeof replies !== 'undefined' ? replies.filter(r => r.accepted_at).length : 0); %>
      <% if (_acceptedCount === 1) { %>
        <div style="margin:6px 0;padding:6px 10px;background:#e6f4ea;border:1px solid #b7e1c3;border-radius:6px;font-size:13px;color:#1a6e2e">✓ 1 Accepted Answer</div>
      <% } else if (_acceptedCount > 1) { %>
        <div style="margin:6px 0;padding:6px 10px;background:#e6f4ea;border:1px solid #b7e1c3;border-radius:6px;font-size:13px;color:#1a6e2e">✓ <%= _acceptedCount %> Accepted Answers</div>
      <% } %>
      <p class="discussion-meta">
        <% if (user.isAdmin) { %>
          <span class="discussion-author"><strong><%= discussion.author_name || 'Unknown' %></strong> (<%= discussion.author_email || 'unknown@' %>)</span>
        <% } else { %>
          <span class="discussion-author"><%= discussion.user_id === user.id ? 'You' : 'Anonymous' %></span>
        <% } %>
        <span class="discussion-date"><%= new Date(discussion.created_at).toLocaleString() %></span>
        <span class="discussion-on">on <a href="<%= contentHref %>"><%= displayName(discussion.item_path.split('/').at(-1)) %></a></span>
        <% if (discussion.status === 'pending') { %>
          <span class="badge" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;margin-left:6px;padding:2px 6px;border-radius:4px;font-size:11px;">Pending Approval</span>
        <% } else if (discussion.status === 'approved') { %>
          <span class="badge" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;margin-left:6px;padding:2px 6px;border-radius:4px;font-size:11px;">Approved</span>
        <% } else if (discussion.status === 'hidden') { %>
          <span class="badge badge-revoked" style="margin-left:6px">Hidden</span>
        <% } else if (discussion.status === 'deleted') { %>
          <span class="badge badge-revoked" style="margin-left:6px">Deleted</span>
        <% } %>
      </p>
      <div class="discussion-body"><%- (typeof linkifyBody === 'function' ? linkifyBody(discussion.body) : discussion.body.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></div>
      <% const _canDiscussQ = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
      <div class="discussion-actions" style="margin-top:8px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <!-- Question Like Button (hidden for read-only) -->
        <% if (_canDiscussQ) { %>
        <form method="post" action="/discussions/<%= discussion.id %>/like" style="display:inline">
          <button type="submit" class="button small <%= discussion.user_liked ? 'liked' : '' %>" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; font-size: 12px;">
            <%= discussion.user_liked ? '❤️' : '🤍' %> <%= discussion.like_count || 0 %>
          </button>
        </form>
        <% } %>

        <% if (_canDiscussQ && !user.isAdmin && discussion.user_id === user.id) { %>
          <form method="post" action="/discussions/<%= discussion.id %>/delete" class="discussion-delete-form" style="display:inline">
            <button type="submit" class="button small danger discussion-delete-btn" style="padding: 4px 8px; font-size: 12px;">Delete question</button>
          </form>
        <% } %>
        <% if (user.isAdmin) { %>
          <% if (discussion.status === 'pending') { %>
            <form method="post" action="/admin/discussions/<%= discussion.id %>/approve" style="display:inline">
              <input type="hidden" name="returnTo" value="thread">
              <button type="submit" class="button small success" style="font-weight: bold; padding: 4px 8px; font-size: 12px;">Approve</button>
            </form>
          <% } %>
          <% if (discussion.status === 'visible' || discussion.status === 'approved') { %>
            <form method="post" action="/admin/discussions/<%= discussion.id %>/hide" style="display:inline">
              <input type="hidden" name="returnTo" value="thread">
              <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Hide</button>
            </form>
          <% } else if (discussion.status === 'hidden') { %>
            <form method="post" action="/admin/discussions/<%= discussion.id %>/unhide" style="display:inline">
              <input type="hidden" name="returnTo" value="thread">
              <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Unhide</button>
            </form>
          <% } else if (discussion.status === 'deleted') { %>
            <form method="post" action="/admin/discussions/<%= discussion.id %>/restore" style="display:inline">
              <input type="hidden" name="returnTo" value="thread">
              <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Restore</button>
            </form>
          <% } %>
          <% if (discussion.status !== 'deleted') { %>
            <form method="post" action="/admin/discussions/<%= discussion.id %>/delete" style="display:inline" class="discussion-delete-form">
              <input type="hidden" name="returnTo" value="thread">
              <button type="submit" class="button small danger discussion-delete-btn" style="padding: 4px 8px; font-size: 12px;">Delete</button>
            </form>
          <% } %>
        <% } %>
      </div>
    </div>

    <%
    // Build tree of replies
    const replyMap = {};
    replies.forEach(r => {
      r.childReplies = [];
      replyMap[r.id] = r;
    });

    function getRootParentId(replyId, replyMap) {
      let current = replyMap[replyId];
      while (current && current.parent_id) {
        const parent = replyMap[current.parent_id];
        if (!parent) break;
        current = parent;
      }
      return current ? current.id : null;
    }

    const rootReplies = [];
    replies.forEach(r => {
      if (r.parent_id) {
        const rootId = getRootParentId(r.id, replyMap);
        if (rootId && rootId !== r.id) {
          replyMap[rootId].childReplies.push(r);
        } else {
          rootReplies.push(r);
        }
      } else {
        rootReplies.push(r);
      }
    });

    function renderReply(r, isNested) {
      const isAccepted = !!r.accepted_at;
    %>
      <div class="discussion-reply<%= r.status === 'hidden' ? ' discussion-hidden' : '' %><%= r.status === 'deleted' ? ' discussion-deleted' : '' %><%= isAccepted ? ' discussion-accepted' : '' %>" style="<%= isAccepted ? 'border:2px solid #2e7d32;background:#f1f8f1;' : '' %> margin-bottom: 12px; padding: 12px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff;">
        <p class="discussion-meta" style="margin: 0 0 6px 0; font-size: 13px; color: #475569;">
          <% if (user.isAdmin) { %>
            <span class="discussion-author"><strong><%= r.author_name || 'Unknown' %></strong> (<%= r.author_email || 'unknown@' %>)</span>
          <% } else { %>
            <span class="discussion-author"><%= r.user_id === user.id ? 'You' : 'Anonymous' %></span>
          <% } %>
          <span class="discussion-date" style="margin-left: 8px;"><%= new Date(r.created_at).toLocaleString() %></span>
          <% const replyAuthorRole = r.author_app_role || r.author_role; %>
          <% if (replyAuthorRole === 'ADMIN' || replyAuthorRole === 'OWNER') { %>
            <span class="badge badge-admin" data-testid="admin-reply-badge" style="margin-left:6px">Admin Reply</span>
          <% } %>
          <% if (isAccepted) { %>
            <span class="badge" style="background:#2e7d32;color:#fff;margin-left:6px;padding: 1px 6px;border-radius: 4px;">✓ Accepted Answer</span>
          <% } %>
          <% if (r.status === 'pending') { %>
            <span class="badge" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;margin-left:6px;padding:2px 6px;border-radius:4px;font-size:11px;">Pending Approval</span>
          <% } else if (r.status === 'approved') { %>
            <span class="badge" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;margin-left:6px;padding:2px 6px;border-radius:4px;font-size:11px;">Approved</span>
          <% } else if (r.status === 'hidden') { %>
            <span class="badge badge-revoked" style="margin-left:6px">Hidden</span>
          <% } else if (r.status === 'deleted') { %>
            <span class="badge badge-revoked" style="margin-left:6px">Deleted</span>
          <% } %>
        </p>
        <div class="discussion-body" style="font-size: 14px; line-height: 1.5; color: #1e293b;"><%- (typeof linkifyBody === 'function' ? linkifyBody(r.body) : r.body) %></div>
        <% const _canDiscussR = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
        <div class="discussion-actions" style="margin-top:8px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <!-- Reply Like Button (hidden for read-only) -->
          <% if (_canDiscussR) { %>
          <form method="post" action="/discussions/replies/<%= r.id %>/like" style="display:inline">
            <button type="submit" class="button small <%= r.user_liked ? 'liked' : '' %>" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; font-size: 12px;">
              <%= r.user_liked ? '❤️' : '🤍' %> <%= r.like_count || 0 %>
            </button>
          </form>
          <% } %>

          <!-- Reply toggle button (hidden for read-only) -->
          <% if (_canDiscussR && r.status !== 'deleted' && r.status !== 'hidden' && (r.status !== 'pending' || r.user_id === user.id || user.isAdmin)) { %>
            <button type="button" class="button small toggle-reply-btn" data-reply-to="<%= r.id %>" style="padding: 4px 8px; font-size: 12px;">Reply</button>
          <% } %>

          <% if (_canDiscussR && !user.isAdmin && r.user_id === user.id && r.status !== 'deleted') { %>
            <form method="post" action="/discussions/replies/<%= r.id %>/delete" class="discussion-delete-form" style="display:inline">
              <button type="submit" class="button small danger discussion-delete-btn" style="padding: 4px 8px; font-size: 12px;">Delete</button>
            </form>
          <% } %>
          <% if (user.isAdmin) { %>
            <% if (r.status === 'pending') { %>
              <form method="post" action="/admin/discussions/replies/<%= r.id %>/approve" style="display:inline">
                <input type="hidden" name="returnTo" value="thread">
                <button type="submit" class="button small success" style="font-weight: bold; padding: 4px 8px; font-size: 12px;">Approve</button>
              </form>
            <% } %>
            <% if (r.status === 'visible' || r.status === 'approved') { %>
              <form method="post" action="/admin/discussions/replies/<%= r.id %>/hide" style="display:inline">
                <input type="hidden" name="returnTo" value="thread">
                <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Hide</button>
              </form>
            <% } else if (r.status === 'hidden') { %>
              <form method="post" action="/admin/discussions/replies/<%= r.id %>/unhide" style="display:inline">
                <input type="hidden" name="returnTo" value="thread">
                <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Unhide</button>
              </form>
            <% } else if (r.status === 'deleted') { %>
              <form method="post" action="/admin/discussions/replies/<%= r.id %>/restore" style="display:inline">
                <input type="hidden" name="returnTo" value="thread">
                <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Restore</button>
              </form>
            <% } %>
            <% if (r.status !== 'deleted') { %>
              <form method="post" action="/admin/discussions/replies/<%= r.id %>/delete" style="display:inline" class="discussion-delete-form">
                <input type="hidden" name="returnTo" value="thread">
                <button type="submit" class="button small danger discussion-delete-btn" style="padding: 4px 8px; font-size: 12px;">Delete</button>
              </form>
            <% } %>
          <% } %>
          <% if ((r.status === 'visible' || r.status === 'approved') && user.isAdmin) { %>
            <% if (isAccepted) { %>
              <form method="post" action="/discussions/<%= discussion.id %>/unaccept/<%= r.id %>" style="display:inline">
                <button type="submit" class="button small" style="padding: 4px 8px; font-size: 12px;">Unaccept</button>
              </form>
            <% } else { %>
              <form method="post" action="/discussions/<%= discussion.id %>/accept/<%= r.id %>" style="display:inline">
                <button type="submit" class="button small" style="background:#2e7d32;color:#fff; padding: 4px 8px; font-size: 12px;">Accept Answer</button>
              </form>
            <% } %>
          <% } %>
        </div>

        <!-- Inline reply form (hidden for read-only) -->
        <% if (_canDiscussR) { %>
        <form id="reply-form-<%= r.id %>" class="reply-inline-form hidden" method="post" action="/discussions/<%= discussion.id %>/reply" style="margin-top: 12px; padding: 12px 0 0 0; border-top: 1px dashed #cbd5e1;">
          <input type="hidden" name="parent_id" value="<%= r.id %>">
          <textarea name="body" placeholder="Write a reply..." rows="2" required style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 13px; margin-bottom: 6px; box-sizing: border-box;"></textarea>
          <div style="display: flex; gap: 8px;">
            <button type="submit" class="button small primary" style="font-size: 12px; padding: 4px 8px;">Reply</button>
            <button type="button" class="button small cancel-reply-btn" data-reply-to="<%= r.id %>" style="font-size: 12px; padding: 4px 8px;">Cancel</button>
          </div>
        </form>
        <% } %>
      </div>
    <%
    }
    %>

    <h2><%= replies.length %> <%= replies.length === 1 ? 'Reply' : 'Replies' %></h2>

    <% if (replies.length === 0) { %>
      <p class="muted">No replies yet.</p>
    <% } else { %>
      <div class="discussion-replies">
        <% rootReplies.forEach(r => { %>
          <% renderReply(r, false) %>
          
          <% if (r.childReplies && r.childReplies.length > 0) { %>
            <div class="nested-replies-container" style="margin-left: 32px; padding-left: 12px; border-left: 2px solid #e2e8f0; margin-top: -6px; margin-bottom: 16px;">
              <% r.childReplies.forEach(child => { %>
                <% renderReply(child, true) %>
              <% }) %>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <% const _canReplyBottom = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
    <% if (_canReplyBottom) { %>
    <form method="post" action="/discussions/<%= discussion.id %>/reply" class="discussion-reply-form">
      <textarea name="body" placeholder="Write your reply..." rows="3" maxlength="50000" required class="discussion-input-body"></textarea>
      <button type="submit" class="button primary">Post Reply</button>
    </form>
    <% } else { %>
    <div class="flash flash-ok" data-testid="discussions-readonly-msg" style="margin-top: 16px; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">Discussions are available in read-only mode. Posting, replying and liking requires active access.</div>
    <% } %>
  </article>
</main>
<%- include('partials/footer') %>
<script src="/discussions.js" defer></script>
</body></html>
