<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Free Technical Books & Resources · Gosu Query Library</title>
  <meta name="description" content="Curated free technical books and learning resources for software engineers, with licence information and links to authoritative sources.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
  <style>
    .free-books-hero{margin:28px 0 22px;padding:24px;border:1px solid #dbeafe;border-radius:14px;background:linear-gradient(135deg,#eff6ff,#f8fafc)}
    .free-books-hero h1{margin:0 0 8px}
    .free-books-hero p{margin:0;color:#475569;max-width:900px;line-height:1.6}
    .book-filters{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin:20px 0}
    .book-filters label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:600;color:#475569}
    .book-filters select{min-width:190px;padding:9px 10px;border:1px solid #cbd5e1;border-radius:8px;background:#fff}
    .book-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px}
    .book-card{border:1px solid #e2e8f0;border-radius:12px;padding:18px;background:#fff;display:flex;flex-direction:column;gap:10px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
    .book-card h2{font-size:18px;margin:0}
    .book-meta{font-size:13px;color:#64748b}
    .book-description{color:#334155;line-height:1.55;flex:1}
    .book-badges{display:flex;gap:7px;flex-wrap:wrap}
    .book-badge{font-size:12px;font-weight:700;padding:4px 8px;border-radius:999px;background:#ecfdf5;color:#166534}
    .book-badge.link{background:#eff6ff;color:#1d4ed8}
    .book-license{font-size:12px;color:#64748b}
    .book-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
    .book-actions a{display:inline-block;padding:8px 11px;border-radius:8px;text-decoration:none;font-weight:700;font-size:13px;border:1px solid #cbd5e1}
    .book-actions a.primary{background:#2563eb;color:#fff;border-color:#2563eb}
    .book-note{margin:18px 0;padding:12px 14px;border-left:4px solid #2563eb;background:#f8fafc;color:#475569;font-size:13px;line-height:1.5}
    .book-empty{padding:30px;text-align:center;color:#64748b}
  </style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <a class="nav-link" href="/knowledge">📖 Knowledge Base</a>
  <% if (typeof user !== 'undefined' && user) { %>
    <a class="nav-link" href="/account">Account</a>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  <% } else { %>
    <a class="nav-link" href="/login">Sign in</a>
  <% } %>
</header>

<main class="container">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Free Technical Books</span></div>

  <section class="free-books-hero">
    <h1>📚 Free Technical Books & Resources</h1>
    <p>Curated technical books, open documentation, and learning resources that are genuinely free to access. We show the licence and link to the authoritative source so the rights for each resource stay transparent.</p>
  </section>

  <div class="book-note">
    <strong>Licensing first:</strong> A free resource is not automatically free to redistribute.
    <strong>Hosted</strong> entries are selected from openly licensed material; <strong>Link only</strong>
    entries remain on their original publisher/vendor website. Licence information is provided for
    reference and should be re-verified before any content is copied or adapted.
  </div>

  <form class="book-filters" method="get" action="/free-books">
    <label>Category
      <select name="category" onchange="this.form.submit()">
        <option value="">All categories</option>
        <% categories.forEach(category => { %>
          <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
    </label>
    <label>Availability
      <select name="kind" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="host" <%= selectedKind === 'host' ? 'selected' : '' %>>Hostable / open licence</option>
        <option value="link" <%= selectedKind === 'link' ? 'selected' : '' %>>Link to original</option>
      </select>
    </label>
  </form>

  <div class="book-grid">
    <% books.forEach(book => { %>
      <article class="book-card">
        <div class="book-badges">
          <span class="book-badge <%= book.kind === 'link' ? 'link' : '' %>"><%= book.kind === 'host' ? 'OPEN LICENCE' : 'LINK ONLY' %></span>
          <span class="book-badge" style="background:#f1f5f9;color:#475569;"><%= book.category %></span>
        </div>
        <h2><%= book.title %></h2>
        <div class="book-meta">By <%= book.author %></div>
        <div class="book-description"><%= book.description %></div>
        <div class="book-license"><strong>Licence:</strong> <%= book.licence %></div>
        <div class="book-actions">
          <% if (book.readUrl) { %><a class="primary" href="/free-books/read/<%= book.slug %>" target="_blank" rel="noopener noreferrer">Read book ↗</a><% } %>
          <a href="<%= book.sourceUrl %>" target="_blank" rel="noopener noreferrer">Source ↗</a>
          <a href="<%= book.licenceUrl %>" target="_blank" rel="noopener noreferrer">Licence ↗</a>
        </div>
      </article>
    <% }) %>
  </div>

  <% if (!books.length) { %>
    <div class="book-empty">No resources match the selected filters.</div>
  <% } %>

  <p style="margin:28px 0;color:#64748b;font-size:13px;">
    We do not host commercial PDFs, unofficial copies, scraped book collections, or resources with unclear redistribution rights.
  </p>
</main>
<%- include('partials/footer') %>
</body>
</html>
