<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Unlock Local Expense Tracker</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="topbar"><a class="brand" href="/admin">Admin Home</a></header><main class="container" style="max-width:520px;margin:48px auto;padding:20px">
<h1>Unlock Local Expense Tracker</h1><p>This tool is available only in local development, requires Admin authorization and a private passcode, and cannot run in production.</p>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
<form method="post" action="/admin/expense-tracker/unlock"><label for="passcode">Expense Tracker passcode</label><input id="passcode" name="passcode" type="password" autocomplete="current-password" minlength="8" required maxlength="256"><button type="submit" style="margin-top:12px">Unlock</button></form>
<p class="muted">Set <code>EXPENSE_TRACKER_PASSCODE</code> in your local environment. If it is unset, access stays disabled.</p></main></body></html>