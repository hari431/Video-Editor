<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Page Numbers · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Page Numbers</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Stamp page numbers onto a local PDF and download a <strong>new</strong> file. Numbers are drawn on top of the existing content, which is otherwise untouched. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfNumbersAvailable !== 'undefined' ? !!pdfNumbersAvailable : false; %>
<% const _maxMb = (typeof pdfNumbersMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfNumbersMaxFileMb)) && Number(pdfNumbersMaxFileMb) >= 1) ? Math.floor(Number(pdfNumbersMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-numbers-disabled">Page numbers are disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-numbers-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfNumbersPick" data-testid="pdf-numbers-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfNumbersFile" data-testid="pdf-numbers-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <label style="font-size:13px;">Position
      <select id="pdfNumbersPosition" data-testid="pdf-numbers-position" <%= _available ? '' : 'disabled' %>>
        <option value="bottom-center" selected>Bottom center</option>
        <option value="bottom-right">Bottom right</option>
        <option value="bottom-left">Bottom left</option>
        <option value="top-center">Top center</option>
        <option value="top-right">Top right</option>
        <option value="top-left">Top left</option>
      </select>
    </label>
    <label style="font-size:13px;">Start at <input type="number" id="pdfNumbersStart" data-testid="pdf-numbers-start" value="1" min="1" max="100000" step="1" style="width:80px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Size (pt) <input type="number" id="pdfNumbersSize" data-testid="pdf-numbers-size" value="11" min="6" max="48" step="1" style="width:64px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;">Prefix <input type="text" id="pdfNumbersPrefix" data-testid="pdf-numbers-prefix" value="" maxlength="20" placeholder="e.g. Page " style="width:100px;" <%= _available ? '' : 'disabled' %>></label>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfNumbersFileInfo" data-testid="pdf-numbers-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Pages to number</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfNumbersScope" value="all" data-testid="pdf-numbers-scope-all" checked <%= _available ? '' : 'disabled' %>>
      All pages
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfNumbersScope" value="range" data-testid="pdf-numbers-scope-range" <%= _available ? '' : 'disabled' %>>
      Selected pages
      <input type="text" id="pdfNumbersSelection" data-testid="pdf-numbers-selection" placeholder="e.g. 1-3,5" autocomplete="off" spellcheck="false" style="width:200px;margin-left:8px;" <%= _available ? '' : 'disabled' %>>
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfNumbersBtn" data-testid="pdf-numbers-submit" <%= _available ? '' : 'disabled' %>>🔢 Add numbers &amp; download</button>
    <button type="button" class="button small secondary" id="pdfNumbersClear" data-testid="pdf-numbers-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfNumbersProgress" data-testid="pdf-numbers-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Numbering… <span id="pdfNumbersProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-numbers-status" id="pdfNumbersStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-numbers-result" id="pdfNumbersResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-numbers.js?v=<%= Date.now() %>"></script>
</body></html>
