<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Merge PDFs · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Merge PDFs</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Select multiple local PDF files, arrange them in merge order, then download a <strong>new</strong> merged PDF. Source files are never modified. Runs locally (pdf.js preview + pdf-lib merge, no external services). This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfMergeAvailable !== 'undefined' ? !!pdfMergeAvailable : false; %>
<% const _maxMb = (typeof pdfMergeMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfMergeMaxFileMb)) && Number(pdfMergeMaxFileMb) >= 1) ? Math.floor(Number(pdfMergeMaxFileMb)) : 50; %>
<% const _maxFiles = (typeof pdfMergeMaxFiles !== 'undefined' && Number.isFinite(Number(pdfMergeMaxFiles)) && Number(pdfMergeMaxFiles) >= 2) ? Math.floor(Number(pdfMergeMaxFiles)) : 8; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-merge-disabled">PDF merge is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-merge-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>" data-max-files="<%= _maxFiles %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfMergePick" data-testid="pdf-merge-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDFs</button>
    <input type="file" id="pdfMergeFile" data-testid="pdf-merge-file" accept=".pdf,application/pdf" multiple style="display:none;" <%= _available ? '' : 'disabled' %>>
    <button type="button" class="button small primary" id="pdfMergeBtn" data-testid="pdf-merge-submit" <%= _available ? '' : 'disabled' %>>⤵ Merge &amp; download</button>
    <button type="button" class="button small secondary" id="pdfMergeClear" data-testid="pdf-merge-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
    <span class="muted" style="font-size:12px;">Max <%= _maxFiles %> files · <%= _maxMb %> MB each · min 2 files</span>
  </div>
  <ol id="pdfMergeList" data-testid="pdf-merge-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;"></ol>
  <p class="muted" id="pdfMergeHint" data-testid="pdf-merge-hint" style="font-size:12px;">No PDFs selected yet. Files appear here in merge order — drag to reorder or use ↑/↓.</p>
  <div id="pdfMergeProgress" data-testid="pdf-merge-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Merging… <span id="pdfMergeProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-merge-status" id="pdfMergeStatus" style="font-size:13px;font-weight:600;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-merge.js?v=<%= Date.now() %>"></script>
</body></html>
