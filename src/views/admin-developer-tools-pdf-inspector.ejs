<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>PDF AcroForm Field Inspector · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>PDF AcroForm Field Inspector</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Upload any fillable PDF form and inspect its AcroForm fields instantly. Read complete field metadata, field names, field types (text fields, checkboxes, radios, dropdowns, signatures), bounding box coordinates, line numbers, and flag conditions without modifying the original source document. <strong>Processing runs fully in-memory and local.</strong>
    </p>

    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <h2 style="font-size:16px; margin-top:0; margin-bottom:12px;">Select Fillable PDF</h2>
      <div style="margin-bottom:16px;">
        <input type="file" id="pdfFileInput" accept=".pdf" style="width:100%; max-width:400px; font-size:13px; padding:8px; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc;" />
      </div>

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="inspectBtn" data-testid="inspect-btn">⚡ Inspect Form Fields</button>
        <button type="button" class="button small secondary" id="clearBtn" data-testid="clear-btn">Clear</button>
        <button type="button" class="button small secondary" id="loadSampleBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Load Sample PDF</button>
      </div>

      <!-- Error banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mb-6"></div>

      <!-- Analysis Results Panel -->
      <div id="resultsPanel" class="hidden">
        <hr style="border:0; border-top:1px solid #e2e8f0; margin:24px 0;">

        <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
          <div>
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              AcroForm Details
            </h3>
            <div class="text-xs text-slate-500 mt-1">
              File: <span id="metaFilename" class="font-bold text-slate-800"></span> • 
              Total fields found: <span id="metaCount" class="font-bold text-slate-800">0</span>
            </div>
          </div>

          <!-- Dynamic search/filters -->
          <div class="flex items-center gap-3 flex-wrap md:flex-nowrap">
            <input type="text" id="fieldSearchInput" placeholder="Filter by name/value..." class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs w-full md:w-48 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <select id="fieldTypeFilter" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs bg-slate-50 focus:bg-white focus:outline-none">
              <option value="all">All Field Types</option>
              <option value="text">Text Field</option>
              <option value="checkbox">Checkbox</option>
              <option value="radio">Radio Button</option>
              <option value="dropdown">Dropdown</option>
              <option value="optionlist">Option List</option>
              <option value="signature">Signature Field</option>
            </select>
          </div>
        </div>

        <!-- Form fields layout output -->
        <div id="fieldsList" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Populated dynamically -->
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-pdf-inspector.js?v=<%= Date.now() %>"></script>
</body>
</html>
