<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>My Notes · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/" id="brandLink">Learn with me</a>
  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <a class="nav-link" href="/plans" id="plansLink">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes" id="likesLink">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<%- include('partials/access-expiry') %>
<main class="container" id="notesContainer">
  <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>My Notes</span></div>
  <section class="page-heading">
    <div>
      <h1 id="notesHeading">📝 My Notes</h1>
      <p id="notesSubheading">Your private notes on queries and learning resources.</p>
    </div>
  </section>
  <% if (items && items.length) { %>
  <div class="browse-controls" data-controls-for="notes">
    <div class="control-group">
      <label for="notesSortSelect">Sort by</label>
      <select id="notesSortSelect" class="control-select" data-testid="notes-sort-select">
        <option value="newest">Recently updated</option>
        <option value="oldest">Oldest first</option>
        <option value="nameAsc">Name A → Z</option>
        <option value="nameDesc">Name Z → A</option>
      </select>
    </div>
    <div class="control-group">
      <label for="notesViewSelect">View by</label>
      <select id="notesViewSelect" class="control-select" data-testid="notes-view-select">
        <option value="cards">Cards</option>
        <option value="list">List</option>
        <option value="details">Details</option>
      </select>
    </div>
  </div>
  <div class="grid" data-testid="notes-list" id="notesGrid">
    <% for (const item of items) { %>
      <% const dn = displayName(item.name.replace(/\.[^.]+$/i, '')); const updMs = item.updatedAt ? new Date(item.updatedAt).getTime() : (item.createdAt ? new Date(item.createdAt).getTime() : 0); const updIso = item.updatedAt ? new Date(item.updatedAt).toISOString() : (item.createdAt ? new Date(item.createdAt).toISOString() : ''); %>
      <div class="card note-card" id="note-card-<%= item.id %>" data-testid="note-item" data-path="<%= item.path %>" data-name="<%= dn.toLowerCase() %>" data-date="<%= updIso %>" data-date-ms="<%= updMs %>" data-type="<%= item.typeLabel %>">
        <div class="note-card-top">
          <div class="icon" style="font-size: 24px; line-height: 1; flex-shrink: 0;"><%= item.kind === 'video' ? '🎬' : item.kind === 'text' ? '📄' : item.kind === 'pdf' ? '📕' : item.kind === 'image' ? '🖼️' : '📎' %></div>
          <div class="note-card-info" style="flex: 1; min-width: 0;">
            <a href="<%= item.href %>" class="note-file-link" style="font-weight: 700; font-size: 16px; color: #0284c7; text-decoration: none; word-break: break-word; display: block;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
              <%= dn %>
            </a>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px; font-size: 12px; color: #64748b;">
              <span class="badge" style="background: #f1f5f9; color: #475569; padding: 2px 6px; border-radius: 4px; font-weight: 600; font-size: 11px;"><%= item.typeLabel %></span>
              <% if (item.updatedAt) { %>
                <span>· Updated <%= new Date(item.updatedAt).toLocaleDateString() %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="note-text-content" style="background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 8px; padding: 12px 14px; font-size: 13.5px; color: #334155; line-height: 1.6; white-space: pre-wrap; word-break: break-word; margin-top: 8px; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; max-height: calc(1.6em * 5 + 24px); overflow-wrap: break-word; text-overflow: ellipsis;">
          <%= item.noteText %>
        </div>
        <div class="note-card-footer">
          <a href="<%= item.href %>" style="font-size: 13px; font-weight: 600; color: #0284c7; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
            Open file &rarr;
          </a>
        </div>
      </div>
    <% } %>
  </div>
  <div class="details-wrap" id="notesDetailsWrap">
    <table class="details-table" data-testid="notes-details-table">
      <thead>
        <tr><th>Name</th><th>Type</th><th>Updated</th></tr>
      </thead>
      <tbody id="notesDetailsBody">
        <% for (const item of items) { %>
          <% const dn3 = displayName(item.name.replace(/\.[^.]+$/i, '')); const updMs3 = item.updatedAt ? new Date(item.updatedAt).getTime() : 0; const updIso3 = item.updatedAt ? new Date(item.updatedAt).toISOString() : ''; %>
          <tr data-name="<%= dn3.toLowerCase() %>" data-date="<%= updIso3 %>" data-date-ms="<%= updMs3 %>">
            <td><a href="<%= item.href %>"><%= dn3 %></a></td>
            <td><%= item.typeLabel %></td>
            <td><%= item.updatedAt ? new Date(item.updatedAt).toLocaleDateString() : '' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <p class="empty-folder" id="emptyNotesMessage">You haven't saved any notes yet. Open a query or file and add a note.</p>
  <% } %>
</main>
<%- include('partials/footer') %>
<script src="/browse-controls.js"></script>
<% if (items && items.length) { %>
<script>
BrowseControls.setup({
  containerId: 'notesContainer',
  gridId: 'notesGrid',
  detailsBodyId: 'notesDetailsBody',
  sortSelectId: 'notesSortSelect',
  viewSelectId: 'notesViewSelect',
  lsSortKey: 'myNotes_sort',
  lsViewKey: 'myNotes_view',
  defaultSort: 'newest',
  defaultView: 'cards',
  sortFns: {
    newest: function(a,b){ return (parseInt(b.getAttribute('data-date-ms'))||0) - (parseInt(a.getAttribute('data-date-ms'))||0); },
    oldest: function(a,b){ return (parseInt(a.getAttribute('data-date-ms'))||0) - (parseInt(b.getAttribute('data-date-ms'))||0); },
    nameAsc: function(a,b){ return (a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); },
    nameDesc: function(a,b){ return (b.getAttribute('data-name')||'').localeCompare(a.getAttribute('data-name')||''); }
  }
});
</script>
<% } %>
</body>
</html>
