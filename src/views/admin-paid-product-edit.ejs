<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Edit Paid Product · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container" style="max-width:600px;margin-top:24px;margin-bottom:48px;">
  <%- include('partials/admin-nav') %>

  <a href="/admin/paid-products" class="nav-link" style="display:inline-block;margin-bottom:16px;">&larr; Back to Paid Products</a>
  
  <h1>Edit Paid Product</h1>
  <p class="muted">Update product parameters. Changing the role mapping will affect future grants for this product.</p>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <div style="background:#fffaf0;border:1px solid #feebc8;color:#c05621;padding:16px;border-radius:12px;margin-top:16px;margin-bottom:16px;display:flex;flex-direction:column;gap:8px;">
    <h3 style="margin:0;font-size:16px;font-weight:700;">⚠️ Impactful Action Warnings</h3>
    <ul style="margin:0;padding-left:20px;font-size:14px;line-height:1.4;">
      <li><strong>RBAC Role Mapping Change</strong>: Changing the target role mapping will NOT retroactively update active user entitlements. If changed, new purchasers will receive the new role, but existing active purchasers will remain on their current role mapping until renewal or expiration. Furthermore, changing the role is <strong>strictly blocked</strong> if there are any active entitlements.</li>
      <li><strong>Disabling the Product</strong>: Disabling a product will prevent new subscription checkouts and orders. Disabling is <strong>strictly blocked</strong> if there are active user entitlements currently depending on it.</li>
    </ul>
  </div>

  <form method="post" action="/admin/paid-products/<%= product.id %>/edit" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:24px;margin-top:16px;">
    <% if (csrfToken) { %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% } %>

    <div style="margin-bottom:18px;">
      <label style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Product Code (Immutable)</label>
      <input type="text" value="<%= product.code %>" disabled style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;background:#edf2f7;color:#4a5568;font-family:monospace;">
    </div>

    <div style="margin-bottom:18px;">
      <label for="name" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Product Name</label>
      <input type="text" id="name" name="name" value="<%= (form && form.name) !== undefined ? form.name : product.name %>" required placeholder="e.g. Premium Plus Membership" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
    </div>

    <div style="margin-bottom:18px;">
      <label for="description" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Description</label>
      <textarea id="description" name="description" rows="3" placeholder="Describe what features this product grants..." style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;font-family:sans-serif;"><%= (form && form.description) !== undefined ? form.description : product.description %></textarea>
    </div>

    <div style="margin-bottom:18px;">
      <label for="role_id" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">RBAC Role Mapping</label>
      <select id="role_id" name="role_id" required style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;background:#fff;">
        <option value="">-- Select Target System Role --</option>
        <% roles.forEach(role => { %>
          <% const currentRoleId = (form && form.role_id) !== undefined ? Number(form.role_id) : Number(product.role_id); %>
          <option value="<%= role.id %>" <%= currentRoleId === Number(role.id) ? 'selected' : '' %>><%= role.name %> (<%= role.description || 'No description' %>)</option>
        <% }) %>
      </select>
      <p class="muted" style="margin-top:4px;font-size:12px;">When purchased, users are automatically granted this role.</p>
    </div>

    <div style="margin-bottom:18px;">
      <label for="max_active_members" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Maximum Active Members</label>
      <input type="number" id="max_active_members" name="max_active_members" value="<%= (form && form.max_active_members) !== undefined ? form.max_active_members : (product.max_active_members !== null ? product.max_active_members : '') %>" min="1" placeholder="Unlimited" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
      <p class="muted" style="margin-top:4px;font-size:12px;">Optional capacity restriction. Leave empty/unset for unlimited members.</p>
    </div>

    <div style="margin-bottom:24px;display:flex;align-items:center;gap:8px;">
      <% const isChecked = (form && form.is_enabled) !== undefined ? (form.is_enabled === 'true' || form.is_enabled === true) : product.is_enabled; %>
      <input type="checkbox" id="is_enabled" name="is_enabled" value="true" <%= isChecked ? 'checked' : '' %>>
      <label for="is_enabled" style="font-weight:600;color:#2d3748;margin:0;">Product is enabled</label>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end;">
      <a href="/admin/paid-products" class="button secondary" style="padding:10px 20px;text-decoration:none;">Cancel</a>
      <button type="submit" class="button success" style="padding:10px 20px;">Save Changes</button>
    </div>
  </form>
</main>
</body>
</html>
