<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Recent Activity · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container">
  <h1>Recent Activity</h1>
  <%- include('partials/admin-nav') %>

  <% if (typeof msg !== 'undefined' && msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <p class="muted">Compact chronological timeline of recent administrative, access, moderation, and user actions across the platform. Read-only audit trail derived directly from existing system logs.</p>

  <%
    function fmtIST(date) {
      if (!date) return '—';
      return new Date(date).toLocaleString('en-US', {
        timeZone: 'Asia/Kolkata',
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function fmtRelativeTime(date) {
      if (!date) return '';
      const diffMs = Date.now() - new Date(date).getTime();
      const diffMins = Math.floor(diffMs / 60000);
      if (diffMins < 1) return 'just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      const diffHours = Math.floor(diffMins / 60);
      if (diffHours < 24) return `${diffHours}h ago`;
      const diffDays = Math.floor(diffHours / 24);
      if (diffDays < 30) return `${diffDays}d ago`;
      return '';
    }

    function roleBadge(r) {
      if (!r || r === '—') return '';
      const m = { OWNER: 'badge-owner', ADMIN: 'badge-admin', USER: 'badge-neutral' };
      const cls = m[r] || 'badge-neutral';
      return '<span class="badge ' + cls + '">' + r + '</span>';
    }

    function statusBadge(s) {
      if (!s || s === '—') return '';
      const m = { pending: 'badge-pending', active: 'badge-active', revoked: 'badge-revoked', expired: 'badge-expired' };
      const l = { pending: 'Pending', active: 'Active', revoked: 'Revoked', expired: 'Expired' };
      const cls = m[s] || 'badge-neutral';
      const label = l[s] || s;
      return '<span class="badge ' + cls + '">' + label + '</span>';
    }
  %>

  <!-- Filter Bar -->
  <div class="timeline-filter-bar">
    <form class="timeline-filter-form" method="get" action="/admin/recent-activity">
      <div class="timeline-filter-group">
        <label for="filter-type">Activity Type</label>
        <select id="filter-type" name="type">
          <option value="all" <%= filters.type === 'all' ? 'selected' : '' %>>All Activities</option>
          <option value="access" <%= filters.type === 'access' ? 'selected' : '' %>>User Access & Expiry</option>
          <option value="role" <%= filters.type === 'role' ? 'selected' : '' %>>Role Changes</option>
          <option value="permission" <%= filters.type === 'permission' ? 'selected' : '' %>>Content Permissions</option>
          <option value="moderation" <%= filters.type === 'moderation' ? 'selected' : '' %>>Moderation Actions</option>
          <option value="registration" <%= filters.type === 'registration' ? 'selected' : '' %>>User Registrations</option>
          <option value="discussion" <%= filters.type === 'discussion' ? 'selected' : '' %>>Discussions & Answers</option>
        </select>
      </div>

      <div class="timeline-filter-group">
        <label for="filter-date-range">Date Range</label>
        <select id="filter-date-range" name="dateRange">
          <option value="all" <%= filters.dateRange === 'all' ? 'selected' : '' %>>All Time</option>
          <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>Past 24 Hours</option>
          <option value="7d" <%= filters.dateRange === '7d' ? 'selected' : '' %>>Past 7 Days</option>
          <option value="30d" <%= filters.dateRange === '30d' ? 'selected' : '' %>>Past 30 Days</option>
          <option value="custom" <%= filters.dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
        </select>
      </div>

      <div class="timeline-filter-group" id="custom-start-group" style="<%= filters.dateRange === 'custom' ? '' : 'display:none;' %>">
        <label for="filter-start-date">Start Date</label>
        <input type="date" id="filter-start-date" name="startDate" value="<%= filters.startDate %>">
      </div>

      <div class="timeline-filter-group" id="custom-end-group" style="<%= filters.dateRange === 'custom' ? '' : 'display:none;' %>">
        <label for="filter-end-date">End Date</label>
        <input type="date" id="filter-end-date" name="endDate" value="<%= filters.endDate %>">
      </div>

      <div class="timeline-filter-group" style="flex-grow:1;min-width:180px">
        <label for="filter-search">Search</label>
        <input type="text" id="filter-search" name="search" placeholder="Search user, actor, content..." value="<%= filters.search %>">
      </div>

      <div class="timeline-filter-actions">
        <button type="submit" class="button small">Filter</button>
        <a href="/admin/recent-activity" class="button small" style="background:#f1f5f9;border-color:#d8dee8;color:#475569">Reset</a>
      </div>
    </form>
  </div>

  <!-- Category Fast Filter Pills -->
  <div class="activity-stat-pills">
    <% const qParams = `dateRange=${encodeURIComponent(filters.dateRange)}&startDate=${encodeURIComponent(filters.startDate)}&endDate=${encodeURIComponent(filters.endDate)}&search=${encodeURIComponent(filters.search)}`; %>
    <a href="/admin/recent-activity?type=all&<%= qParams %>" class="activity-pill <%= filters.type === 'all' ? 'active' : '' %>">
      All <span class="pill-count"><%= categoryCounts.all %></span>
    </a>
    <a href="/admin/recent-activity?type=access&<%= qParams %>" class="activity-pill <%= filters.type === 'access' ? 'active' : '' %>">
      Access & Expiry <span class="pill-count"><%= categoryCounts.access %></span>
    </a>
    <a href="/admin/recent-activity?type=role&<%= qParams %>" class="activity-pill <%= filters.type === 'role' ? 'active' : '' %>">
      Roles <span class="pill-count"><%= categoryCounts.role %></span>
    </a>
    <a href="/admin/recent-activity?type=permission&<%= qParams %>" class="activity-pill <%= filters.type === 'permission' ? 'active' : '' %>">
      Permissions <span class="pill-count"><%= categoryCounts.permission %></span>
    </a>
    <a href="/admin/recent-activity?type=moderation&<%= qParams %>" class="activity-pill <%= filters.type === 'moderation' ? 'active' : '' %>">
      Moderation <span class="pill-count"><%= categoryCounts.moderation %></span>
    </a>
    <a href="/admin/recent-activity?type=registration&<%= qParams %>" class="activity-pill <%= filters.type === 'registration' ? 'active' : '' %>">
      Registrations <span class="pill-count"><%= categoryCounts.registration %></span>
    </a>
    <a href="/admin/recent-activity?type=discussion&<%= qParams %>" class="activity-pill <%= filters.type === 'discussion' ? 'active' : '' %>">
      Discussions & Q&A <span class="pill-count"><%= categoryCounts.discussion %></span>
    </a>
  </div>

  <!-- Timeline Stream -->
  <% if (!events || events.length === 0) { %>
    <div class="timeline-empty" id="timeline-empty-state">
      <div style="font-size:32px;margin-bottom:8px">📋</div>
      <h3 style="margin:0 0 6px 0;color:#334155">No activities found</h3>
      <p style="margin:0;font-size:13px;color:#64748b">There is no recorded activity matching your current filter criteria.</p>
    </div>
  <% } else { %>
    <div class="timeline-list">
      <%
        let lastDateGroup = null;
        const now = new Date();
        const todayKey = now.toLocaleDateString('en-US', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric' });
        const yest = new Date(now.getTime() - 86400000);
        const yestKey = yest.toLocaleDateString('en-US', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric' });

        events.forEach(ev => {
          const itemDateKey = new Date(ev.timestamp).toLocaleDateString('en-US', {
            timeZone: 'Asia/Kolkata',
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          let groupLabel = itemDateKey;
          if (itemDateKey === todayKey) groupLabel = 'Today · ' + itemDateKey;
          else if (itemDateKey === yestKey) groupLabel = 'Yesterday · ' + itemDateKey;

          if (groupLabel !== lastDateGroup) {
            lastDateGroup = groupLabel;
      %>
        <div class="timeline-date-divider">
          <span class="timeline-date-badge"><%= groupLabel %></span>
        </div>
      <%
          }
          const semColor = ev.semanticColor || 'gray';
      %>
        <div class="timeline-item timeline-item-<%= semColor %>" id="<%= ev.id %>">
          <div class="timeline-marker timeline-marker-<%= semColor %>"></div>
          <div class="timeline-card card-<%= semColor %>">
            <div class="timeline-card-header">
              <div class="timeline-card-badges">
                <span class="badge badge-neutral"><%= ev.categoryLabel %></span>
                <span class="badge <%= ev.badgeClass %>"><%= ev.badgeText %></span>
              </div>
              <div class="timeline-time" title="<%= ev.timestamp.toISOString() %>">
                <%= fmtIST(ev.timestamp) %>
                <% const rel = fmtRelativeTime(ev.timestamp); if (rel) { %>
                  <span class="muted">(<%= rel %>)</span>
                <% } %>
              </div>
            </div>

            <div class="timeline-title"><%= ev.title %></div>
            <div class="timeline-desc"><%= ev.description %></div>

            <div class="timeline-meta-box">
              <% if (ev.actor && (ev.actor.email || ev.actor.name)) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Actor:</span>
                  <span><%= ev.actor.name ? ev.actor.name + ' (' + ev.actor.email + ')' : ev.actor.email %></span>
                  <%- roleBadge(ev.actor.role) %>
                </div>
              <% } %>

              <% if (ev.targetUser && (ev.targetUser.email || ev.targetUser.name)) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">User:</span>
                  <span><%= ev.targetUser.name ? ev.targetUser.name + ' (' + ev.targetUser.email + ')' : ev.targetUser.email %></span>
                  <%- roleBadge(ev.targetUser.role) %>
                  <%- statusBadge(ev.targetUser.status) %>
                </div>
              <% } %>

              <% if (ev.targetContent && (ev.targetContent.title || ev.targetContent.path)) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Content:</span>
                  <% if (ev.targetContent.discussionId) { %>
                    <a href="/discussions/<%= ev.targetContent.discussionId %>" target="_blank" rel="noopener noreferrer" class="activity-link">
                      <%= ev.targetContent.title || 'Discussion #' + ev.targetContent.discussionId %>
                    </a>
                  <% } else if (ev.targetContent.path) { %>
                    <a href="<%= (typeof contentRouteForPath === 'function' ? contentRouteForPath(ev.targetContent.path) : (ev.targetContent.path.endsWith('.txt') ? '/query/' : '/item/')) + ev.targetContent.path.split('/').map(encodeURIComponent).join('/') %>" target="_blank" rel="noopener noreferrer" class="activity-link">
                      <%= ev.targetContent.title || ev.targetContent.path.split('/').pop() %> ↗
                    </a>
                  <% } else { %>
                    <span><%= ev.targetContent.title || ev.targetContent.path %></span>
                  <% } %>
                  <% if (ev.targetContent.path) { %>
                    <a href="<%= (typeof contentRouteForPath === 'function' ? contentRouteForPath(ev.targetContent.path) : (ev.targetContent.path.endsWith('.txt') ? '/query/' : '/item/')) + ev.targetContent.path.split('/').map(encodeURIComponent).join('/') %>" target="_blank" rel="noopener noreferrer" class="muted" style="text-decoration:none;">
                      [<code><%= ev.targetContent.path %></code>] &nearr;
                    </a>
                  <% } %>
                </div>
              <% } %>

              <% if (ev.meta && ev.meta.statusChange) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Status:</span>
                  <span><%= ev.meta.statusChange %></span>
                </div>
              <% } %>

              <% if (ev.meta && ev.meta.expiryChange) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Expiry:</span>
                  <span><%= ev.meta.expiryChange %></span>
                </div>
              <% } %>

              <% if (ev.meta && ev.meta.roleChange) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Role Change:</span>
                  <span><%= ev.meta.roleChange %></span>
                </div>
              <% } %>

              <% if (ev.meta && ev.meta.permission) { %>
                <div class="timeline-meta-item">
                  <span class="timeline-meta-label">Permission:</span>
                  <span class="badge badge-purple"><%= ev.meta.permission %></span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <%
        function pageUrl(p) {
          const params = new URLSearchParams();
          if (filters.type && filters.type !== 'all') params.set('type', filters.type);
          if (filters.dateRange && filters.dateRange !== 'all') params.set('dateRange', filters.dateRange);
          if (filters.startDate) params.set('startDate', filters.startDate);
          if (filters.endDate) params.set('endDate', filters.endDate);
          if (filters.search) params.set('search', filters.search);
          params.set('page', p);
          return '/admin/recent-activity?' + params.toString();
        }
      %>
      <div class="timeline-pagination">
        <div class="muted">
          Showing <%= (page - 1) * limit + 1 %>–<%= Math.min(page * limit, total) %> of <%= total %> activities
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <% if (page > 1) { %>
            <a href="<%= pageUrl(page - 1) %>" class="button small" style="background:#fff;border:1px solid #d8dee8;color:#1e293b">&larr; Previous</a>
          <% } %>
          <span style="font-size:13px;font-weight:600;color:#475569">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a href="<%= pageUrl(page + 1) %>" class="button small" style="background:#fff;border:1px solid #d8dee8;color:#1e293b">Next &rarr;</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</main>
<%- include('partials/footer') %>

<script>
  (function() {
    const rangeSelect = document.getElementById('filter-date-range');
    const startGroup = document.getElementById('custom-start-group');
    const endGroup = document.getElementById('custom-end-group');

    if (rangeSelect && startGroup && endGroup) {
      rangeSelect.addEventListener('change', function() {
        if (this.value === 'custom') {
          startGroup.style.display = '';
          endGroup.style.display = '';
        } else {
          startGroup.style.display = 'none';
          endGroup.style.display = 'none';
        }
      });
    }
  })();
</script>
</body>
</html>
