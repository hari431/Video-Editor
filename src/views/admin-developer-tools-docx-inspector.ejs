<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>DOCX Structural Inspector · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>DOCX Structural Inspector</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Upload any Word document (`.docx`) to inspect its layout structure (paragraphs, headings, tables, links, images), list all detected standard double-brace placeholders (e.g. `{{ClaimNumber}}`), and extract raw textual contents. **Processing runs fully in-memory locally without sending content externally.**
    </p>

    <!-- Upload Panel -->
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      <h2 style="font-size:16px; margin-top:0; margin-bottom:12px;">Select DOCX Document</h2>
      <div style="margin-bottom:16px;">
        <input type="file" id="docxFileInput" accept=".docx" style="width:100%; max-width:400px; font-size:13px; padding:8px; border:1px solid #cbd5e1; border-radius:8px; background:#f8fafc;" />
      </div>

      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:24px;">
        <button type="button" class="button small primary" id="inspectBtn">⚡ Inspect DOCX Layout</button>
        <button type="button" class="button small secondary" id="loadSampleBtn" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#334155;">Load Sample DOCX</button>
        <button type="button" class="button small secondary" id="clearBtn">Clear</button>
      </div>

      <!-- Error banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mb-6"></div>

      <!-- Analysis Results Panel -->
      <div id="resultsPanel" class="hidden">
        <hr style="border:0; border-top:1px solid #e2e8f0; margin:24px 0;">

        <!-- Metadata Stats -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Paragraphs</span>
            <span id="statParagraphs" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Headings</span>
            <span id="statHeadings" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Tables</span>
            <span id="statTables" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Hyperlinks</span>
            <span id="statLinks" class="text-2xl font-black text-slate-800">0</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Images</span>
            <span id="statImages" class="text-2xl font-black text-slate-800">0</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
          <!-- Text Extracted Panel -->
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
              <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                Extracted Raw Text View
              </h3>
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded border transition-colors shrink-0" id="copyTextBtn">Copy Text</button>
            </div>
            <pre id="extractedTextPre" class="bg-slate-50 border border-slate-200 p-4 rounded-xl font-mono text-xs text-slate-800 overflow-auto max-h-[400px] leading-relaxed select-all whitespace-pre-wrap"></pre>
          </div>

          <!-- Template Placeholders Panel -->
          <div class="bg-indigo-50/50 border border-indigo-100 rounded-xl p-5 space-y-4">
            <h3 class="text-xs font-bold text-indigo-900 uppercase tracking-wider border-b border-indigo-100 pb-2 flex items-center justify-between">
              Detected Placeholders
              <span class="text-[9px] bg-indigo-100 text-indigo-800 px-1.5 py-0.5 rounded font-bold font-mono">Template Tags</span>
            </h3>
            <p class="text-[11px] text-slate-500">Listed below are all double-brace template markers (e.g. <code>{{var}}</code>) found inside the document:</p>
            <ul id="placeholdersList" class="space-y-1.5">
              <!-- Placeholder items -->
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <!-- Browser DOCX Client Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const docxFileInput = document.getElementById('docxFileInput');
      const inspectBtn = document.getElementById('inspectBtn');
      const loadSampleBtn = document.getElementById('loadSampleBtn');
      const clearBtn = document.getElementById('clearBtn');
      const errorContainer = document.getElementById('errorContainer');
      const resultsPanel = document.getElementById('resultsPanel');
      const copyTextBtn = document.getElementById('copyTextBtn');

      const statParagraphs = document.getElementById('statParagraphs');
      const statHeadings = document.getElementById('statHeadings');
      const statTables = document.getElementById('statTables');
      const statLinks = document.getElementById('statLinks');
      const statImages = document.getElementById('statImages');
      const extractedTextPre = document.getElementById('extractedTextPre');
      const placeholdersList = document.getElementById('placeholdersList');

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          docxFileInput.value = '';
          resultsPanel.classList.add('hidden');
          errorContainer.classList.add('hidden');
        });
      }

      if (loadSampleBtn) {
        loadSampleBtn.addEventListener('click', async () => {
          loadSampleBtn.disabled = true;
          loadSampleBtn.textContent = 'Loading Sample...';
          errorContainer.classList.add('hidden');

          try {
            const res = await fetch('/api/admin/developer-tools/docx-inspector/sample');
            if (!res.ok) throw new Error('Failed to fetch synthetic sample docx.');
            const blob = await res.blob();
            const file = new File([blob], 'synthetic_word_sample.docx', { type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' });

            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            docxFileInput.files = dataTransfer.files;

            inspectBtn.click();
          } catch (err) {
            showError(err.message || 'Unable to load synthetic sample DOCX.');
          } finally {
            loadSampleBtn.disabled = false;
            loadSampleBtn.textContent = 'Load Sample DOCX';
          }
        });
      }

      if (inspectBtn) {
        inspectBtn.addEventListener('click', async () => {
          const file = docxFileInput.files[0];
          if (!file) {
            showError('Please select a valid .docx file to inspect.');
            return;
          }

          inspectBtn.disabled = true;
          inspectBtn.textContent = 'Inspecting DOCX...';
          errorContainer.classList.add('hidden');
          resultsPanel.classList.add('hidden');

          const formData = new FormData();
          formData.append('docx', file);

          try {
            const res = await fetch('/api/admin/developer-tools/docx-inspector', {
              method: 'POST',
              body: formData
            });

            const data = await res.json();
            if (!res.ok) {
              throw new Error(data.error || 'Server error occurred during DOCX analysis.');
            }

            statParagraphs.textContent = data.pCount;
            statHeadings.textContent = data.headingCount;
            statTables.textContent = data.tableCount;
            statLinks.textContent = data.linkCount;
            statImages.textContent = data.imageCount;
            extractedTextPre.textContent = data.extractedText || 'No text extracted.';

            // Populate placeholders
            placeholdersList.innerHTML = '';
            if (!data.placeholders || data.placeholders.length === 0) {
              placeholdersList.innerHTML = '<li class="text-xs text-slate-400 italic">No placeholders detected</li>';
            } else {
              data.placeholders.forEach(ph => {
                const li = document.createElement('li');
                li.className = 'text-xs font-mono font-bold text-indigo-700 bg-indigo-50 border border-indigo-100 rounded px-2.5 py-1';
                li.textContent = ph;
                placeholdersList.appendChild(li);
              });
            }

            resultsPanel.classList.remove('hidden');

          } catch (err) {
            showError(err.message);
          } finally {
            inspectBtn.disabled = false;
            inspectBtn.textContent = '⚡ Inspect DOCX Layout';
          }
        });
      }

      if (copyTextBtn) {
        copyTextBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(extractedTextPre.textContent).then(() => {
            const originalText = copyTextBtn.textContent;
            copyTextBtn.textContent = '✓ Copied!';
            setTimeout(() => {
              copyTextBtn.textContent = originalText;
            }, 1500);
          });
        });
      }

      function showError(msg) {
        errorContainer.classList.remove('hidden');
        errorContainer.innerHTML = `
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <div class="text-sm font-semibold text-red-900">${msg}</div>
          </div>
        `;
      }
    });
  </script>
</body>
</html>
