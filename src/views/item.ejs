<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= prettyTitle(fileName) %> · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar"><a class="brand" href="/">Learn with me</a><% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %><a class="nav-link" href="/plans">💎 Available Plans</a><% } %><% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %><% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %><a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a><% } %><% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %><a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a><% } %><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<%- include('partials/access-expiry') %>
<main class="container">
  <div class="breadcrumbs"><a href="/">Home</a><% const parts = itemPath.split('/'); parts.pop(); parts.forEach((part, i, arr) => { const p = arr.slice(0, i+1).join('/'); %><span>/</span><a href="/browse/<%= p.split('/').map(encodeURIComponent).join('/') %>"><%= part %></a><% }) %></div>
  <section class="query-head">
    <div><h1><%= prettyTitle(fileName) %></h1><div class="meta"><span>Category: <strong><%= categoryForPath(itemPath) %></strong></span><span>Type: <strong><%= typeLabel %></strong></span><span>Size: <strong><%= sizeText %></strong></span><span>Location: <code><%= itemPath %></code></span></div></div>
    <% if (typeof showDownloadButton !== 'undefined' ? showDownloadButton : true) { %><a class="button primary" href="<%= typeof downloadHref !== 'undefined' ? downloadHref : fileHref %>">Open / Download</a><% } %>
    <% if (typeof type !== 'undefined' && type === 'pdf' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER' || user.isAdmin || user.isOwner)) { %>
      <a class="button small" data-testid="edit-pdf-link" href="/admin/pdf-editor?path=<%= encodeURIComponent(itemPath) %>" style="text-decoration:none;margin-left:8px;">✏️ Edit PDF</a>
    <% } %>
  </section>
  <% if (typeof showAd !== 'undefined' && showAd) { %><%- include('partials/ad-slot', { showAd, slotId: typeof slotId !== 'undefined' ? slotId : 'item-top' }) %><% } %>
  <% const _canLikeItem = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikeItem) { %>
  <section class="like-control item-like-row">
    <span class="like-label">♥ <span class="like-count"><%= likeCount %></span> Likes</span>
    <button class="like-btn" data-path="<%= itemPath %>"><%= liked ? 'Unlike' : 'Like' %></button>
  </section>
  <% } %>
  <section class="share-row" style="margin:12px 0;">
    <%- include('partials/share-button', { sharePath: typeof itemPath !== 'undefined' ? itemPath : null }) %>
  </section>
  <% if (viewable && canRenderInBrowser) { %>
    <% if (typeof type !== 'undefined' && type === 'image') { %>
      <div class="file-preview">
        <div class="image-viewer-container">
          <img class="image-viewer-img" src="<%= fileHref %>" alt="<%= prettyTitle(fileName) %>">
        </div>
      </div>
    <% } else if (typeof type !== 'undefined' && type === 'pdf') { %>
      <% if (user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER' || user.isAdmin || user.isOwner)) { %>
        <div class="file-preview"><iframe src="<%= fileHref %>" title="<%= prettyTitle(fileName) %>"></iframe></div>
      <% } else { %>
        <div class="file-preview"><iframe src="<%= fileHref %>" title="<%= prettyTitle(fileName) %>" style="width: 100%; height: 100%; border: none;"></iframe></div>
      <% } %>
    <% } else { %>
      <div class="file-preview"><iframe src="<%= fileHref %>" title="<%= prettyTitle(fileName) %>"></iframe></div>
    <% } %>
  <% } else { %>
  <p class="muted">This file type opens in its native application.<% if (typeof showDownloadButton !== 'undefined' ? showDownloadButton : true) { %> Use "Open / Download" above.<% } %></p>
  <% } %>

  <%- include('partials/pinned-references', { pinnedRefs: typeof pinnedRefs !== 'undefined' ? pinnedRefs : [] }) %>

  <%- include('partials/pin-generator', { pinGen: typeof pinGen !== 'undefined' ? pinGen : null }) %>

  <%- include('partials/notes-widget', { 
    hasNotes: (typeof hasNotes !== 'undefined' ? hasNotes : false), 
    userNote: (typeof userNote !== 'undefined' ? userNote : null), 
    itemPath: itemPath, 
    title: prettyTitle(fileName) 
  }) %>

  <section class="detail-discussions">
    <div class="have-question-header">
      <h2>Have a question?</h2>
    </div>
    <p class="detail-discussions-note">Your identity is masked as <strong>Anonymous</strong> to other users. Only Admin can see who posted.</p>
    <% const _canDiscussDetailI = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
    <% if (_canDiscussDetailI) { %>
    <form method="post" action="/discussions" class="discussion-new-form">
      <input type="hidden" name="item_path" value="<%= itemPath %>">
      <input type="text" name="title" placeholder="Question title" required maxlength="200" class="discussion-input-title">
      <textarea name="body" placeholder="Details (optional)" rows="3" maxlength="50000" class="discussion-input-body"></textarea>
      <div class="detail-discussions-form-actions">
        <button type="submit" class="button primary">Post your question</button>
        <a href="/discussions?path=<%= encodeURIComponent(itemPath) %>" class="detail-discussions-view-all">View all discussions (<%= discussions.length %>)</a>
      </div>
    </form>
    <% } else { %>
    <div class="flash flash-ok" data-testid="discussions-readonly-msg" style="margin: 8px 0; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">Discussions are available in read-only mode. Posting, replying and liking requires active access.</div>
    <div style="margin: 8px 0;"><a href="/discussions?path=<%= encodeURIComponent(itemPath) %>" class="detail-discussions-view-all">View all discussions (<%= discussions.length %>)</a></div>
    <% } %>
    <% if (discussions.length > 0) { %>
      <div class="detail-discussions-list">
        <% discussions.slice(0, 5).forEach(d => { %>
          <a href="/discussions/<%= d.id %>" class="detail-discussion-item">
            <span class="detail-discussion-title"><%- (typeof linkifyBody === 'function' ? linkifyBody(d.title) : String(d.title||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></span>
            <span class="detail-discussion-meta"><%= d.reply_count %> <%= d.reply_count === 1 ? 'reply' : 'replies' %></span>
          </a>
        <% }) %>
        <% if (discussions.length > 5) { %>
          <a href="/discussions?path=<%= encodeURIComponent(itemPath) %>" class="detail-discussions-more">View all <%= discussions.length %> discussions →</a>
        <% } %>
      </div>
    <% } %>
  </section>
  <%- include('partials/related', { relatedItems: typeof relatedItems !== 'undefined' ? relatedItems : [] }) %>
</main>
<%- include('partials/footer') %>
<script src="/like.js" defer></script>
<%- include('partials/admin-likes', { itemPath: itemPath }) %>
<script src="/discussion-form.js" defer></script>
</body></html>