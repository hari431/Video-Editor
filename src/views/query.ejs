<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= displayName(file.path.split('/').at(-1)) %> · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar"><a class="brand" href="/">Learn with me</a><% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %><a class="nav-link" href="/plans">💎 Available Plans</a><% } %><% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %><% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %><a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a><% } %><% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %><a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a><% } %><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<%- include('partials/access-expiry') %>
<main class="container">
  <% const isTextFile = path.toLowerCase().endsWith('.txt'); %>
  <div class="breadcrumbs"><a href="/">Home</a><% const parts = path.split('/'); parts.pop(); parts.forEach((part, i, arr) => { const p = arr.slice(0, i+1).join('/'); %><span>/</span><a href="/browse/<%= p.split('/').map(encodeURIComponent).join('/') %>"><%= part %></a><% }) %></div>
  <section class="query-head <%= isTextFile ? 'sticky-query-head' : '' %>">
    <div><h1><%= displayName(file.path.split('/').at(-1)) %></h1><div class="meta"><span>Category: <strong><%= categoryForPath(file.path) %></strong></span><span>Git path: <code><%= path %></code></span></div></div>
    <div class="query-actions"><% if (typeof canCopy !== 'undefined' && canCopy) { %><button id="copyButton" class="button primary" data-path="<%= path %>">Copy Query</button><% } %><% const _canLikeQ = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikeQ) { %><span class="like-control"><span class="like-label">♥ <span class="like-count"><%= (likeCount !== undefined ? likeCount : 0) %></span> Likes</span><button class="like-btn" data-path="<%= path %>"><%= liked ? 'Unlike' : 'Like' %></button></span><% } %><%- include('partials/share-button', { sharePath: typeof path !== 'undefined' ? path : null }) %></div>
  </section>
  <% if (typeof showAd !== 'undefined' && showAd) { %><%- include('partials/ad-slot', { showAd, slotId: typeof slotId !== 'undefined' ? slotId : 'query-top' }) %><% } %>
  <% const isRichGuide = isTextFile && /^Reviews\/Premium Knowledge\/Guidewire\/(?:Query API|Application Integrations|CA7 SBT Configuration Guide|Creating Products From APD|APD Senior Interview Questions and Answers|Cloud API Consumer|Cloud API Developer|APD Configuration & PolicyCenter Integration Guide|Guidewire Configuration Fundamentals - Developer Knowledge Guide|Guidewire Studio - Developer Knowledge Guide|PolicyCenter Application Configuration - Developer Knowledge Guide|PolicyCenter Product Designer & Product Model - Developer Knowledge Guide|PolicyCenter Rating Configuration - Developer Knowledge Guide|PolicyCenter Reinsurance - Concepts & Configuration Guide)\.txt$/i.test(path) && /^\s*#\s+.+/m.test(file.content || '') && /(^|\n)#{1,3}\s+.+/m.test(file.content || ''); %>
  <% if (isRichGuide) { %>
    <div class="rich-guide-layout" data-rich-guide>
      <aside class="rich-guide-toc" aria-label="On this page">
        <div class="rich-guide-toc-card">
          <div class="rich-guide-toc-title">📚 On this page</div>
          <div class="rich-guide-progress"><span id="richGuideProgressBar"></span></div>
          <nav id="richGuideToc"></nav>
        </div>
      </aside>
      <article class="rich-guide-content" id="richGuideContent">
        <div class="rich-guide-reading-bar">
          <span>✨ Premium Guide</span>
          <span id="richGuideReading">Reading guide</span>
        </div>
        <div id="richGuideRendered" class="rich-guide-rendered"></div>
      </article>
    </div>
    <script type="application/json" id="richGuideSource"><%- JSON.stringify(file.content || '').replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %></script>
  <% } else { %>
    <div class="code-editor <%= isTextFile ? 'interview-question-code' : '' %>">
      <pre class="code-gutter" id="codeGutter" aria-hidden="true"></pre>
      <pre class="code"><code id="queryCode"><%= file.content %></code></pre>
    </div>
  <% } %>
  <%- include('partials/pinned-references', { pinnedRefs: typeof pinnedRefs !== 'undefined' ? pinnedRefs : [] }) %>
  <%- include('partials/pin-generator', { pinGen: typeof pinGen !== 'undefined' ? pinGen : null }) %>
  <%- include('partials/notes-widget', { 
    hasNotes: (typeof hasNotes !== 'undefined' ? hasNotes : false), 
    userNote: (typeof userNote !== 'undefined' ? userNote : null), 
    itemPath: path, 
    title: displayName(file.path.split('/').at(-1)) 
  }) %>
  <section class="detail-discussions">
    <div class="have-question-header">
      <h2>Have a question?</h2>
    </div>
    <p class="detail-discussions-note">Your identity is masked as <strong>Anonymous</strong> to other users. Only Admin can see who posted.</p>
    <% const _canDiscussDetailQ = typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false); %>
    <% if (_canDiscussDetailQ) { %>
    <form method="post" action="/discussions" class="discussion-new-form">
      <input type="hidden" name="item_path" value="<%= path %>">
      <input type="text" name="title" placeholder="Question title" required maxlength="200" class="discussion-input-title">
      <textarea name="body" placeholder="Details (optional)" rows="3" maxlength="5000" class="discussion-input-body"></textarea>
      <div class="detail-discussions-form-actions">
        <button type="submit" class="button primary">Post your question</button>
        <a href="/discussions?path=<%= encodeURIComponent(path) %>" class="detail-discussions-view-all">View all discussions (<%= discussions.length %>)</a>
      </div>
    </form>
    <% } else { %>
    <div class="flash flash-ok" data-testid="discussions-readonly-msg" style="margin: 8px 0; background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">Discussions are available in read-only mode. Posting, replying and liking requires active access.</div>
    <div style="margin: 8px 0;"><a href="/discussions?path=<%= encodeURIComponent(path) %>" class="detail-discussions-view-all">View all discussions (<%= discussions.length %>)</a></div>
    <% } %>
    <% if (discussions.length > 0) { %>
      <div class="detail-discussions-list">
        <% discussions.slice(0, 5).forEach(d => { %>
          <a href="/discussions/<%= d.id %>" class="detail-discussion-item">
            <span class="detail-discussion-title"><%- (typeof linkifyBody === 'function' ? linkifyBody(d.title) : String(d.title||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))) %></span>
            <span class="detail-discussion-meta"><%= d.reply_count %> <%= d.reply_count === 1 ? 'reply' : 'replies' %></span>
          </a>
        <% }) %>
        <% if (discussions.length > 5) { %>
          <a href="/discussions?path=<%= encodeURIComponent(path) %>" class="detail-discussions-more">View all <%= discussions.length %> discussions →</a>
        <% } %>
      </div>
    <% } %>
  </section>
  <%- include('partials/related', { relatedItems: typeof relatedItems !== 'undefined' ? relatedItems : [] }) %>
</main>
<script>
(function () {
  var sourceEl = document.getElementById('richGuideSource');
  var renderTarget = document.getElementById('richGuideRendered');
  if (!sourceEl || !renderTarget) return;

  var source = '';
  try { source = JSON.parse(sourceEl.textContent || '""'); } catch (e) { return; }

  var esc = function (s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  };

  var slugify = function (text) {
    return String(text).toLowerCase().trim()
      .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
  };

  var inline = function (text) {
    var s = esc(text);
    s = s.replace(/\x60([^\x60]+)\x60/g, '<code>$1</code>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/__([^_]+)__/g, '<strong>$1</strong>');
    s = s.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
    return s;
  };

  var lines = source.replace(/\r\n?/g, '\n').split('\n');
  var html = '';
  var toc = [];
  var inCode = false;
  var codeLang = '';
  var codeLines = [];
  var paragraph = [];
  var listType = null;

  var flushParagraph = function () {
    if (!paragraph.length) return;
    html += '<p>' + inline(paragraph.join(' ')) + '</p>';
    paragraph = [];
  };

  var closeList = function () {
    if (!listType) return;
    html += '</' + listType + '>';
    listType = null;
  };

  var addHeading = function (level, text) {
    flushParagraph(); closeList();
    var clean = text.replace(/\s+#+\s*$/, '').trim();
    var id = slugify(clean) || ('section-' + (toc.length + 1));
    var base = id, n = 2;
    while (document.getElementById(id) || toc.some(function (x) { return x.id === id; })) id = base + '-' + n++;
    toc.push({ id: id, text: clean, level: level });
    html += '<h' + level + ' id="' + id + '"><a class="rich-guide-anchor" href="#' + id + '" aria-label="Link to ' + esc(clean) + '">#</a>' + inline(clean) + '</h' + level + '>';
  };

  var highlightGosu = function (raw) {
    var tokenRe = /(\/\/[^\n]*|\/\*[\s\S]*?\*\/)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|\b(uses|function|var|if|else|elseif|then|try|catch|finally|throw|return|new|class|extends|implements|interface|enum|override|static|final|property|get|set|construct|this|super|switch|case|default|for|foreach|while|until|do|break|continue|in|as|and|or|not|is|true|false|null)\b|\b(\d[\d,_]*(?:\.\d+)?)\b|\b([A-Z][A-Za-z0-9_]*)\b|([a-zA-Z_][a-zA-Z0-9_]*)(?=\s*\()/g;
    var out = ''; var last = 0; var match;
    while ((match = tokenRe.exec(raw))) {
      out += esc(raw.slice(last, match.index));
      var cls = match[1] ? 'comment' : match[2] ? 'string' : match[3] ? 'keyword' : match[4] ? 'number' : match[5] ? 'type' : 'function';
      out += '<span class="rg-' + cls + '">' + esc(match[0]) + '</span>';
      last = match.index + match[0].length;
    }
    return out + esc(raw.slice(last));
  };

  var addCode = function () {
    var raw = codeLines.join('\n');
    var language = (codeLang || '').toLowerCase();
    var codeClass = language ? ' language-' + esc(language) : '';
    var renderedCode = language === 'gosu' ? highlightGosu(raw) : esc(raw);
    html += '<div class="rich-guide-code-wrap">';
    if (language) html += '<div class="rich-guide-code-label">' + esc(language) + '</div>';
    html += '<pre class="rich-guide-code' + codeClass + '"><code>' + renderedCode + '</code></pre></div>';
    codeLines = []; codeLang = ''; inCode = false;
  };

  lines.forEach(function (line) {
    if (inCode) {
      if (/^\s*\x60\x60\x60\s*$/.test(line)) addCode();
      else codeLines.push(line);
      return;
    }
    var fence = line.match(/^\s*\x60\x60\x60\s*([A-Za-z0-9_-]+)?\s*$/);
    if (fence) { flushParagraph(); closeList(); inCode = true; codeLang = fence[1] || ''; codeLines = []; return; }

    if (/^\s*#{1,3}\s+/.test(line)) {
      var hm = line.match(/^\s*(#{1,3})\s+(.+?)\s*$/);
      addHeading(hm[1].length, hm[2]); return;
    }
    if (/^\s*---+\s*$/.test(line)) { flushParagraph(); closeList(); html += '<hr>'; return; }

    var bm = line.match(/^\s*>\s?(.*)$/);
    if (bm) { flushParagraph(); closeList(); html += '<blockquote>' + inline(bm[1]) + '</blockquote>'; return; }

    var ul = line.match(/^\s*[-*]\s+(.+)$/);
    var ol = line.match(/^\s*\d+[.)]\s+(.+)$/);
    if (ul || ol) {
      flushParagraph();
      var wanted = ul ? 'ul' : 'ol';
      if (listType !== wanted) { closeList(); html += '<' + wanted + '>'; listType = wanted; }
      html += '<li>' + inline((ul || ol)[1]) + '</li>';
      return;
    }

    if (!line.trim()) { flushParagraph(); closeList(); return; }
    paragraph.push(line.trim());
  });
  if (inCode) addCode();
  flushParagraph(); closeList();
  renderTarget.innerHTML = html;

  var headingEls = Array.prototype.slice.call(renderTarget.querySelectorAll('h1,h2,h3'));
  var tocEl = document.getElementById('richGuideToc');
  if (tocEl) {
    tocEl.innerHTML = toc.map(function (item) {
      return '<a class="rich-guide-toc-item level-' + item.level + '" href="#' + item.id + '" data-section="' + item.id + '">' + esc(item.text) + '</a>';
    }).join('');
  }

  var tocLinks = Array.prototype.slice.call(document.querySelectorAll('.rich-guide-toc-item'));
  var progress = document.getElementById('richGuideProgressBar');
  var reading = document.getElementById('richGuideReading');

  var setActive = function (id) {
    tocLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('data-section') === id); });
    var current = toc.find(function (x) { return x.id === id; });
    if (reading && current) reading.textContent = current.text;
  };

  if ('IntersectionObserver' in window) {
    var visible = {};
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { visible[entry.target.id] = entry.isIntersecting; });
      var current = headingEls.find(function (h) { return visible[h.id]; });
      if (current) setActive(current.id);
    }, { rootMargin: '-96px 0px -65% 0px', threshold: 0 });
    headingEls.forEach(function (h) { observer.observe(h); });
  }

  tocLinks.forEach(function (link) {
    link.addEventListener('click', function (event) {
      var target = document.getElementById(link.getAttribute('data-section'));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', '#' + target.id);
      setActive(target.id);
    });
  });

  var updateProgress = function () {
    var doc = document.documentElement;
    var max = Math.max(1, doc.scrollHeight - window.innerHeight);
    var pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
    if (progress) progress.style.width = pct + '%';
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  if (window.location.hash) {
    var initial = document.getElementById(window.location.hash.slice(1));
    if (initial) setTimeout(function () { initial.scrollIntoView(); setActive(initial.id); }, 50);
  }
})();
</script>
<script>
(function () {
  var el = document.getElementById('queryCode');
  if (!el) return;
  var gutter = document.getElementById('codeGutter');
  var src = el.textContent;
  var esc = function (s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };
  var re = /(\/\/[^\n]*|\/\*[\s\S]*?\*\/)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|\b(uses|function|var|if|else|elseif|then|try|catch|finally|throw|return|new|class|extends|implements|interface|enum|override|static|final|property|get|set|construct|this|super|switch|case|default|for|foreach|while|until|do|break|continue|in|as|and|or|not|is|true|false|null)\b|\b(\d[\d,_]*(?:\.\d+)?)\b|\b([A-Z][A-Za-z0-9_]*)\b|([a-zA-Z_][a-zA-Z0-9_]*)(?=\s*\()/g;
  el.innerHTML = src.replace(re, function (m, c, s, k, n, t, f) {
    var cls = c ? 'tok-c' : s ? 'tok-s' : k ? 'tok-k' : n ? 'tok-n' : t ? 'tok-t' : f ? 'tok-f' : '';
    return cls ? '<span class="' + cls + '">' + esc(m) + '</span>' : esc(m);
  });
  if (gutter) {
    for (var i = 1; i <= src.split('\n').length; i++) {
      if (gutter.textContent) gutter.textContent += '\n';
      gutter.textContent += i;
    }
  }
})();
</script>
<%- include('partials/footer') %>
<script src="/app.js"></script>
<script src="/like.js" defer></script>
<%- include('partials/admin-likes', { itemPath: path }) %>
<script src="/discussion-form.js" defer></script>
</body></html>
