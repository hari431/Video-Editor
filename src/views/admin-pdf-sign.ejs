<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Sign PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Draw or upload a signature image, place it on a page of a local PDF, and download a <strong>new</strong> file. This is a <strong>visual signature only — NOT a cryptographic digital signature</strong>: it proves nothing about identity or document integrity. The original files are never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfSignAvailable !== 'undefined' ? !!pdfSignAvailable : false; %>
<% const _maxMb = (typeof pdfSignMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfSignMaxFileMb)) && Number(pdfSignMaxFileMb) >= 1) ? Math.floor(Number(pdfSignMaxFileMb)) : 50; %>
<% const _maxImgMb = (typeof pdfSignMaxImageMb !== 'undefined' && Number.isFinite(Number(pdfSignMaxImageMb)) && Number(pdfSignMaxImageMb) >= 1) ? Math.floor(Number(pdfSignMaxImageMb)) : 5; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-sign-disabled">PDF signing is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-sign-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>" data-max-image-mb="<%= _maxImgMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfSignPdfPick" data-testid="pdf-sign-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfSignPdfFile" data-testid="pdf-sign-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <button type="button" class="button small" id="pdfSignImgPick" data-testid="pdf-sign-image-pick" <%= _available ? '' : 'disabled' %>>✍️ Select signature image</button>
    <input type="file" id="pdfSignImgFile" data-testid="pdf-sign-image" accept=".png,.jpg,.jpeg,image/png,image/jpeg" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <span class="muted" style="font-size:12px;">One PDF (max <%= _maxMb %> MB) + one PNG/JPG (max <%= _maxImgMb %> MB)</span>
  </div>
  <p class="muted" id="pdfSignFileInfo" data-testid="pdf-sign-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <p class="muted" id="pdfSignImgInfo" data-testid="pdf-sign-imageinfo" style="font-size:13px;">No signature image selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Placement (visual only)</legend>
    <label style="font-size:13px;">Page <input type="number" id="pdfSignPage" data-testid="pdf-sign-page" value="1" min="1" step="1" style="width:70px;" <%= _available ? '' : 'disabled' %>></label>
    <label style="font-size:13px;margin-left:8px;">Position
      <select id="pdfSignPosition" data-testid="pdf-sign-position" <%= _available ? '' : 'disabled' %>>
        <option value="bottom-right" selected>Bottom right</option>
        <option value="bottom-left">Bottom left</option>
        <option value="bottom-center">Bottom center</option>
        <option value="top-right">Top right</option>
        <option value="top-left">Top left</option>
        <option value="top-center">Top center</option>
        <option value="center">Center</option>
        <option value="middle-left">Middle left</option>
        <option value="middle-right">Middle right</option>
      </select>
    </label>
    <label style="font-size:13px;margin-left:8px;">Width (pt) <input type="number" id="pdfSignWidth" data-testid="pdf-sign-width" value="150" min="20" max="400" step="10" style="width:70px;" <%= _available ? '' : 'disabled' %>></label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfSignBtn" data-testid="pdf-sign-submit" <%= _available ? '' : 'disabled' %>>✍️ Sign &amp; download</button>
    <button type="button" class="button small secondary" id="pdfSignClear" data-testid="pdf-sign-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfSignProgress" data-testid="pdf-sign-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Signing… <span id="pdfSignProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-sign-status" id="pdfSignStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-sign-result" id="pdfSignResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-sign.js?v=<%= Date.now() %>"></script>
</body></html>
