<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Home · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container">
<h1>Admin Home</h1>
<p class="muted" style="margin-top:-8px;margin-bottom:16px;">Admin control center — manage users, content, and learner insights.</p>
<section data-testid="ai-center-link" style="background:#eef2ff;border:1px solid #c7d2fe;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <div>
      <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">AI Admin Center</h2>
      <p class="muted" style="margin:4px 0 0;">Admin Assistant, capabilities, diagnostic actions, and digest — read-only, on a dedicated screen.</p>
    </div>
    <a href="/admin/ai" class="button small" data-testid="ai-center-link-anchor" style="text-decoration:none;">Open AI Admin Center</a>
  </div>
</section>
<% if (typeof expenseTrackerLocalMode !== 'undefined' && expenseTrackerLocalMode) { %>
<section data-testid="expense-tracker-home-link" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <div>
      <h2 style="margin:0;font-size:15px;font-weight:700;color:#14532d;">Private Expense & Investment Tracker</h2>
      <p class="muted" style="margin:4px 0 0;">Local-development only. Includes monthly income/expenses, bank balances and investment imports. Requires a separate passcode in addition to Admin sign-in.</p>
      <% if (!(typeof expenseTrackerVisible !== 'undefined' && expenseTrackerVisible)) { %>
      <p style="margin:8px 0 0;font-size:13px;color:#854d0e;">Setup required: set <code>EXPENSE_TRACKER_PASSCODE</code> to a private value of at least 8 characters in your local <code>.env</code>, then restart the server. Do not configure it in production.</p>
      <% } %>
    </div>
    <a href="/admin/expense-tracker" class="button small" data-testid="expense-tracker-home-link-anchor" style="text-decoration:none;">Open Expense Tracker</a>
  </div>
</section>
<% } %>
<%- include('partials/admin-nav') %>
<% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
<% const _na = typeof needsAttention !== 'undefined' && needsAttention ? needsAttention : { pending: 0, expiring: 0, revoked: 0, hidden: 0, unanswered: 0, hasAttention: false }; %>
<section data-testid="needs-attention" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">Needs Attention</h2>
    <span style="font-size:11px;color:#7a8499;letter-spacing:0.02em;text-transform:uppercase;">At-a-glance</span>
  </div>
  <% if (_na.hasAttention) { %>
    <div style="display:flex;flex-wrap:wrap;gap:10px;">
      <% if (_na.pending > 0) { %>
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #fde68a;background:#fffbeb;border-radius:999px;padding:6px 12px;font-size:13px;line-height:1;"><span class="badge badge-warning"><%= _na.pending %></span> Pending access requests <a href="/admin" style="margin-left:2px;font-weight:600;color:#92400e;text-decoration:underline;">Review</a></span>
      <% } %>
      <% if (_na.expiring > 0) { %>
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #fde68a;background:#fffbeb;border-radius:999px;padding:6px 12px;font-size:13px;line-height:1;"><span class="badge badge-warning"><%= _na.expiring %></span> Users expiring within 7 days <a href="/admin/expiring-users" style="margin-left:2px;font-weight:600;color:#92400e;text-decoration:underline;">View</a></span>
      <% } %>
      <% if (_na.unanswered > 0) { %>
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #fde68a;background:#fffbeb;border-radius:999px;padding:6px 12px;font-size:13px;line-height:1;"><span class="badge badge-warning"><%= _na.unanswered %></span> Unanswered questions <a href="/admin/discussions?filter=unanswered" style="margin-left:2px;font-weight:600;color:#92400e;text-decoration:underline;">View</a></span>
      <% } %>
      <% if (_na.hidden > 0) { %>
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #fecaca;background:#fef2f2;border-radius:999px;padding:6px 12px;font-size:13px;line-height:1;"><span class="badge badge-critical"><%= _na.hidden %></span> Hidden items awaiting review <a href="/admin/discussions?filter=hidden" style="margin-left:2px;font-weight:600;color:#991b1b;text-decoration:underline;">Review</a></span>
      <% } %>
      <% if (_na.revoked > 0) { %>
        <span style="display:inline-flex;align-items:center;gap:8px;border:1px solid #fecaca;background:#fef2f2;border-radius:999px;padding:6px 12px;font-size:13px;line-height:1;"><span class="badge badge-critical"><%= _na.revoked %></span> Revoked users <a href="/admin" style="margin-left:2px;font-weight:600;color:#991b1b;text-decoration:underline;">View</a></span>
      <% } %>
    </div>
  <% } else { %>
    <div><span class="badge badge-healthy">✓ Nothing needs your attention</span></div>
  <% } %>
</section>
<div class="stats"><a href="#users" class="stat stat--neutral"><strong><%= stats.total_users %></strong><span>Total users</span></a><div class="stat stat--success"><strong><%= stats.active_today %></strong><span>Active today</span></div><div class="stat stat--success"><strong><%= stats.active_month %></strong><span>Active this month</span></div><a href="#users" class="stat stat--warning"><strong><%= stats.pending_users %></strong><span>Pending approval</span></a><div class="stat stat--info"><strong><%= stats.views_today %></strong><span>Views today</span></div><div class="stat stat--info"><strong><%= stats.copies_today %></strong><span>Copies today</span></div><a href="/admin/discussions" class="stat stat--neutral"><strong><%= stats.total_discussions %></strong><span>Discussions</span></a><a href="/admin/discussions" class="stat stat--neutral"><strong><%= stats.total_replies %></strong><span>Replies</span></a><a href="/admin/learner-notes" class="stat stat--info"><strong><%= (typeof learnerNotesStats !== 'undefined' && learnerNotesStats) ? learnerNotesStats.total_notes : 0 %></strong><span>Learner notes</span></a></div><!-- semantic layout preserved: class="stat" -->
<h2 id="users">Users</h2>
<% const _filter = typeof currentStatusFilter !== 'undefined' ? currentStatusFilter : 'all'; %>
<div data-testid="status-filter" style="margin:10px 0 12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
  <span class="muted" style="font-weight:600">Filter:</span>
  <% const filters=[{v:'all',l:'All'},{v:'pending',l:'Pending'},{v:'active',l:'Active'},{v:'expired',l:'Expired'},{v:'revoked',l:'Revoked'},{v:'premium',l:'Premium'},{v:'without_premium',l:'Without Premium'}]; filters.forEach(({v,l})=>{ const active=_filter===v; %>
    <a href="/admin?status=<%= v %>#users" data-testid="filter-<%= v %>" class="badge <%= active ? 'badge-active' : 'badge-neutral' %>" style="text-decoration:none;padding:6px 12px;border-radius:999px"><%= l %></a>
  <% }) %>
</div>
<div id="bulk-bar" data-testid="bulk-actions" style="margin:10px 0 12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px">
  <span class="muted" style="font-size:13px">Selected: <strong id="selected-count" data-testid="selected-count">0 selected</strong></span>
  <label for="bulk-expiry" class="muted" style="font-size:13px">Access Until:</label>
  <input type="date" id="bulk-expiry" data-testid="bulk-expiry" style="padding:4px 6px;border:1px solid #cbd5e1;border-radius:6px">
  <form id="bulk-activate-form" method="post" action="/admin/users/bulk-activate" style="display:inline">
    <input type="hidden" name="expiry" id="bulk-activate-expiry">
    <input type="hidden" name="status" value="<%= _filter %>">
    <button type="submit" data-testid="bulk-activate" class="button small success">Activate</button>
  </form>
  <form id="bulk-extend-form" method="post" action="/admin/users/bulk-extend" style="display:inline">
    <input type="hidden" name="expiry" id="bulk-extend-expiry">
    <input type="hidden" name="status" value="<%= _filter %>">
    <button type="submit" data-testid="bulk-extend" class="button small success">Extend</button>
  </form>
  <form id="bulk-revoke-form" method="post" action="/admin/users/bulk-revoke" style="display:inline">
    <input type="hidden" name="status" value="<%= _filter %>">
    <button type="submit" data-testid="bulk-revoke" class="button small danger">Revoke</button>
  </form>
  <form id="bulk-premium-form" method="post" action="/admin/users/bulk-premium" style="display:inline">
    <input type="hidden" name="status" value="<%= _filter %>">
    <button type="submit" data-testid="bulk-premium" class="button small" style="background:#fdf4ff; border:1px solid #f5d0fe; color:#a21caf;">Make Premium</button>
  </form>
</div>
<table class="admin-table">
  <thead><tr><th><input type="checkbox" id="select-all-users" data-testid="select-all"> Select All</th><th>Name</th><th>Email</th><th>Role</th><th>Premium Info</th><th>Status</th><th>First login</th><th>Last login</th><th>Last Active</th><th>Access expires</th><th>Actions</th><th>Role Management</th></tr></thead>
  <tbody>
  <% function fmtIST(date) { if (!date) return '—'; return new Date(date).toLocaleString(undefined, { timeZone: 'Asia/Kolkata' }); } %>
  <% function fmtISTDate(date) { if (!date) return '—'; return new Date(date).toLocaleDateString(undefined, { timeZone: 'Asia/Kolkata' }); } %>
  <% function statusBadge(s){ if(!s || s==='—') return '—'; const m={pending:'badge-pending',active:'badge-active',revoked:'badge-revoked',expired:'badge-expired'}; const l={pending:'Pending',active:'Active',revoked:'Revoked',expired:'Expired'}; const cls=m[s]||'badge-neutral'; const label=l[s]||s; return '<span class="badge '+cls+'">'+label+'</span>'; } %>
  <% function roleBadge(r){ if(!r || r==='—') return '—'; const m={OWNER:'badge-owner',ADMIN:'badge-admin',USER:'badge-neutral',PREMIUM:'badge-premium'}; const cls=m[r]||'badge-neutral'; return '<span class="badge '+cls+'">'+r+'</span>'; } %>
  <% users.forEach(u => {
    const role = (typeof getUserRole === 'function' ? getUserRole(u) : (u.app_role || (typeof isAdminEmail === 'function' && isAdminEmail(u.email) ? 'OWNER' : 'USER')));
    const isOwnerRow = role === 'OWNER';
    const isAdminRow = role === 'ADMIN';
    const isProtected = isOwnerRow || isAdminRow;
    const st = statusDisplay(u);
    const label = { pending: 'Pending', active: 'Active', revoked: 'Revoked', expired: 'Expired' }[st] || st;
    const expiry = u.access_expires_at ? new Date(u.access_expires_at) : null;
    const daysRemaining = expiry ? Math.ceil((expiry - new Date()) / 86400000) : null;
    const isExpiringSoon = !isProtected && st === 'active' && daysRemaining !== null && daysRemaining >= 0 && daysRemaining <= 7;
    const eligible = !isProtected;
  %>
    <tr>
      <td><% if (eligible) { %><input type="checkbox" class="user-checkbox" data-testid="user-checkbox" value="<%= u.id %>" data-status="<%= st %>" data-role="<%= role %>"><% } else { %><span class="muted">—</span><% } %></td>
      <td><%= u.name || '—' %><% if (role === 'PREMIUM') { %> <span class="badge badge-premium" data-testid="premium-tag">Premium</span><% } %></td>
      <td><%= u.email %></td>
      <td>
        <% if (isOwnerRow) { %>
          <span class="badge badge-owner">OWNER</span>
        <% } else if (isAdminRow) { %>
          <span class="badge badge-admin">ADMIN</span>
        <% } else if (role === 'PREMIUM') { %>
          <span class="badge badge-premium">PREMIUM</span>
        <% } else { %>
          <span class="badge badge-neutral">USER</span>
        <% } %>
      </td>
      <td>
        <% if (role === 'PREMIUM') { %>
          <% if (u.premium_source === 'subscription') { %>
            <div style="font-size: 11px; line-height: 1.3;">
              <span class="badge badge-premium" style="font-size: 10px; padding: 2px 6px;">Sub: <%= u.subscription_status %></span>
              <% if (u.provider_subscription_id) { %><br><code style="font-size: 10px; color: #64748b;"><%= u.provider_subscription_id %></code><% } %>
              <% if (u.cancel_at_period_end) { %><br><span style="color: #b45309; font-weight: 600;">(Cancelling)</span><% } %>
              <% if (u.current_period_end) { %><br><span class="muted" style="font-size: 10px;">End: <%= fmtISTDate(u.current_period_end) %></span><% } %>
            </div>
          <% } else if (u.premium_source === 'one_time') { %>
            <span class="badge" style="background: #fdf4ff; color: #a21caf; border: 1px solid #f5d0fe; font-size: 10px; padding: 2px 6px;">One-Time Pass</span>
          <% } else { %>
            <span class="badge" style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 10px; padding: 2px 6px;">Manual (Admin)</span>
          <% } %>
        <% } else { %>
          <span class="muted">—</span>
        <% } %>
      </td>
      <td>
        <% if (isOwnerRow) { %>
          <span class="badge badge-active">Active</span>
        <% } else if (isAdminRow) { %>
          <span class="badge badge-active">Active</span>
        <% } else { %>
          <span class="badge badge-<%= st %>"><%= label %></span>
        <% } %>
      </td>
      <td><%= fmtIST(u.first_login_at) %></td>
      <td><%= fmtIST(u.last_login_at) %></td>
      <td><%= fmtIST(u.last_activity_at) %></td>
      <td>
        <% if (isProtected) { %>
          <span class="badge <%= isOwnerRow ? 'badge-owner' : 'badge-admin' %>">Never expires</span>
        <% } else if (st === 'expired') { %>
          <span class="badge badge-expired"><%= fmtISTDate(u.access_expires_at) %></span>
        <% } else if (isExpiringSoon) { %>
          <span class="badge badge-warning"><%= fmtISTDate(u.access_expires_at) %></span> <small class="muted">(<%= daysRemaining %>d)</small>
        <% } else { %>
          <%= fmtISTDate(u.access_expires_at) %>
        <% } %>
      </td>
      <td class="actions">
        <% if (isProtected) { %><span class="muted">Protected</span>
        <% } else if (st === 'pending') { %>
          <form method="post" action="/admin/users/<%= u.id %>/approve" class="admin-form">
            <select name="duration">
              <option value="7">7 days</option>
              <option value="<%= defaultAccessDays %>" selected><%= defaultAccessDays %> days</option>
              <option value="90">90 days</option>
              <option value="custom">Custom</option>
            </select>
            <input type="date" name="expiry" class="custom-date" disabled>
            <button type="submit" class="button small success">Activate</button>
          </form>
        <% } else if (st === 'active') { %>
          <form method="post" action="/admin/users/<%= u.id %>/extend" class="admin-form">
            <select name="duration">
              <option value="<%= premiumAccessDays %>" selected><%= premiumAccessDays %> days</option>
              <option value="7">7 days</option>
              <option value="90">90 days</option>
              <option value="custom">Custom</option>
            </select>
            <input type="date" name="expiry" class="custom-date" disabled>
            <button type="submit" class="button small success">Extend</button>
          </form>
          <form method="post" action="/admin/users/<%= u.id %>/revoke" data-email="<%= u.email %>" onsubmit="return confirmRevoke(this)">
            <button type="submit" class="button small danger">Revoke</button>
          </form>
        <% } else if (st === 'expired') { %>
          <form method="post" action="/admin/users/<%= u.id %>/reactivate" class="admin-form">
            <select name="duration">
              <option value="7">7 days</option>
              <option value="<%= premiumAccessDays %>" selected><%= premiumAccessDays %> days</option>
              <option value="90">90 days</option>
              <option value="custom">Custom</option>
            </select>
            <input type="date" name="expiry" class="custom-date" disabled>
            <button type="submit" class="button small success">Activate</button>
          </form>
        <% } else if (st === 'revoked') { %>
          <form method="post" action="/admin/users/<%= u.id %>/reactivate" class="admin-form">
            <select name="duration">
              <option value="7">7 days</option>
              <option value="<%= premiumAccessDays %>" selected><%= premiumAccessDays %> days</option>
              <option value="90">90 days</option>
              <option value="custom">Custom</option>
            </select>
            <input type="date" name="expiry" class="custom-date" disabled>
            <button type="submit" class="button small success">Activate</button>
          </form>
        <% } %>
      </td>
      <td>
        <% if (isOwnerRow) { %>
          <span class="muted">OWNER</span>
        <% } else if (isAdminRow) { %>
          <% if (typeof isOwner !== 'undefined' && isOwner) { %>
            <form method="post" action="/admin/users/<%= u.id %>/remove-admin" style="display:inline">
              <button type="submit" class="button small danger">Remove Admin</button>
            </form>
          <% } else { %>
            <span class="muted">ADMIN</span>
          <% } %>
        <% } else if (role === 'PREMIUM') { %>
          <% if (typeof user !== 'undefined' && user && u.id !== user.id && typeof isAdminUser === 'function' && isAdminUser(user)) { %>
            <form method="post" action="/admin/users/<%= u.id %>/remove-premium" style="display:inline">
              <button type="submit" class="button small danger">Remove Premium</button>
            </form>
          <% } else { %>
            <span class="muted">PREMIUM</span>
          <% } %>
        <% } else { %>
          <% if (typeof user !== 'undefined' && user && u.id !== user.id && typeof isAdminUser === 'function' && isAdminUser(user)) { %>
            <div style="display:flex; gap: 4px; flex-wrap: wrap;">
              <form method="post" action="/admin/users/<%= u.id %>/make-premium" style="display:inline">
                <button type="submit" class="button small success" style="background:#ecfdf5; border-color:#a7f3d0; color:#047857;">Make Premium</button>
              </form>
              <% if (typeof isOwner !== 'undefined' && isOwner) { %>
                <form method="post" action="/admin/users/<%= u.id %>/make-admin" style="display:inline">
                  <button type="submit" class="button small admin">Make Admin</button>
                </form>
              <% } %>
            </div>
          <% } else { %>
            <span class="muted">—</span>
          <% } %>
        <% } %>
      
        <% if (locals.localDeleteEnabled && u.id !== user.id && u.app_role !== 'OWNER' && u.app_role !== 'ADMIN') { %>
          <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Are you sure you want to completely delete this user and all their records? This is irreversible.')">
            <button type="submit" class="button small danger" style="background:#dc2626; border-color:#dc2626">Delete User</button>
          </form>
        <% } %>
</td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% if (typeof isOwner !== 'undefined' && isOwner) { %>
<h2>Content Permissions</h2>
<p class="muted">Owner-only: grant Copy Query and Download PDF to specific USER accounts without changing their role. Select users, set desired permissions, then save.</p>
<form id="bulkContentPermissionsForm" method="post" action="/admin/content-permissions/bulk">
<table class="admin-table">
  <thead><tr><th><input type="checkbox" id="cp-select-all" title="Select all"></th><th>User</th><th>Email</th><th>Copy Query</th><th>Download PDF</th></tr></thead>
  <tbody>
  <% users.forEach(u => {
    const role = (typeof getUserRole === 'function' ? getUserRole(u) : (u.app_role || 'USER'));
    const isOwnerRow = role === 'OWNER';
    if (isOwnerRow) return;
    const perms = (typeof contentPermissionsMap !== 'undefined' && contentPermissionsMap ? contentPermissionsMap.get(Number(u.id)) : null) || new Set();
    const hasCopy = perms.has('COPY_QUERY');
    const hasDownload = perms.has('DOWNLOAD_PDF');
  %>
    <tr>
      <td><input type="checkbox" name="user_ids" value="<%= u.id %>" class="cp-select"></td>
      <td><%= u.name || '—' %></td>
      <td><%= u.email %></td>
      <td>
        <span class="badge <%= hasCopy ? 'badge-active' : 'badge-neutral' %>"><%= hasCopy ? 'GRANTED' : 'DENIED' %></span>
        <label style="margin-left:8px;font-size:13px;display:inline-flex;align-items:center;gap:4px;white-space:nowrap">
          <input type="checkbox" class="cp-copy" name="copy_<%= u.id %>" value="1" <%= hasCopy ? 'checked' : '' %>>
          Allow
        </label>
      </td>
      <td>
        <span class="badge <%= hasDownload ? 'badge-active' : 'badge-neutral' %>"><%= hasDownload ? 'GRANTED' : 'DENIED' %></span>
        <label style="margin-left:8px;font-size:13px;display:inline-flex;align-items:center;gap:4px;white-space:nowrap">
          <input type="checkbox" class="cp-download" name="download_<%= u.id %>" value="1" <%= hasDownload ? 'checked' : '' %>>
          Allow
        </label>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<div style="margin-top:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
  <button type="submit" class="button small">Save Changes</button>
  <span id="cp-selected-count" class="muted" style="font-size:13px"></span>
</div>
</form>
<% } %>

</main>
<%- include('partials/footer') %>
<script>
function confirmRevoke(form) {
  return window.confirm('Revoke access for ' + form.dataset.email + '?');
}
document.addEventListener('change', function (e) {
  var select = e.target && e.target.closest && e.target.closest('select[name="duration"]');
  if (!select) return;
  var date = select.closest('form').querySelector('input[name="expiry"]');
  date.disabled = select.value !== 'custom';
  if (select.value === 'custom') date.focus();
});
(function() {
  var selectAll = document.getElementById('cp-select-all');
  var form = document.getElementById('bulkContentPermissionsForm');
  if (!selectAll || !form) return;
  var countEl = document.getElementById('cp-selected-count');
  function updateCount() {
    var n = form.querySelectorAll('.cp-select:checked').length;
    if (countEl) countEl.textContent = n ? n + ' user' + (n !== 1 ? 's' : '') + ' selected' : '';
  }
  selectAll.addEventListener('change', function() {
    var checks = form.querySelectorAll('.cp-select');
    for (var i = 0; i < checks.length; i++) checks[i].checked = selectAll.checked;
    updateCount();
  });
  form.addEventListener('change', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('cp-select')) {
      var all = form.querySelectorAll('.cp-select');
      var checked = form.querySelectorAll('.cp-select:checked');
      selectAll.checked = all.length > 0 && checked.length === all.length;
      selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
      updateCount();
    }
  });
  form.addEventListener('submit', function(e) {
    var selected = form.querySelectorAll('.cp-select:checked');
    if (selected.length === 0) {
      e.preventDefault();
      alert('Select at least one user.');
      return false;
    }
  });
  updateCount();
})();
(function(){
  var selectAll = document.getElementById('select-all-users');
  var countEl = document.getElementById('selected-count');
  var bulkExpiry = document.getElementById('bulk-expiry');
  var activateForm = document.getElementById('bulk-activate-form');
  var extendForm = document.getElementById('bulk-extend-form');
  var revokeForm = document.getElementById('bulk-revoke-form');
  var premiumForm = document.getElementById('bulk-premium-form');
  var activateExpiry = document.getElementById('bulk-activate-expiry');
  var extendExpiry = document.getElementById('bulk-extend-expiry');
  function getBoxes(){ return document.querySelectorAll('.user-checkbox'); }
  function getChecked(){ return document.querySelectorAll('.user-checkbox:checked'); }
  function updateBulkCount(){
    var n = getChecked().length;
    if(countEl) countEl.textContent = n + ' selected';
    if(selectAll){
      var boxes = getBoxes();
      if(n===boxes.length && n>0){ selectAll.checked=true; selectAll.indeterminate=false; }
      else if(n===0){ selectAll.checked=false; selectAll.indeterminate=false; }
      else { selectAll.checked=false; selectAll.indeterminate=true; }
    }
  }
  if(selectAll){
    selectAll.addEventListener('change', function(){
      var checked = this.checked;
      var boxes = getBoxes();
      for(var i=0;i<boxes.length;i++) boxes[i].checked=checked;
      updateBulkCount();
    });
  }
  document.addEventListener('change', function(e){
    if(e.target && e.target.classList && e.target.classList.contains('user-checkbox')) updateBulkCount();
  });
  updateBulkCount();
  try{
    var tomorrow = new Date(Date.now()+86400000);
    var iso = tomorrow.toISOString().slice(0,10);
    if(bulkExpiry) bulkExpiry.min = iso;
    document.querySelectorAll('input[type="date"]').forEach(function(inp){ if(!inp.min) inp.min = iso; });
  }catch{}
  function injectIds(form){
    form.querySelectorAll('input[name="userIds"]').forEach(function(el){ el.remove(); });
    var checked = getChecked();
    for(var i=0;i<checked.length;i++){
      var inp=document.createElement('input');
      inp.type='hidden'; inp.name='userIds'; inp.value=checked[i].value;
      form.appendChild(inp);
    }
    return checked.length;
  }
  if(activateForm){
    activateForm.addEventListener('submit', function(e){
      var n = injectIds(activateForm);
      if(n===0){ e.preventDefault(); alert('Select at least one user.'); return; }
      var val = bulkExpiry ? bulkExpiry.value : '';
      if(!val){ e.preventDefault(); alert('Select an Access Until date for Activate.'); return; }
      var chosen = new Date(val+'T23:59:59.999Z');
      if(isNaN(chosen.getTime()) || chosen.getTime()<=Date.now()){ e.preventDefault(); alert('Expiry date must be in the future.'); return; }
      if(activateExpiry) activateExpiry.value = val;
      var label = ''; try{ label = new Date(val+'T23:59:59.999Z').toLocaleDateString(undefined,{timeZone:'Asia/Kolkata'});}catch{ label=val; }
      if(!confirm('Activate ' + n + ' selected user(s) until ' + label + '?')){ e.preventDefault(); return; }
    });
  }
  if(extendForm){
    extendForm.addEventListener('submit', function(e){
      var n = injectIds(extendForm);
      if(n===0){ e.preventDefault(); alert('Select at least one user.'); return; }
      var val = bulkExpiry ? bulkExpiry.value : '';
      if(!val){ e.preventDefault(); alert('Select an Access Until date for Extend.'); return; }
      var chosen = new Date(val+'T23:59:59.999Z');
      if(isNaN(chosen.getTime()) || chosen.getTime()<=Date.now()){ e.preventDefault(); alert('Expiry date must be in the future.'); return; }
      if(extendExpiry) extendExpiry.value = val;
      var label = ''; try{ label = new Date(val+'T23:59:59.999Z').toLocaleDateString(undefined,{timeZone:'Asia/Kolkata'});}catch{ label=val; }
      if(!confirm('Extend access for ' + n + ' selected user(s) until ' + label + '?')){ e.preventDefault(); return; }
    });
  }
  if(revokeForm){
    revokeForm.addEventListener('submit', function(e){
      var n = injectIds(revokeForm);
      if(n===0){ e.preventDefault(); alert('Select at least one user.'); return; }
      if(!confirm('Revoke access for ' + n + ' selected user(s)? This will set their status to Revoked.')){ e.preventDefault(); return; }
    });
  }
  if(premiumForm){
    premiumForm.addEventListener('submit', function(e){
      var n = injectIds(premiumForm);
      if(n===0){ e.preventDefault(); alert('Select at least one user.'); return; }
      if(!confirm('Grant PREMIUM role to ' + n + ' selected user(s)? This will set premium_source to manual and will not create payment entitlement.')){ e.preventDefault(); return; }
    });
  }
})();
</body></html>