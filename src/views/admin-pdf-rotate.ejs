<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rotate PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Rotate PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Rotate all pages or selected pages of a local PDF and download a <strong>new</strong> file. Rotation is structural — page content is never re-rendered. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfRotateAvailable !== 'undefined' ? !!pdfRotateAvailable : false; %>
<% const _maxMb = (typeof pdfRotateMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfRotateMaxFileMb)) && Number(pdfRotateMaxFileMb) >= 1) ? Math.floor(Number(pdfRotateMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-rotate-disabled">PDF rotate is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-rotate-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfRotatePick" data-testid="pdf-rotate-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfRotateFile" data-testid="pdf-rotate-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <label style="font-size:13px;">Angle
      <select id="pdfRotateAngle" data-testid="pdf-rotate-angle" <%= _available ? '' : 'disabled' %>>
        <option value="90" selected>90° clockwise</option>
        <option value="180">180°</option>
        <option value="270">270° clockwise</option>
        <option value="-90">90° counter-clockwise</option>
      </select>
    </label>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfRotateFileInfo" data-testid="pdf-rotate-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Pages to rotate</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfRotateScope" value="all" data-testid="pdf-rotate-scope-all" checked <%= _available ? '' : 'disabled' %>>
      All pages
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfRotateScope" value="range" data-testid="pdf-rotate-scope-range" <%= _available ? '' : 'disabled' %>>
      Selected pages
      <input type="text" id="pdfRotateSelection" data-testid="pdf-rotate-selection" placeholder="e.g. 1-3,5" autocomplete="off" spellcheck="false" style="width:200px;margin-left:8px;" <%= _available ? '' : 'disabled' %>>
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfRotateBtn" data-testid="pdf-rotate-submit" <%= _available ? '' : 'disabled' %>>⟳ Rotate &amp; download</button>
    <button type="button" class="button small secondary" id="pdfRotateClear" data-testid="pdf-rotate-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfRotateProgress" data-testid="pdf-rotate-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Rotating… <span id="pdfRotateProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-rotate-status" id="pdfRotateStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-rotate-result" id="pdfRotateResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-rotate.js?v=<%= Date.now() %>"></script>
</body></html>
