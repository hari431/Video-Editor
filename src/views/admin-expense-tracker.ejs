let pendingSalaryImport=null;
const salaryImportNote='Imported from Expense Tracker - 2026 workbook';
function parseSalaryWorkbook(workbook){
 const result=[];const skipped=[];const monthMap={'jan':'01','january':'01','feb':'02','february':'02','mar':'03','march':'03','apr':'04','april':'04','may':'05','jun':'06','june':'06','jul':'07','july':'07','aug':'08','august':'08','sep':'09','sept':'09','september':'09','oct':'10','october':'10','nov':'11','november':'11','dec':'12','december':'12'};
 for(const sheetName of workbook.SheetNames){
  const match=sheetName.match(/^([A-Za-z]+)[ -]+(20\d{2})$/);if(!match){skipped.push(sheetName+': unrecognized month tab format');continue}
  const monthNum=monthMap[match[1].toLowerCase()];if(!monthNum){skipped.push(sheetName+': unrecognized month name');continue}
  const month=match[2]+'-'+monthNum;const sheet=workbook.Sheets[sheetName];if(!sheet){skipped.push(sheetName+': missing sheet');continue}
  const rows=XLSX.utils.sheet_to_json(sheet,{header:1,raw:true,defval:null});
  const headerIndex=rows.findIndex(row => row && row.some(v => /my salary/i.test(String(v || '')) ) && row.some(v => /chandu salary/i.test(String(v || ''))));
  if(headerIndex<0){skipped.push(sheetName+': salary columns not found');continue}
  const headers=rows[headerIndex].map(v=>String(v||'').trim().toLowerCase());
  const youCol=headers.findIndex(v=>v==='my salary'),chanduCol=headers.findIndex(v=>v==='chandu salary');
  let salaryFound=false;
  for(let i=headerIndex+1;i<rows.length;i++){
   const row=rows[i]||[];const description=String(row[0]??'').replace(/\s+/g,' ').trim();if(!description)continue;
   if(/^(remaining money|total|opening balance|closing balance|total salary|total savings|total expenses)$/i.test(description)){
    skipped.push(sheetName+': excluded summary row ('+description+')');continue;
   }
   for(const [person,col] of [['You',youCol],['Chandu',chanduCol]]){
    if(col<0)continue;
    const cellRef=XLSX.utils.encode_cell({c:col,r:i});const cell=sheet[cellRef];if(!cell)continue;
    let rawVal=cell.v;if(rawVal===null||rawVal===undefined)continue;
    let val=null;
    if(typeof rawVal==='number'){val=rawVal}
    else if(typeof rawVal==='string'){const cleaned=rawVal.replace(/[₹$€£,\s]/g,'');const parsedNum=Number(cleaned);if(!isNaN(parsedNum)&&cleaned!=='')val=parsedNum}
    if(val===null||!Number.isFinite(val)||val===0)continue;
    if(/^salary$/i.test(description)){
     if(val>0){result.push({month,person,type:'income',description:'Salary',amount:Math.round(val),note:salaryImportNote});salaryFound=true}
     else skipped.push(sheetName+': negative salary value for '+person+' was skipped');
    }else if(val<0){
     result.push({month,person,type:'expenses',description,amount:Math.round(Math.abs(val)),note:salaryImportNote});
    }else if(val>0){
     if(/kite|broker/i.test(description)){
      result.push({month,person,type:'brokerFunds',description,amount:Math.round(val),note:salaryImportNote});
     }else{
      skipped.push(sheetName+': positive non-salary value for '+description+' ('+person+') was skipped');
     }
    }
   }
  }
  if(!salaryFound)skipped.push(sheetName+': no positive salary values found');
 }
 return {rows:result,skipped};
}
$('previewSalaryWorkbook').addEventListener('click',async()=>{try{
 const file=$('salaryWorkbook').files?.[0];if(!file)throw Error('Choose the monthly Expense Tracker workbook first.');
 if(file.size>5*1024*1024)throw Error('Please choose a workbook under 5 MB.');
 if(!window.XLSX)throw Error('Excel reader could not load. Check your internet connection and refresh.');
 const workbook=XLSX.read(await file.arrayBuffer(),{type:'array'});const parsed=parseSalaryWorkbook(workbook);
 if(!parsed.rows.length)throw Error('No salary, expense, or broker fund rows were recognized.');
 pendingSalaryImport=parsed.rows;
 const counts={income:parsed.rows.filter(r=>r.type==='income').length,expenses:parsed.rows.filter(r=>r.type==='expenses').length,brokerFunds:parsed.rows.filter(r=>r.type==='brokerFunds').length};
