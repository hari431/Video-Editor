<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Local Expense Tracker</title><link rel="stylesheet" href="/styles.css">
<style>
.et-wrap{max-width:1200px;margin:28px auto;padding:0 18px 48px}.et-hero{padding:24px;border-radius:20px;color:#fff;background:linear-gradient(125deg,#4338ca 0%,#7c3aed 48%,#db2777 100%);box-shadow:0 12px 30px #4338ca24}.et-hero h1{margin:0 0 8px;font-size:clamp(26px,4vw,36px)}.et-hero p{margin:0;color:#f5f3ff}.et-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin:16px 0}.et-metric{border:1px solid #e0e7ff;border-radius:16px;padding:16px;background:linear-gradient(145deg,#fff,#f5f3ff);box-shadow:0 5px 16px #4338ca0b}.et-metric:nth-child(2){background:linear-gradient(145deg,#fff,#ecfdf5);border-color:#bbf7d0}.et-metric:nth-child(3){background:linear-gradient(145deg,#fff,#fff7ed);border-color:#fed7aa}.et-metric:nth-child(4){background:linear-gradient(145deg,#fff,#fdf2f8);border-color:#fbcfe8}.et-metric span{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#64748b;font-weight:700}.et-metric strong{display:block;margin-top:7px;font-size:24px;color:#172554}.et-card{border:1px solid #e2e8f0;border-radius:16px;padding:18px;background:#fff;margin:16px 0;box-shadow:0 7px 22px #0f172a08;min-width:0}.et-card h2{margin-top:0;color:#312e81}.et-row{display:flex;gap:10px;flex-wrap:wrap;align-items:end}.et-row label{display:flex;flex-direction:column;gap:5px;flex:1;min-width:130px}.et-wrap input,.et-wrap select,.et-wrap textarea{width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:9px;background:#fff}.et-wrap button{cursor:pointer;border:1px solid #c4b5fd;border-radius:9px;padding:9px 13px;background:#f5f3ff;color:#4338ca;font-weight:650}.et-wrap button:hover{background:#ede9fe}.et-wrap button:disabled{opacity:.5;cursor:not-allowed}.et-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.et-tabs button{padding:10px 14px;background:#fff;border-color:#dbeafe;color:#334155}.et-tabs button.active{color:#fff;background:linear-gradient(120deg,#4f46e5,#9333ea);border-color:transparent;box-shadow:0 5px 12px #4f46e533}.et-list{width:100%;border-collapse:collapse;font-size:13px}.et-list th,.et-list td{padding:10px 9px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:top}.et-list th{background:#f5f3ff;color:#4338ca;white-space:nowrap}.et-list tr:hover td{background:#fafaff}.et-table-wrap{overflow-x:auto;border:1px solid #e2e8f0;border-radius:10px}.et-note{font-size:13px;color:#64748b}.et-danger{color:#991b1b}.et-status{margin:14px 0;padding:12px 14px;border-radius:10px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af}.et-status.et-danger{background:#fff1f2;border-color:#fecdd3;color:#9f1239}.et-panel[hidden]{display:none}.et-pill{display:inline-block;padding:4px 9px;border-radius:999px;background:#ede9fe;color:#5b21b6;font-size:12px;font-weight:700}.et-positive{color:#047857;font-weight:700}.et-negative{color:#be123c;font-weight:700}.et-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.et-cta{background:linear-gradient(120deg,#4f46e5,#9333ea)!important;color:white!important;border:0!important}.et-empty{padding:18px;text-align:center;color:#64748b;background:#f8fafc;border-radius:10px}
</style></head>
<body><header class="topbar"><a class="brand" href="/admin">Admin Home</a><div class="user"><form method="post" action="/admin/expense-tracker/lock"><button type="submit">Lock Tracker</button></form></div></header>
<main class="et-wrap">
<h1>Local Expense Tracker</h1><p class="et-note">Development-only private workspace. Data is stored in an ignored local JSON file, not the application database. Never use on production or expose this development server to a network.</p>
<div id="status" class="et-status" role="status">Loading local data…</div>
<div class="et-tabs" role="tablist"><button class="active" data-tab="monthly">💸 Monthly expenses</button><button data-tab="templates">📋 Recurring templates</button><button data-tab="banks">🏦 Bank balances</button><button data-tab="stocks">📈 Stocks</button><button data-tab="mutualFunds">🌱 Mutual funds</button><button data-tab="settings">⚙️ Settings</button></div>
<section class="et-panel" id="monthly">
<div class="et-card" style="background:#f8fafc;border-color:#cbd5e1;margin-bottom:16px">
  <div class="et-row" style="align-items:center;justify-content:space-between">
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <label style="font-weight:700;color:#1e293b;min-width:auto;display:flex;align-items:center;gap:8px">📅 Selected Month:
        <input id="month" type="month" required style="width:auto;padding:8px 12px;font-size:15px;font-weight:600;border-radius:8px;border:1px solid #cbd5e1">
      </label>
      <button id="prevMonth" type="button" style="padding:7px 12px">← Prev</button>
      <button id="nextMonth" type="button" style="padding:7px 12px">Next →</button>
      <button id="todayMonth" type="button" style="padding:7px 12px">Current Month</button>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <button id="btnResetFutureMonth" type="button" class="et-danger" style="border-color:#fecaca;background:#fff1f2;color:#b91c1c;padding:6px 12px;font-size:13px" hidden>🔄 Reset Month</button>
      <div id="monthLockBadge"></div>
    </div>
  </div>
</div>
<div id="newMonthSetupCard" class="et-card" style="background:#f0fdf4;border-color:#bbf7d0" hidden>
  <div class="et-section-title">
    <div>
      <h2 style="color:#166534;margin-bottom:4px">✨ Set up new month</h2>
      <p class="et-note" style="color:#15803d">No transactions recorded for this month yet. Choose an option below to pre-fill transactions, or add entries manually.</p>
    </div>
  </div>
  <div class="et-row" style="margin-top:10px;gap:12px">
    <button id="btnStartFromTemplate" type="button" class="et-cta">📋 Start from templates</button>
    <button id="btnCopyPrevMonth" type="button" style="background:#fff;border:1px solid #16a34a;color:#15803d;font-weight:600">📄 Copy previous month (<span id="prevMonthName"></span>)</button>
  </div>
</div>
<div id="peopleView">
  <div class="et-section-title"><div><h2>People</h2><p class="et-note">Choose a person to open their personal income and expense ledger.</p></div><button id="addPerson" class="et-cta">+ Add a person</button></div>
  <div id="peopleCards" class="et-grid"></div>
</div>
<div id="ledgerView" hidden>
<div class="et-section-title"><div><button id="backToPeople">← Back to people</button><h2 id="ledgerTitle">Monthly income / expenses</h2></div></div>
<div id="historicalLockBanner" class="et-status" style="background:#fffbebf0;border-color:#fde68a;color:#92400e;margin-bottom:14px" hidden>🔒 Historical month is read-only. Entries, amounts, and statuses cannot be modified.</div>
<div class="et-card" id="salaryWorkbookMigration">
<h2>Import monthly salary and expenses</h2>
<p class="et-note">Import salary and negative expense values from your monthly Expense Tracker workbook. Bank remaining balances and summary totals are excluded. Review the preview before saving.</p>
<label>Choose Expense Tracker workbook (.xlsx)<input id="salaryWorkbook" type="file" accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"></label>
<div class="et-row" style="margin-top:10px"><button id="previewSalaryWorkbook">Preview workbook</button><button id="confirmSalaryWorkbook" disabled>Confirm and import</button></div>
<div id="salaryWorkbookPreview"></div>
</div>
<div id="monthlyAnalytics" class="et-card">
<div class="et-grid" style="margin-top:0">
<div class="et-metric"><span>Incoming</span><strong id="analyticsIncome">₹0</strong><small>Money received this month</small></div>
<div class="et-metric"><span>Outgoing</span><strong id="analyticsExpenses">₹0</strong><small>Money spent this month</small></div>
<div class="et-metric"><span>Net remaining</span><strong id="analyticsNet">₹0</strong><small>Incoming minus outgoing</small></div>
</div>
<div class="et-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
<div class="et-card" style="margin:0"><h3>Incoming vs outgoing</h3><div id="incomeExpenseChart" role="img" aria-label="Bar chart comparing incoming and outgoing amounts"></div></div>
<div class="et-card" style="margin:0"><h3>Spending breakdown</h3><div id="expenseDonutChart" role="img" aria-label="Donut chart grouping expenses by description"></div></div>
</div>
</div>
<div class="et-card" id="addEntryCard"><h2>Add new transaction</h2><div class="et-row"><label>Entry type<select id="entryType"><option value="income">Income / salary</option><option value="expenses">Expense</option></select></label><label>Description<input id="description" maxlength="160" placeholder="Salary, rent, groceries"></label><label>Amount (₹)<input id="amount" type="number" min="0" step=".01"></label><label>Status<select id="entryStatus"><option value="Pending">Pending</option><option value="Received">Received</option><option value="Paid">Paid</option><option value="Invested">Invested</option><option value="Transferred">Transferred</option><option value="Unknown">Unknown</option></select></label><label>Note<input id="entryNote" maxlength="250"></label></div>
<div class="et-row" style="margin-top:10px;align-items:center"><label style="flex:1;flex-direction:row;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" id="saveToTemplate" style="width:auto"> Save description as recurring template</label><button id="addEntry" class="et-cta">Add entry</button></div></div>
<div class="et-card"><h2>Entries for selected month</h2><div id="monthlySummary"></div><div id="entries"></div></div>
</div>
</section>
<section class="et-panel" id="templates" hidden>
<div class="et-card">
  <h2>📋 Recurring Description Templates</h2>
  <p class="et-note">Templates pre-fill transaction descriptions when opening a new month. Editing templates affects future months only.</p>
  <div class="et-row">
    <label>Description<input id="tplDesc" maxlength="160" placeholder="e.g. Salary, House Rent, Tax"></label>
    <label>Type<select id="tplType"><option value="expenses">Expense</option><option value="income">Income / salary</option><option value="brokerFunds">Broker funds</option></select></label>
    <label>Category<input id="tplCategory" maxlength="120" placeholder="Rent, Investments, Other"></label>
    <label>Person<select id="tplPerson"></select></label>
    <button id="addTemplate" class="et-cta">+ Add template</button>
  </div>
  <div id="templatesList" style="margin-top:16px"></div>
</div>
</section>
<section class="et-panel" id="banks" hidden><div class="et-card"><h2>Bank balances</h2><div class="et-row"><label>Account name<input id="bankAccount" maxlength="80" placeholder="Savings account"></label><label>Opening balance (₹)<input id="bankOpening" type="number" min="0" step=".01"></label><label>Closing balance (₹)<input id="bankClosing" type="number" min="0" step=".01"></label><label>Note<input id="bankNote" maxlength="250"></label><button id="saveBank">Save balance</button></div><p class="et-note">Opening is the start-of-month balance; closing is the end-of-month balance. Each month is stored separately.</p><div id="banksList"></div></div></section>
<section class="et-panel" id="stocks" hidden><div class="et-card"><div class="et-section-title"><h2>📈 Stock portfolio</h2><span class="et-pill">Account-level performance</span></div><div id="stockSummary" class="et-grid"></div><h3>Import stock holdings</h3><div class="et-row"><label>Source<select id="broker"><option>Zerodha</option><option>INDmoney</option></select></label><label>Report month<input id="importMonth" type="month"></label><label>Account label<input id="importAccount" list="accountsList" maxlength="100" placeholder="e.g. Zerodha - Account 1"><datalist id="accountsList"></datalist></label><label>Asset type<select id="assetType"><option value="auto">Auto-detect & split Zerodha holdings</option><option value="stock">Stocks only</option><option value="mutualFund">Mutual funds only</option></select></label></div><label>Upload Excel or CSV holdings<input id="csvFile" type="file" accept=".xls,.xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"></label><label>Or paste holdings CSV<textarea id="csv" rows="8" placeholder="Choose a .csv file above or paste its contents here. Zerodha mixed holdings are split into Stocks and Mutual funds during preview."></textarea></label><div class="et-row"><button id="previewImport">Preview CSV</button><button id="confirmImport" disabled>Confirm & save import</button></div><div id="importPreview"></div><p class="et-note">Upload Zerodha or INDmoney Excel statements (.xls/.xlsx) directly, or use CSV/paste. Excel files are read in your browser; the detected holdings sheet is converted for preview, and the original workbook is not uploaded. Zerodha mixed stock and mutual-fund rows are separated during preview. INDmoney selects HOLDINGS_BOOK when available. USD remains separate from INR; no currency conversion is applied. Preview first; nothing is saved until confirmation.</p><div id="stockHoldings"></div><div id="savedImports"></div></div></section>
<section class="et-panel" id="mutualFunds" hidden><div class="et-card"><div class="et-section-title"><h2>🌱 Mutual Fund Management</h2><span class="et-pill">Purpose stays with account + fund</span></div><p class="et-note">Import mutual funds from the Stocks tab by selecting Asset type → Mutual funds. Assign a purpose to each fund here; it is saved per account and retained when you import updated holdings.</p><div class="et-row"><label>Filter by account<select id="mfAccountFilter"><option value="">All accounts</option></select></label><button class="et-cta" id="saveFundPurposes">Save fund purposes</button></div><div id="mfHoldings"></div></div></section>
<section class="et-panel" id="settings" hidden><div class="et-card"><h2>Workspace settings</h2><div class="et-row"><label>Accounts (comma-separated)<input id="accountsSetting"></label><button id="saveSettings">Save settings</button></div><p class="et-note">Monthly entries use one household ledger. Categories are entered as free text when adding an entry.</p></div></section>
</main>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
(() => {
const $=id=>document.getElementById(id);
let data=null, pendingRows=null, loadFailed=false, selectedPerson=null;
let editingEntryKey=null, editingTemplateIndex=null;
const currentMonth=()=>new Date().toISOString().slice(0,7);
$('month').value=currentMonth(); $('importMonth').value=currentMonth();
const status=(s,bad=false)=>{$('status').textContent=s;$('status').classList.toggle('et-danger',bad)};
async function api(url,body){const r=await fetch(url,{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined,credentials:'same-origin'});const j=await r.json().catch(()=>({error:'Request failed'}));if(!r.ok)throw Error(j.error||'Request failed');return j}
function monthRecord(){data.months ||= {};return data.months[$('month').value] ||= {people:{},bankBalances:[],brokerFunds:[]}}
function personRecord(){const m=monthRecord();m.people ||= {};if(!selectedPerson)throw Error('Choose a person before adding an entry.');return m.people[selectedPerson] ||= {income:[],expenses:[]}}
function fillOptions(el,values,selected){el.replaceChildren(...values.map((v,i)=>{const o=document.createElement('option');o.value=v;o.textContent=v;if(v===selected||(!selected&&i===0))o.selected=true;return o}))}
function escape(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function money(v,currency='INR'){return new Intl.NumberFormat('en-IN',{style:'currency',currency:currency==='USD'?'USD':'INR',maximumFractionDigits:2}).format(Number(v||0))}

function getRollingCutoffMonth() {
  const d = new Date();
  let y = d.getFullYear();
  let m = d.getMonth() - 3;
  if (m < 0) { m += 12; y -= 1; }
  return y + '-' + String(m + 1).padStart(2, '0');
}

function isLockedMonth(mStr) {
  if (!mStr || typeof mStr !== 'string' || !/^\d{4}-(0[1-9]|1[0-2])$/.test(mStr)) return false;
  return mStr < getRollingCutoffMonth();
}

function isFutureMonth(mStr) {
  if (!mStr || typeof mStr !== 'string' || !/^\d{4}-(0[1-9]|1[0-2])$/.test(mStr)) return false;
  return mStr > currentMonth();
}

function getPrevMonthKey(mVal) {
  if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(mVal)) return null;
  const [yStr, mStr] = mVal.split('-');
  let y = Number(yStr), m = Number(mStr) - 1;
  if (m < 1) { m = 12; y -= 1; }
  return y + '-' + String(m).padStart(2, '0');
}

function prefillMonthFromTemplatesClient(monthKey) {
  data.months ||= {};
  const m = data.months[monthKey] ||= { people: {}, bankBalances: [], brokerFunds: [] };
  m.people ||= {};
  const templates = Array.isArray(data.templates) && data.templates.length ? data.templates : [];
  for (const tpl of templates) {
    const person = tpl.person && data.people.includes(tpl.person) ? tpl.person : (data.people[0] || 'You');
    m.people[person] ||= { income: [], expenses: [] };
    const p = m.people[person];
    if (tpl.type === 'brokerFunds') {
      m.brokerFunds ||= [];
      if (!m.brokerFunds.some(b => b.person === person && b.description === tpl.description)) {
        m.brokerFunds.push({ person, account: tpl.description, description: tpl.description, amount: 0, note: '', status: 'Pending' });
      }
    } else if (tpl.type === 'income' || tpl.type === 'expenses') {
      p[tpl.type] ||= [];
      if (!p[tpl.type].some(e => e.description === tpl.description)) {
        p[tpl.type].push({ description: tpl.description, category: tpl.category || 'Other', amount: 0, note: '', status: 'Pending' });
      }
    }
  }
}

function copyPreviousMonthClient(targetKey) {
  const prevKey = getPrevMonthKey(targetKey);
  if (!prevKey || !data.months?.[prevKey]) throw Error('Previous month (' + prevKey + ') has no recorded entries to copy.');
  const prevRecord = data.months[prevKey];
  data.months ||= {};
  const targetRecord = data.months[targetKey] ||= { people: {}, bankBalances: [], brokerFunds: [] };
  targetRecord.people ||= {};
  targetRecord.bankBalances ||= [];
  targetRecord.brokerFunds ||= [];

  let copiedCount = 0;
  for (const [person, p] of Object.entries(prevRecord.people || {})) {
    targetRecord.people[person] ||= { income: [], expenses: [] };
    const tp = targetRecord.people[person];
    tp.income ||= [];
    tp.expenses ||= [];

    for (const type of ['income', 'expenses']) {
      for (const entry of p[type] || []) {
        const exists = tp[type].some(e => e.description === entry.description && Number(e.amount) === Number(entry.amount));
        if (!exists) {
          tp[type].push({
            description: entry.description,
            category: entry.category || 'Other',
            amount: Number(entry.amount) || 0,
            note: entry.note || '',
            status: 'Pending'
          });
          copiedCount++;
        }
      }
    }
  }

  for (const broker of prevRecord.brokerFunds || []) {
    const exists = targetRecord.brokerFunds.some(b => b.person === broker.person && b.description === broker.description);
    if (!exists) {
      targetRecord.brokerFunds.push({
        person: broker.person || 'You',
        account: broker.account || broker.description,
        description: broker.description,
        amount: Number(broker.amount) || 0,
        note: broker.note || '',
        status: 'Pending'
      });
      copiedCount++;
    }
  }
  if (!copiedCount) throw Error('No new entries were copied (all transactions already exist in target month).');
}

function latestHoldings(assetType){
 const latestReports=new Map(), latestFunds=new Map();
 for(let ri=data.imports.length-1;ri>=0;ri--){
  const report=data.imports[ri];if((report.assetType||'stock')!==assetType)continue;
  if(assetType==='stock'){
   const grouped=new Map();for(let rj=0;rj<report.rows.length;rj++){const row=report.rows[rj],account=String(row.account||report.source).trim()||report.source;const key=account.toLowerCase();if(!grouped.has(key))grouped.set(key,[]);grouped.get(key).push({row,report,ri,rj,account})}
   for(const [key,items] of grouped)if(!latestReports.has(key))latestReports.set(key,items);
  }else{
   for(let rj=0;rj<report.rows.length;rj++){const row=report.rows[rj],account=String(row.account||report.source).trim()||report.source;const key=account.toLowerCase()+'\u0000'+String(row.isin||row.symbol).toLowerCase();if(!latestFunds.has(key))latestFunds.set(key,{row,report,ri,rj,account})}
  }
 }
 return assetType==='stock'?[...latestReports.values()].flat():[...latestFunds.values()];
}
function renderPeople(){
 const people=Array.isArray(data.people)?data.people:[];
 $('peopleCards').innerHTML=people.length?people.map(person=>{
  let income=0,expenses=0;const p=data.months?.[$('month').value]?.people?.[person]||{};
  for(const e of (p.income||[]))income+=Number(e.amount)||0;
  for(const e of (p.expenses||[]))expenses+=Number(e.amount)||0;
  return '<div class="et-card" style="background:#f5f3ff;border-color:#c4b5fd;min-height:150px"><strong style="display:block;font-size:20px;margin-bottom:14px">'+escape(person)+'</strong><span class="et-note">This month</span><div style="margin-top:10px;font-size:13px">Income: <b>'+money(income)+'</b></div><div style="font-size:13px">Expenses: <b>'+money(expenses)+'</b></div><div style="font-size:15px;margin-top:6px">Net: <b class="'+(income-expenses>=0?'et-positive':'et-negative')+'">'+money(income-expenses)+'</b></div><div class="et-row" style="margin-top:12px;align-items:center"><button data-person="'+escape(person)+'">Open ledger →</button><button data-delete-person="'+escape(person)+'" class="et-danger" style="border-color:#fecaca;background:#fff1f2;color:#b91c1c">Delete</button></div></div>';
 }).join(''):'<div class="et-empty">No people added yet. Select “Add a person” to create the first person.</div>';
 $('peopleView').hidden=!!selectedPerson;$('ledgerView').hidden=!selectedPerson;
 if(selectedPerson)$('ledgerTitle').textContent=selectedPerson+' — Monthly ledger';
}
function openPerson(person){selectedPerson=person;render();$('peopleView').hidden=true;$('ledgerView').hidden=false;}
const STATUS_OPTIONS = ['Unknown', 'Pending', 'Received', 'Paid', 'Invested', 'Transferred'];

function renderTemplates(){
 const tpls = Array.isArray(data.templates) ? data.templates : [];
 fillOptions($('tplPerson'), data.people, 'You');
 $('templatesList').innerHTML = tpls.length ? '<div class="et-table-wrap"><table class="et-list"><thead><tr><th>Description</th><th>Type</th><th>Category</th><th>Person</th><th>Actions</th></tr></thead><tbody>'+tpls.map((t,i)=>{
  if (editingTemplateIndex === i) {
    return '<tr>'+
      '<td><input id="editTplDesc" value="'+escape(t.description)+'" style="padding:4px 6px"></td>'+
      '<td><select id="editTplType"><option value="expenses" '+(t.type==='expenses'?'selected':'')+'>expenses</option><option value="income" '+(t.type==='income'?'selected':'')+'>income</option><option value="brokerFunds" '+(t.type==='brokerFunds'?'selected':'')+'>brokerFunds</option></select></td>'+
      '<td><input id="editTplCategory" value="'+escape(t.category)+'" style="padding:4px 6px"></td>'+
      '<td><select id="editTplPerson">'+data.people.map(p=>'<option value="'+escape(p)+'" '+(p===t.person?'selected':'')+'>'+escape(p)+'</option>').join('')+'</select></td>'+
      '<td><button id="saveTplBtn" class="et-cta" style="padding:4px 8px;font-size:12px">Save</button> <button id="cancelTplBtn" style="padding:4px 8px;font-size:12px">Cancel</button></td>'+
      '</tr>';
  }
