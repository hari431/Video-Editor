 status('Workbook preview ready. No data saved yet.');
}catch(e){pendingSalaryImport=null;$('confirmSalaryWorkbook').disabled=true;status(e.message,true)}});
$('confirmSalaryWorkbook').addEventListener('click',async()=>{if(!pendingSalaryImport)return;const previous=JSON.parse(JSON.stringify(data));try{
 const seen=new Set();let added=0,duplicates=0;
 for(const row of pendingSalaryImport){
  const key=[row.month,row.person,row.type,row.description,row.amount,row.note].join('|');
  if(row.type==='brokerFunds'){
   data.months ||= {};data.months[row.month] ||= {people:{},bankBalances:[],brokerFunds:[]};
   const m=data.months[row.month];m.brokerFunds ||= [];
   const existing=m.brokerFunds.some(b=>b.person===row.person&&(b.account===row.description||b.description===row.description)&&Number(b.amount)===row.amount);
   if(existing||seen.has(key)){duplicates++;continue}seen.add(key);
   m.brokerFunds.push({person:row.person,account:row.description,description:row.description,amount:row.amount,note:salaryImportNote});added++;
  }else{
   const existing=data.months?.[row.month]?.people?.[row.person]?.[row.type]||[];
   if(existing.some(e=>e.description===row.description&&Number(e.amount)===row.amount&&String(e.note||'')===salaryImportNote)){duplicates++;continue}
   if(seen.has(key)){duplicates++;continue}seen.add(key);
   data.months ||= {};data.months[row.month] ||= {people:{},bankBalances:[],brokerFunds:[]};const m=data.months[row.month];m.people ||= {};m.people[row.person] ||= {income:[],expenses:[]};m.people[row.person][row.type] ||= [];m.people[row.person][row.type].push({description:row.description,amount:row.amount,note:salaryImportNote});added++;
  }
 }
 if(!data.people.includes('You'))data.people.push('You');if(!data.people.includes('Chandu'))data.people.push('Chandu');
 await save();status('Workbook import complete: '+added+' added, '+duplicates+' duplicates skipped.');pendingSalaryImport=null;$('confirmSalaryWorkbook').disabled=true;$('salaryWorkbookPreview').innerHTML='<p><b>Import complete.</b> '+added+' entries added; '+duplicates+' duplicates skipped.</p>';
 }catch(e){data=previous;render();status('Import was not saved: '+e.message,true)}});
$('csvFile').addEventListener('change',async()=>{try{const file=$('csvFile').files?.[0];if(!file)return;if(file.size>2*1024*1024)throw Error('Please keep the statement under 2 MB.');let csv;if(/\.csv$/i.test(file.name)){csv=await file.text()}else{if(!window.XLSX)throw Error('Excel reader could not load. Check your internet connection and refresh the page.');const workbook=XLSX.read(await file.arrayBuffer(),{type:'array'});const preferred=workbook.SheetNames.find(n=>/^HOLDINGS_BOOK$/i.test(n));const candidate=preferred||workbook.SheetNames.find(n=>{const rows=XLSX.utils.sheet_to_json(workbook.Sheets[n],{header:1,raw:false,blankrows:false});return rows.some(row=>{const h=row.map(v=>String(v??'').toLowerCase().replace(/[^a-z0-9]/g,''));return h.some(v=>['instrument','stocksymbol','tradingsymbol','schemename','fundname'].includes(v))&&h.some(v=>['quantity','qty','units','totalquantity'].includes(v))})})||workbook.SheetNames[0];if(!candidate)throw Error('No worksheet found in this workbook.');csv=XLSX.utils.sheet_to_csv(workbook.Sheets[candidate]);$('importPreview').textContent='Excel worksheet selected: '+candidate+' ('+workbook.SheetNames.length+' sheet(s)).'}if(csv.length>1024*1024)throw Error('Converted holdings data exceeds 1 MB.');$('csv').value=csv;pendingRows=null;$('confirmImport').disabled=true;if(/\.csv$/i.test(file.name))$('importPreview').textContent='CSV loaded: '+file.name;status('Statement loaded. Select Preview CSV to review the holdings.')}catch(e){$('csvFile').value='';status(e.message,true)}});
$('addPerson').addEventListener('click',async()=>{const name=window.prompt('Enter person name:');if(name===null)return;const clean=name.replace(/[\u0000-\u001f\u007f]/g,'').trim().slice(0,120);if(!clean){status('Enter a person name.',true);return}if(data.people.some(p=>p.toLocaleLowerCase()===clean.toLocaleLowerCase())){status('A person with that name already exists.',true);return}if(data.people.length>=20){status('The tracker supports up to 20 people.',true);return}try{data.people.push(clean);data.months ||= {};await save();openPerson(clean)}catch(e){data.people=data.people.filter(p=>p!==clean);status(e.message,true)}});
$('peopleCards').addEventListener('click',async e=>{const remove=e.target.closest('[data-delete-person]');if(remove){const person=remove.dataset.deletePerson;const hasEntries=Object.values(data.months||{}).some(month=>{const ledger=month?.people?.[person];return ['income','expenses'].some(type=>Array.isArray(ledger?.[type])&&ledger[type].length>0)});if(hasEntries){status('Cannot delete '+person+' because they have income or expense entries. Their financial history is protected.',true);return}if(!window.confirm('Delete '+person+'? This is allowed only because they have no income or expense entries.'))return;const oldPeople=data.people.slice();const oldMonths=JSON.parse(JSON.stringify(data.months||{}));try{data.people=data.people.filter(name=>name!==person);for(const month of Object.values(data.months||{})){if(month?.people)delete month.people[person]}if(selectedPerson===person)selectedPerson=null;await save();status(person+' deleted.')}catch(err){data.people=oldPeople;data.months=oldMonths;render();status(err.message,true)}return}const open=e.target.closest('[data-person]');if(open)openPerson(open.dataset.person)});
$('backToPeople').addEventListener('click',()=>{selectedPerson=null;render()});
$('addEntry').addEventListener('click',async()=>{try{if(!selectedPerson)throw Error('Choose a person first.');const amount=Number($('amount').value);if(!Number.isFinite(amount)||amount<0||!$('description').value.trim())throw Error('Enter a description and valid non-negative amount.');const p=personRecord();p[$('entryType').value].push({description:$('description').value.trim(),amount,note:$('entryNote').value.trim(),status:$('entryStatus').value});await save();$('description').value='';$('amount').value='';$('entryNote').value=''}catch(e){status(e.message,true)}});

$('entries').addEventListener('click',async e=>{
  const removeKey = e.target.dataset.remove;
  if (removeKey) {
    if (!window.confirm('Are you sure you want to delete this transaction?')) return;
    try {
      const [type, idx] = removeKey.split(':');
      personRecord()[type].splice(Number(idx), 1);
      await save();
    } catch (err) { status(err.message, true); }
    return;
  }
  const editKey = e.target.dataset.edit;
  if (editKey) {
    editingEntryKey = editKey;
    render();
    return;
  }
  if (e.target.id === 'saveEditBtn') {
    try {
      const [type, idx] = editingEntryKey.split(':');
      const desc = $('editDesc').value.trim();
      const amt = Number($('editAmt').value);
      if (!desc || !Number.isFinite(amt) || amt < 0) throw Error('Enter a valid description and non-negative amount.');
      const entry = personRecord()[type][Number(idx)];
      entry.description = desc;
      entry.amount = amt;
      entry.status = $('editStatus').value;
      entry.note = $('editNote').value.trim();
      editingEntryKey = null;
      await save();
    } catch (err) { status(err.message, true); }
    return;
  }
  if (e.target.id === 'cancelEditBtn') {
    editingEntryKey = null;
    render();
    return;
  }
});

$('entries').addEventListener('change',async e=>{
  const statusKey = e.target.dataset.statusChange;
  if (!statusKey) return;
  try {
    const [type, idx] = statusKey.split(':');
    personRecord()[type][Number(idx)].status = e.target.value;
    await save();
  } catch (err) { status(err.message, true); }
});

$('addTemplate').addEventListener('click',async()=>{try{const desc=$('tplDesc').value.trim();if(!desc)throw Error('Enter a template description.');data.templates.push({id:`tpl_${Date.now()}`,description:desc,type:$('tplType').value,category:$('tplCategory').value.trim()||'Other',person:$('tplPerson').value});await save();$('tplDesc').value='';$('tplCategory').value=''}catch(e){status(e.message,true)}});

$('templatesList').addEventListener('click',async e=>{
  const removeIdx = e.target.dataset.removeTemplate;
  if (removeIdx !== undefined && removeIdx !== null) {
    if (!window.confirm('Delete this template?')) return;
    try {
      data.templates.splice(Number(removeIdx), 1);
      await save();
    } catch (err) { status(err.message, true); }
    return;
  }
  const editIdx = e.target.dataset.editTemplate;
  if (editIdx !== undefined && editIdx !== null) {
    editingTemplateIndex = Number(editIdx);
    renderTemplates();
    return;
  }
  if (e.target.id === 'saveTplBtn') {
    try {
      const desc = $('editTplDesc').value.trim();
      if (!desc) throw Error('Enter a template description.');
      data.templates[editingTemplateIndex] = {
        id: data.templates[editingTemplateIndex].id || `tpl_${editingTemplateIndex + 1}`,
        description: desc,
        type: $('editTplType').value,
        category: $('editTplCategory').value.trim() || 'Other',
        person: $('editTplPerson').value
      };
      editingTemplateIndex = null;
      await save();
    } catch (err) { status(err.message, true); }
    return;
  }
  if (e.target.id === 'cancelTplBtn') {
    editingTemplateIndex = null;
    renderTemplates();
    return;
  }
});

$('saveBank').addEventListener('click',async()=>{try{const account=$('bankAccount').value.trim();if(!account)throw Error('Enter an account name.');const rec=monthRecord();const b={account,opening:Number($('bankOpening').value)||0,closing:Number($('bankClosing').value)||0,note:$('bankNote').value.trim()};const i=rec.bankBalances.findIndex(x=>x.account===account);if(i>=0)rec.bankBalances[i]=b;else rec.bankBalances.push(b);if(!data.accounts.includes(account))data.accounts.push(account);await save()}catch(e){status(e.message,true)}});
$('mfAccountFilter').addEventListener('change',render);
$('mfHoldings').addEventListener('input',e=>{const key=e.target.dataset.mfPurpose;if(!key)return;const [ri,rj]=key.split(':').map(Number);if(data.imports[ri]?.rows[rj])data.imports[ri].rows[rj].purpose=e.target.value.slice(0,250)});
$('saveFundPurposes').addEventListener('click',async()=>{try{await save();status('Mutual fund purposes saved to the local database.')}catch(e){status(e.message,true)}});
$('importPreview').addEventListener('input',e=>{const i=Number(e.target.dataset.purposeIndex);if(Number.isInteger(i)&&pendingRows?.[i])pendingRows[i].purpose=e.target.value.slice(0,250)});
$('saveSettings').addEventListener('click',async()=>{try{data.accounts=$('accountsSetting').value.split(',').map(s=>s.trim()).filter(Boolean);await save()}catch(e){status(e.message,true)}});
$('previewImport').addEventListener('click',async()=>{try{pendingRows=(await api('/api/admin/expense-tracker/import-preview',{csv:$('csv').value,source:$('broker').value,assetType:$('assetType').value,account:$('importAccount').value.trim()})).rows;if($('importAccount').value.trim())pendingRows=pendingRows.map(row=>({...row,account:$('importAccount').value.trim()}));const stockCount=pendingRows.filter(r=>r.assetType!=='mutualFund').length, fundCount=pendingRows.filter(r=>r.assetType==='mutualFund').length;$('confirmImport').disabled=false;$('importPreview').innerHTML='<p><b>'+pendingRows.length+' holdings recognized.</b> '+(fundCount&&stockCount?'Will save as '+stockCount+' stock holdings and '+fundCount+' mutual fund holdings.':(fundCount?'Mutual fund holdings.':'Stock holdings.'))+' Review before saving.</p><div class="et-table-wrap"><table class="et-list"><thead><tr><th>Detected type</th><th>Symbol / scheme</th><th>ISIN</th><th>Quantity / units</th><th>Avg price</th><th>Current price</th><th>Invested</th><th>Current value</th><th>Account</th><th>Purpose</th></tr></thead><tbody>'+pendingRows.slice(0,100).map((r,i)=>'<tr><td>'+(r.assetType==='mutualFund'?'Mutual fund':'Stock')+'</td>'+[r.symbol,r.isin,r.quantity,r.averagePrice,r.currentPrice,r.invested,r.currentValue,r.account].map(v=>'<td>'+escape(v)+'</td>').join('')+'<td><input data-purpose-index="'+i+'" value="'+escape(r.purpose)+'" aria-label="Purpose for '+escape(r.symbol)+'"></td></tr>').join('')+'</tbody></table></div>'+(pendingRows.length>100?'<p>Showing first 100 rows.</p>':'');status('Preview only — no data saved yet.')}catch(e){pendingRows=null;$('confirmImport').disabled=true;status(e.message,true)}});

$('confirmImport').addEventListener('click',async()=>{try{if(!pendingRows?.length)throw Error('Preview a report before confirming.');const importedAt=new Date().toISOString(),source=$('broker').value,month=$('importMonth').value;const stockRows=pendingRows.filter(row=>row.assetType!=='mutualFund'),fundRows=pendingRows.filter(row=>row.assetType==='mutualFund');for(const row of fundRows){if(!row.purpose){const prior=latestHoldings('mutualFund').find(h=>h.account.toLowerCase()===(row.account||source).toLowerCase()&&String(h.row.isin||h.row.symbol).toLowerCase()===String(row.isin||row.symbol).toLowerCase());if(prior)row.purpose=prior.row.purpose||''}}if(stockRows.length)data.imports.push({source,assetType:'stock',currency:stockRows[0]?.currency||'INR',month,importedAt,rows:stockRows});if(fundRows.length)data.imports.push({source,assetType:'mutualFund',currency:fundRows[0]?.currency||'INR',month,importedAt,rows:fundRows});await save();pendingRows=null;$('confirmImport').disabled=true;$('csv').value='';$('csvFile').value='';$('importPreview').textContent='Import saved'+(stockRows.length&&fundRows.length?' as separate Stocks and Mutual funds reports.':'.')}catch(e){status(e.message,true)}});
(async()=>{try{const response=await api('/api/admin/expense-tracker/data');data=response?.data&&typeof response.data==='object'?response.data:null;if(!data){data={version:1,people:['Household'],categories:['Other'],accounts:[],months:{},imports:[]};}data.people=Array.isArray(data.people)?data.people:[];data.categories=Array.isArray(data.categories)&&data.categories.length?data.categories:['Other'];data.accounts=Array.isArray(data.accounts)?data.accounts:[];data.months=data.months&&typeof data.months==='object'?data.months:{};data.imports=Array.isArray(data.imports)?data.imports:[];render();status('Local data ready.')}catch(e){loadFailed=true;data={version:1,people:['Household'],categories:['Other'],accounts:[],months:{},imports:[]};render();status('Could not load saved data: '+e.message,true)}})();
})();
</script></body></html>
