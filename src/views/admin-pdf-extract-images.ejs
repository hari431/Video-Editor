<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Extract Images · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Extract Images</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Upload one PDF to list its embedded raster images, then download them individually or as a ZIP. Images come straight from the file's object model — pages are never re-rendered. JPEGs download byte-identical; other images download as lossless PNGs. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfExtractImagesAvailable !== 'undefined' ? !!pdfExtractImagesAvailable : false; %>
<% const _maxMb = (typeof pdfExtractImagesMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfExtractImagesMaxFileMb)) && Number(pdfExtractImagesMaxFileMb) >= 1) ? Math.floor(Number(pdfExtractImagesMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-extract-images-disabled">Extract Images is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-extract-images-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfExtractImagesPick" data-testid="pdf-extract-images-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfExtractImagesFile" data-testid="pdf-extract-images-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <button type="button" class="button small secondary" id="pdfExtractImagesSelectAll" data-testid="pdf-extract-images-select-all" <%= _available ? '' : 'disabled' %>>Select all</button>
    <button type="button" class="button small secondary" id="pdfExtractImagesSelectNone" data-testid="pdf-extract-images-select-none" <%= _available ? '' : 'disabled' %>>Select none</button>
    <button type="button" class="button small primary" id="pdfExtractImagesBtn" data-testid="pdf-extract-images-submit" <%= _available ? '' : 'disabled' %>>⤵ Export selected</button>
    <button type="button" class="button small secondary" id="pdfExtractImagesClear" data-testid="pdf-extract-images-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <ol id="pdfExtractImagesList" data-testid="pdf-extract-images-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;"></ol>
  <p class="muted" id="pdfExtractImagesHint" data-testid="pdf-extract-images-hint" style="font-size:12px;">No PDF selected yet. Embedded images will be listed here with previews.</p>
  <p class="muted" id="pdfExtractImagesSkipped" data-testid="pdf-extract-images-skipped" style="font-size:12px;"></p>
  <div id="pdfExtractImagesProgress" data-testid="pdf-extract-images-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Working… <span id="pdfExtractImagesProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-extract-images-status" id="pdfExtractImagesStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-extract-images-result" id="pdfExtractImagesResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-extract-images.js?v=<%= Date.now() %>"></script>
</body></html>
