<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AI Admin Center · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container">
<h1>AI Admin Center</h1>
<p class="muted" style="margin-top:-8px;margin-bottom:16px;">Read-only AI assistance for admins — brief, capabilities, diagnostics, and digest. Nothing here changes data.</p>
<%- include('partials/admin-nav') %>
<section data-testid="admin-assistant" id="assistant-card" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">AI Admin Assistant</h2>
    <span id="assistant-status" class="badge badge-neutral" aria-live="polite">Loading…</span>
  </div>
  <p id="assistant-headline" class="muted" style="margin:0 0 8px;" aria-live="polite">Loading the deterministic admin brief…</p>
  <ul id="assistant-findings" style="margin:0 0 8px;padding-left:18px;list-style:disc;"></ul>
  <p id="assistant-error" class="muted" style="display:none;margin:0 0 8px;" role="alert"></p>
  <button id="assistant-retry" type="button" class="button small secondary" style="display:none;margin-bottom:10px;">Retry</button>
  <form id="assistant-form" style="margin-top:6px;">
    <label for="assistant-question" class="muted" style="font-size:13px;font-weight:600;">Ask about admin data (read-only)</label>
    <div style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;">
      <input id="assistant-question" name="question" type="text" maxlength="500" autocomplete="off" placeholder="e.g. How many pending access requests?" style="flex:1;min-width:220px;padding:8px 10px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px;">
      <button id="assistant-ask" type="submit" class="button small">Ask</button>
    </div>
  </form>
  <div id="assistant-answer" aria-live="polite" style="display:none;margin-top:10px;border-top:1px solid #eef1f6;padding-top:10px;"></div>
</section>
<section data-testid="admin-capabilities" id="capabilities-card" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">Admin Capabilities</h2>
    <span id="capabilities-status" class="badge badge-neutral" aria-live="polite">Loading…</span>
  </div>
  <p class="muted" style="margin:0 0 8px;">Available read-only admin capabilities — informational only, not executable commands.</p>
  <p id="capabilities-summary" class="muted" style="margin:0 0 8px;" aria-live="polite">Loading capability status…</p>
  <ul id="capabilities-list" style="margin:0 0 8px;padding-left:18px;list-style:disc;"></ul>
  <p id="capabilities-error" class="muted" style="display:none;margin:0 0 8px;" role="alert"></p>
  <button id="capabilities-retry" type="button" class="button small secondary" style="display:none;">Retry</button>
</section>
<section data-testid="admin-actions" id="actions-card" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">Diagnostic Actions</h2>
    <span id="actions-status" class="badge badge-neutral" aria-live="polite">Idle</span>
  </div>
  <p class="muted" style="margin:0 0 8px;">Read-only diagnostics. Select an action, confirm it, then run — nothing executes automatically.</p>
  <ul id="actions-list" style="margin:0 0 8px;padding-left:18px;list-style:disc;"></ul>
  <div id="actions-confirm" style="display:none;margin-top:10px;border-top:1px solid #eef1f6;padding-top:10px;">
    <p id="actions-confirm-label" style="margin:0 0 4px;font-weight:700;"></p>
    <p id="actions-confirm-desc" class="muted" style="margin:0 0 4px;"></p>
    <p class="muted" style="margin:0 0 8px;">Read-only diagnostic — no changes will be made.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button id="actions-run" type="button" class="button small">Run diagnostic</button>
      <button id="actions-cancel" type="button" class="button small secondary">Cancel</button>
    </div>
  </div>
  <div id="actions-result" aria-live="polite" style="display:none;margin-top:10px;border-top:1px solid #eef1f6;padding-top:10px;"></div>
  <p id="actions-error" class="muted" style="display:none;margin:8px 0 0;" role="alert"></p>
</section>
<section data-testid="nanobot-digest" id="nanobot-digest" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">Nanobot Digest</h2>
    <span class="badge badge-neutral">Admin / Owner · Read-only</span>
  </div>
  <p class="muted" style="margin:0 0 10px;">Evidence-backed digest validation. No scheduling or delivery is active yet.</p>
  <p id="nanobot-digest-headline" class="muted" style="margin:0 0 8px;" aria-live="polite">Loading digest…</p>
  <div id="nanobot-digest-items" aria-live="polite"></div>
  <p id="nanobot-digest-unavailable" class="muted" style="display:none;margin:8px 0;" role="status"></p>
  <p id="nanobot-digest-error" class="muted" style="display:none;margin:8px 0;color:#991b1b;" role="alert"></p>
  <button id="nanobot-digest-retry" type="button" class="button small secondary" style="display:none;">Retry</button>
</section>
<section data-testid="security-lab" id="security-lab-card" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">Security Lab</h2>
    <span id="security-lab-status" class="badge badge-neutral" aria-live="polite">Loading…</span>
  </div>
  <p class="muted" style="margin:0 0 8px;">Registered security tools — catalog only; any run is admin-only and never automatic.</p>
  <p id="security-lab-summary" class="muted" style="margin:0 0 8px;" aria-live="polite">Loading security tool catalog…</p>
  <p id="security-lab-enabled-note" class="muted" style="margin:0 0 8px;" aria-live="polite">Checking tool availability…</p>
  <ul id="security-lab-enabled-list" style="margin:0 0 8px;padding-left:18px;list-style:disc;"></ul>
  <ul id="security-lab-list" style="margin:0 0 8px;padding-left:18px;list-style:disc;"></ul>
  <p id="security-lab-error" class="muted" style="display:none;margin:0 0 8px;" role="alert"></p>
  <button id="security-lab-retry" type="button" class="button small secondary" style="display:none;">Retry</button>
</section>
<section data-testid="ai-workflow-status" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:14px 16px;margin:14px 0 20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
    <h2 style="margin:0;font-size:15px;font-weight:700;color:#172033;">AI Development Workflow: Active</h2>
    <span style="font-size:11px;color:#7a8499;letter-spacing:0.02em;text-transform:uppercase;">Governance</span>
  </div>
  <p class="muted" style="margin:0 0 8px;">Inspect → Plan → Approve → Implement → Verify → Report. Root cause before fix. No silent scope expansion. Evidence-backed completion.</p>
  <p class="muted" style="margin:0;">Source of truth: .ai/README.md · Agents: .ai/agents/ · Skills: .ai/skills/</p>
</section>

</main>
<%- include('partials/footer') %>
<script>
(function(){
  var headline=document.getElementById('nanobot-digest-headline');
  var items=document.getElementById('nanobot-digest-items');
  var unavailable=document.getElementById('nanobot-digest-unavailable');
  var error=document.getElementById('nanobot-digest-error');
  var retry=document.getElementById('nanobot-digest-retry');
  if(!headline||!items) return;
  function render(data){
    var d=data&&data.digest;
    if(!d){ throw new Error('Digest unavailable.'); }
    headline.textContent=d.headline||'Digest available.';
    items.textContent='';
    (Array.isArray(d.items)?d.items:[]).forEach(function(item){
      var card=document.createElement('div');
      card.style.cssText='border-top:1px solid #eef1f6;padding:9px 0;';
      var title=document.createElement('strong');
      title.textContent=item.title||'Evidence-backed item';
      var detail=document.createElement('div');
      detail.className='muted';
      detail.style.marginTop='3px';
      detail.textContent=item.detail||'';
      card.appendChild(title); card.appendChild(detail);
      items.appendChild(card);
    });
    var missing=Array.isArray(d.unavailable)?d.unavailable:[];
    unavailable.style.display=missing.length?'block':'none';
    unavailable.textContent=missing.length?'Unavailable evidence: '+missing.join(', '):'';
    error.style.display='none'; retry.style.display='none';
  }
  async function load(){
    headline.textContent='Loading digest…'; items.textContent=''; unavailable.style.display='none'; error.style.display='none'; retry.style.display='none';
    try{
      var res=await fetch('/api/admin/nanobot/digest',{cache:'no-store',credentials:'same-origin',headers:{Accept:'application/json','Cache-Control':'no-cache'}});
      var data=await res.json().catch(function(){return null;});
      if(!res.ok) throw new Error((data&&data.error)||'Unable to load digest.');
      render(data);
    }catch(e){
      headline.textContent='Digest unavailable.'; error.textContent=e&&e.message?e.message:'Unable to load digest.'; error.style.display='block'; retry.style.display='inline-block';
    }
  }
  retry.addEventListener('click',load); load();
})();
</script>
<script src="/admin-assistant.js" defer></script>
<script src="/admin-capabilities.js" defer></script>
<script src="/admin-security-lab.js" defer></script>
<script src="/admin-actions.js" defer></script>
</body></html>
