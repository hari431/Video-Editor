<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Learn with me</title><link rel="stylesheet" href="/styles.css"><style>.nav-more{position:relative}.nav-more summary{list-style:none;cursor:pointer}.nav-more summary::-webkit-details-marker{display:none}.nav-more-menu{position:absolute;top:calc(100% + 8px);left:0;z-index:60;display:flex;flex-direction:column;gap:10px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;box-shadow:0 12px 30px rgba(15,23,42,.12);min-width:240px}.ftv-bored{font-size:13px;color:#475569;white-space:nowrap}.ftv-bored button{margin-left:6px;border:1px solid #cbd5e1;background:#fff;border-radius:8px;padding:4px 12px;cursor:pointer;font:inherit;font-size:12px;font-weight:700;color:#1d4ed8}.ftv-bored button:hover{background:#eff6ff}</style><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <% if (typeof knowledgeEnabled === 'undefined' || knowledgeEnabled) { %>
    <a class="nav-link" href="/knowledge">📖 Knowledge Base</a>
  <% } %>
  <% if (typeof paidPlansEnabled !== 'undefined' && paidPlansEnabled) { %>
    <a class="nav-link" href="/plans">💎 Available Plans</a>
  <% } %>
  <% const _canLikesNav = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLikesNav) { %><a class="nav-link" href="/my/likes">❤️ My Liked Items</a><% } %>
  <% if (typeof hasActiveAccess !== 'undefined' ? hasActiveAccess : (typeof user !== 'undefined' && user && ((typeof hasUserActiveAccess === 'function') ? hasUserActiveAccess(user) : (user.status === 'active' && (!user.access_expires_at || new Date(user.access_expires_at) > new Date()))))) { %>
    <a class="nav-link" href="/my/notes" id="notesLink">📝 My Notes</a>
  <% } %>
  <% if (typeof user !== 'undefined' && user && (user.app_role === 'ADMIN' || user.app_role === 'OWNER')) { %>
    <a class="nav-link" href="/admin" data-testid="admin-nav-link" style="font-weight: bold; color: #dc2626;">🛠️ Admin</a>
  <% } %>
  <% const _showMoreMenu = (typeof knowledgeEnabled === 'undefined' || knowledgeEnabled) || (typeof freeTvVisible !== 'undefined' && freeTvVisible); %>
  <% if (_showMoreMenu) { %>
  <details class="nav-more">
    <summary class="nav-link">More ▾</summary>
    <div class="nav-more-menu">
      <% if (typeof knowledgeEnabled === 'undefined' || knowledgeEnabled) { %><a class="nav-link" href="/exchange-rates">💱 Exchange Rates</a><% } %>
      <% if (typeof freeTvVisible !== 'undefined' && freeTvVisible) { %>
      <% const _ftvDay = new Date().toISOString().slice(0, 10); const _ftvLogin = (function(){ try { const raw = (typeof user !== 'undefined' && user && user.last_login_at) ? user.last_login_at : null; const t = raw ? new Date(raw).getTime() : NaN; return Number.isFinite(t) ? new Date(t).toISOString() : ''; } catch (e) { return ''; } })(); %>
      <span class="ftv-bored" id="ftvBored" data-ftv-day="<%= _ftvDay %>" data-ftv-login="<%= _ftvLogin %>">Are you feeling bored? 😄 <button type="button" id="ftvBoredYes">Yes</button></span>
      <a class="nav-link" href="/entertainment" id="ftvNavLink" hidden>🍿 Entertainment</a>
      <% } %>
    </div>
  </details>
  <% } %>
  <form id="searchForm" class="search">
    <input id="searchInput" placeholder="Search the library..." autocomplete="off" maxlength="120">
    <div id="searchResults" class="search-results"></div>
  </form>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<%- include('partials/access-expiry') %>
<main class="container" id="libraryContainer">
  <% if (!path) { %>
    <%- include('partials/new-content') %>
  <% } %>
  <div class="breadcrumbs"><a href="/">Home</a><% if (path) { path.split('/').forEach((part, i, arr) => { const p = arr.slice(0, i+1).join('/'); %><span>/</span><a href="/browse/<%= p.split('/').map(encodeURIComponent).join('/') %>"><%= part %></a><% }) } %></div>
  <section class="page-heading">
    <div>
      <h1><%= path === 'Guidewire/Gosu' ? 'Guidewire Gosu Queries' : (path ? path.split('/').at(-1) : 'Browse Library') %></h1>
      <p><%= path ? 'Folders and queries from the Learn with me library.' : 'Choose a topic and browse its library.' %></p>
      <% if (path && typeof showFolderProgress !== 'undefined' && showFolderProgress && typeof folderProgress !== 'undefined' && folderProgress[path]) { 
           const currentProg = folderProgress[path]; %>
        <div class="current-folder-progress" data-testid="current-folder-progress">
          <span class="folder-progress-text"><%= currentProg.viewed %> of <%= currentProg.total %> items viewed (<%= currentProg.percent %>%)</span>
          <div class="folder-progress-bar" aria-hidden="true">
            <div class="folder-progress-fill" style="width: <%= currentProg.percent %>%;"></div>
          </div>
        </div>
      <% } %>
    </div>
  </section>
  <% if (typeof showAd !== 'undefined' && showAd) { %><%- include('partials/ad-slot', { showAd, slotId: typeof slotId !== 'undefined' ? slotId : 'library-top' }) %><% } %>
  <% if (!path && typeof recentlyViewed !== 'undefined' && recentlyViewed && recentlyViewed.length) { %>
  <section class="recently-viewed" data-testid="recently-viewed">
    <div class="recently-viewed-header">
      <h2>👀 Recently Viewed — Last 4 Files</h2>
      <form method="post" action="/my/recently-viewed/clear" class="rv-clear-form">
        <button type="submit" data-testid="clear-recently-viewed" class="rv-clear-btn">Clear</button>
      </form>
    </div>
    <p class="muted">Pick up where you left off.</p>
    <div class="grid">
      <% for (const item of recentlyViewed) { %>
        <a class="card" href="<%= item.href %>" style="position: relative; display: flex; align-items: center; justify-content: space-between; padding-right: 58px;">
          <div style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0;">
            <div class="icon"><%= item.kind === 'folder' ? '📁' : item.kind === 'video' ? '🎬' : item.kind === 'pdf' ? '📕' : item.kind === 'document' ? '📝' : item.kind === 'spreadsheet' ? '📊' : item.kind === 'presentation' ? '📊' : item.kind === 'image' ? '🖼️' : item.kind === 'markdown' ? '📝' : item.kind === 'archive' ? '📦' : item.kind === 'text' ? '📄' : '📄' %></div>
            <div style="flex: 1; min-width: 0;">
              <strong class="card-filename"><%= item.name.replace(/\.[^.]+$/i, '') %></strong>
              <small style="display: block;"><%= item.typeLabel %> · <%= item.category %> · <%= new Date(item.lastViewedAt).toLocaleString() %></small>
            </div>
          </div>
          <!-- Like Button Overlay -->
          <% if (item.kind !== 'folder') { %>
          <% const _canLike = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLike) { %>
          <% const itemLikes = (typeof likesMap !== 'undefined' && likesMap[item.path]) ? likesMap[item.path] : { liked: false, likeCount: 0 }; %>
          <div class="card-like-control like-control" style="position: absolute; top: 8px; right: 8px; z-index: 10;">
            <button class="card-like-btn like-btn <%= itemLikes.liked ? 'liked' : '' %>" data-path="<%= item.path %>" style="background: rgba(255, 255, 255, 0.95); border: 1px solid #cbd5e1; cursor: pointer; display: flex; align-items: center; gap: 3px; font-size: 11px; color: <%= itemLikes.liked ? '#ef4444' : '#64748b' %>; padding: 4px 8px; border-radius: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); font-weight: 500; transition: all 0.2s; min-width: 44px; justify-content: center;">
              <span class="heart-icon"><%= itemLikes.liked ? '❤️' : '🤍' %></span>
              <span class="like-count"><%= itemLikes.likeCount %></span>
            </button>
          </div>
          <% } %>
          <% } %>
        </a>
      <% } %>
    </div>
  </section>
  <% } %>
  <% const visible = folder || tree; if (visible.children.size > 0) { %>
  <div class="browse-controls" data-controls-for="library">
    <div class="control-group">
      <label for="librarySortSelect">Sort by</label>
      <select id="librarySortSelect" class="control-select" data-testid="library-sort-select">
        <option value="recentlyAdded">Recently added</option>
        <option value="recentlyUpdated">Recently updated</option>
        <option value="nameAsc">Name A → Z</option>
        <option value="nameDesc">Name Z → A</option>
        <option value="mostLiked">Most liked</option>
        <option value="leastLiked">Least liked</option>
      </select>
    </div>
    <div class="control-group">
      <label for="libraryViewSelect">View by</label>
      <select id="libraryViewSelect" class="control-select" data-testid="library-view-select">
        <option value="cards">Cards</option>
        <option value="list">List</option>
        <option value="details">Details</option>
      </select>
    </div>
  </div>
  <div class="grid" data-testid="library-list" id="libraryGrid">
    <% for (const item of visible.children.values()) { %>
      <% const _libDn = (item.type === 'folder' ? item.name : item.type === 'external' ? (item.file && item.file.friendlyName ? item.file.friendlyName : item.name.replace(/^external - /i,'').trim().replace(/\.[^.]+$/i,'')) : item.name.replace(/\.[^.]+$/i, '')); const _libDnLower = _libDn.toLowerCase(); const _libLikeCnt = (typeof likesMap !== 'undefined' && likesMap[item.path]) ? Number(likesMap[item.path].likeCount || 0) : 0; const _libMeta = (typeof libraryMetadata !== 'undefined' && libraryMetadata && libraryMetadata[item.path]) ? libraryMetadata[item.path] : null; const _libAddedMs = _libMeta && _libMeta.addedAt ? new Date(_libMeta.addedAt).getTime() : 0; const _libUpdatedMs = _libMeta && _libMeta.updatedAt ? new Date(_libMeta.updatedAt).getTime() : 0; %>
      <a class="card" data-name="<%= _libDnLower %>" data-like-count="<%= _libLikeCnt %>" data-added-ms="<%= _libAddedMs %>" data-updated-ms="<%= _libUpdatedMs %>" data-type="<%= item.type %>" data-is-folder="<%= item.type === 'folder' ? '1' : '0' %>" href="<%= item.type === 'folder' ? '/browse/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'video' ? '/watch/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'file' ? '/query/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'external' ? '/external/' + item.path.split('/').map(encodeURIComponent).join('/') : '/item/' + item.path.split('/').map(encodeURIComponent).join('/') %>" style="position: relative; display: flex; align-items: center; justify-content: space-between; padding-right: 70px;">
        <div style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0;">
          <div class="icon"><%= item.type === 'folder' ? '📁' : item.type === 'video' ? '🎬' : item.type === 'external' ? '🔗' : item.type === 'pdf' ? '📕' : item.type === 'document' ? '📝' : item.type === 'spreadsheet' ? '📊' : item.type === 'presentation' ? '📊' : item.type === 'image' ? '🖼️' : item.type === 'markdown' ? '📝' : item.type === 'archive' ? '📦' : '📄' %></div>
          <div style="flex: 1; min-width: 0;">
            <strong class="card-filename"><%= item.type === 'folder' ? item.name : item.type === 'external' ? (item.file && item.file.friendlyName ? item.file.friendlyName : item.name.replace(/^external - /i,'').trim().replace(/\.[^.]+$/i,'')) : item.name.replace(/\.[^.]+$/i, '') %></strong>
            <small style="display: block;"><%= item.type === 'folder' ? 'Folder' : item.type === 'video' ? 'Video' : item.type === 'external' ? 'External' : categoryForPath(item.path) %></small>
            <% if (item.type === 'folder' && typeof showFolderProgress !== 'undefined' && showFolderProgress && typeof folderProgress !== 'undefined' && folderProgress[item.path]) { 
                 const prog = folderProgress[item.path]; %>
              <div class="folder-progress" data-testid="folder-progress" style="margin-top: 4px;">
                <span class="folder-progress-text"><%= prog.viewed %> of <%= prog.total %> items viewed (<%= prog.percent %>%)</span>
                <div class="folder-progress-bar" aria-hidden="true">
                  <div class="folder-progress-fill" style="width: <%= prog.percent %>%;"></div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
        <!-- Like Button Overlay -->
        <% if (item.type !== 'folder') { %>
        <% const _canLike2 = (typeof hasNotes !== 'undefined' ? hasNotes : (typeof hasNotesPermission !== 'undefined' ? hasNotesPermission : false)); if (_canLike2) { %>
        <% const itemLikes = (typeof likesMap !== 'undefined' && likesMap[item.path]) ? likesMap[item.path] : { liked: false, likeCount: 0 }; %>
        <div class="card-like-control like-control" style="position: absolute; top: 12px; right: 12px; z-index: 10;">
          <button class="card-like-btn like-btn <%= itemLikes.liked ? 'liked' : '' %>" data-path="<%= item.path %>" style="background: rgba(255, 255, 255, 0.95); border: 1px solid #cbd5e1; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 13px; color: <%= itemLikes.liked ? '#ef4444' : '#64748b' %>; padding: 6px 10px; border-radius: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); font-weight: 500; transition: all 0.2s; min-width: 54px; justify-content: center;">
            <span class="heart-icon"><%= itemLikes.liked ? '❤️' : '🤍' %></span>
            <span class="like-count"><%= itemLikes.likeCount %></span>
          </button>
        </div>
        <% } %>
        <% } %>
      </a>
    <% } %>
  </div>
  <div class="details-wrap" id="libraryDetailsWrap">
    <table class="details-table" data-testid="library-details-table">
      <thead><tr><th>Name</th><th>Type</th><th>Likes</th></tr></thead>
      <tbody id="libraryDetailsBody">
        <% for (const item of visible.children.values()) { %>
          <% const _dnDetail = (item.type === 'folder' ? item.name : item.type === 'external' ? (item.file && item.file.friendlyName ? item.file.friendlyName : item.name.replace(/^external - /i,'').trim().replace(/\.[^.]+$/i,'')) : item.name.replace(/\.[^.]+$/i, '')); const _dnDetailLower = _dnDetail.toLowerCase(); const _likeCntDetail = (typeof likesMap !== 'undefined' && likesMap[item.path]) ? Number(likesMap[item.path].likeCount || 0) : 0; const _metaDetail = (typeof libraryMetadata !== 'undefined' && libraryMetadata && libraryMetadata[item.path]) ? libraryMetadata[item.path] : null; const _addedMsDetail = _metaDetail && _metaDetail.addedAt ? new Date(_metaDetail.addedAt).getTime() : 0; const _updatedMsDetail = _metaDetail && _metaDetail.updatedAt ? new Date(_metaDetail.updatedAt).getTime() : 0; %>
          <tr data-name="<%= _dnDetailLower %>" data-like-count="<%= _likeCntDetail %>" data-added-ms="<%= _addedMsDetail %>" data-updated-ms="<%= _updatedMsDetail %>" data-type="<%= item.type %>" data-is-folder="<%= item.type === 'folder' ? '1' : '0' %>">
            <td><a href="<%= item.type === 'folder' ? '/browse/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'video' ? '/watch/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'file' ? '/query/' + item.path.split('/').map(encodeURIComponent).join('/') : item.type === 'external' ? '/external/' + item.path.split('/').map(encodeURIComponent).join('/') : '/item/' + item.path.split('/').map(encodeURIComponent).join('/') %>"><%= _dnDetail %></a></td>
            <td><%= item.type === 'folder' ? 'Folder' : item.type === 'video' ? 'Video' : item.type === 'external' ? 'External' : categoryForPath(item.path) %></td>
            <td><%= _likeCntDetail %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <p class="empty-folder">This folder is empty. New queries added here will appear automatically.</p>
  <% } %>
</main>
<%- include('partials/footer') %>
<script src="/app.js"></script>
<script src="/like.js" defer></script>
<script src="/browse-controls.js"></script>
<% if (visible && visible.children && visible.children.size > 0) { %>
<script>
BrowseControls.setup({
  containerId: 'libraryContainer',
  gridId: 'libraryGrid',
  detailsBodyId: 'libraryDetailsBody',
  sortSelectId: 'librarySortSelect',
  viewSelectId: 'libraryViewSelect',
  lsSortKey: 'library_sort',
  lsViewKey: 'library_view',
  defaultSort: 'nameAsc',
  defaultView: 'cards',
  groupFoldersFirst: true,
  sortFns: {
    recentlyAdded: function(a,b){ var d=(parseInt(b.getAttribute('data-added-ms'))||0)-(parseInt(a.getAttribute('data-added-ms'))||0); return d!==0?d:(a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); },
    recentlyUpdated: function(a,b){ var d=(parseInt(b.getAttribute('data-updated-ms'))||0)-(parseInt(a.getAttribute('data-updated-ms'))||0); return d!==0?d:(a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); },
    nameAsc: function(a,b){ return (a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); },
    nameDesc: function(a,b){ return (b.getAttribute('data-name')||'').localeCompare(a.getAttribute('data-name')||''); },
    mostLiked: function(a,b){ var d=(parseInt(b.getAttribute('data-like-count'))||0)-(parseInt(a.getAttribute('data-like-count'))||0); return d!==0?d:(a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); },
    leastLiked: function(a,b){ var d=(parseInt(a.getAttribute('data-like-count'))||0)-(parseInt(b.getAttribute('data-like-count'))||0); return d!==0?d:(a.getAttribute('data-name')||'').localeCompare(b.getAttribute('data-name')||''); }
  }
});
</script>
<% } %>
<% if (typeof freeTvVisible !== 'undefined' && freeTvVisible) { %>
<script>
(function(){try{var link=document.getElementById('ftvNavLink');var prompt=document.getElementById('ftvBored');if(!link||!prompt)return;var DAY=prompt.getAttribute('data-ftv-day')||'';var LOGIN=prompt.getAttribute('data-ftv-login')||'';var KEY='ftvBoredYes';function reveal(){prompt.hidden=true;link.hidden=false;}function read(){try{var raw=window.localStorage?window.localStorage.getItem(KEY):null;if(!raw)return null;var o=JSON.parse(raw);if(!o||o.v!==1||typeof o.day!=='string')return null;return o;}catch(e){return null;}}var s=read();if(s&&s.day===DAY&&s.login===LOGIN){reveal();}var yes=document.getElementById('ftvBoredYes');if(yes){yes.addEventListener('click',function(){try{if(window.localStorage){window.localStorage.setItem(KEY,JSON.stringify({v:1,day:DAY,login:LOGIN}));}}catch(e){}reveal();});}}catch(e){}})();
</script>
<% } %>
</body></html>
