<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Images to PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Images to PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Select JPG/JPEG or PNG images, arrange them in page order, then download a <strong>new</strong> PDF with one image per page. Images are embedded without recompression — quality cannot change. The original files are never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfImagesAvailable !== 'undefined' ? !!pdfImagesAvailable : false; %>
<% const _maxMb = (typeof pdfImagesMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfImagesMaxFileMb)) && Number(pdfImagesMaxFileMb) >= 1) ? Math.floor(Number(pdfImagesMaxFileMb)) : 5; %>
<% const _maxFiles = (typeof pdfImagesMaxFiles !== 'undefined' && Number.isFinite(Number(pdfImagesMaxFiles)) && Number(pdfImagesMaxFiles) >= 1) ? Math.floor(Number(pdfImagesMaxFiles)) : 8; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-images-disabled">Images to PDF is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-images-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>" data-max-files="<%= _maxFiles %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfImagesPick" data-testid="pdf-images-pick" <%= _available ? '' : 'disabled' %>>🖼 Select images</button>
    <input type="file" id="pdfImagesFile" data-testid="pdf-images-file" accept=".png,.jpg,.jpeg,image/png,image/jpeg" multiple style="display:none;" <%= _available ? '' : 'disabled' %>>
    <label style="font-size:13px;">Page size
      <select id="pdfImagesPageSize" data-testid="pdf-images-pagesize" <%= _available ? '' : 'disabled' %>>
        <option value="A4" selected>A4</option>
        <option value="Letter">Letter</option>
        <option value="image">Image size</option>
      </select>
    </label>
    <label style="font-size:13px;">Orientation
      <select id="pdfImagesOrientation" data-testid="pdf-images-orientation" <%= _available ? '' : 'disabled' %>>
        <option value="auto" selected>Auto</option>
        <option value="portrait">Portrait</option>
        <option value="landscape">Landscape</option>
      </select>
    </label>
    <label style="font-size:13px;">Margin (pt)
      <input type="number" id="pdfImagesMargin" data-testid="pdf-images-margin" value="36" min="0" max="72" step="1" style="width:70px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <button type="button" class="button small primary" id="pdfImagesBtn" data-testid="pdf-images-submit" <%= _available ? '' : 'disabled' %>>⤵ Convert &amp; download</button>
    <button type="button" class="button small secondary" id="pdfImagesClear" data-testid="pdf-images-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
    <span class="muted" style="font-size:12px;">Max <%= _maxFiles %> images · <%= _maxMb %> MB each</span>
  </div>
  <ol id="pdfImagesList" data-testid="pdf-images-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;"></ol>
  <p class="muted" id="pdfImagesHint" data-testid="pdf-images-hint" style="font-size:12px;">No images selected yet. Files appear here in page order — drag to reorder or use ↑/↓.</p>
  <div id="pdfImagesProgress" data-testid="pdf-images-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Converting… <span id="pdfImagesProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-images-status" id="pdfImagesStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-images-result" id="pdfImagesResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-images.js?v=<%= Date.now() %>"></script>
</body></html>
