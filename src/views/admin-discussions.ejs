<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Discussions Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container">
  <h1>Discussions Management</h1>
  <%- include('partials/admin-nav') %>
  <% if (msg) { %><div class="flash flash-ok"><%= msg %></div><% } %>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <div class="stats">
    <div class="stat stat--neutral"><strong><%= counts.total_questions %></strong><span>Total questions</span></div>
    <a href="/admin/discussions?filter=pending" class="stat stat--warning" style="background:#fffbeb;border-color:#fde68a;color:#92400e;text-decoration:none;display:block;">
      <strong><%= counts.pending_questions || 0 %></strong><span>Pending</span>
    </a>
    <div class="stat stat--success"><strong><%= counts.visible_questions %></strong><span>Visible</span></div>
    <div class="stat stat--warning"><strong><%= counts.hidden_questions %></strong><span>Hidden</span></div>
    <div class="stat stat--danger"><strong><%= counts.deleted_questions %></strong><span>Deleted</span></div>
    <div class="stat stat--neutral"><strong><%= counts.total_replies %></strong><span>Total replies</span></div>
    <a href="/admin/discussions?filter=pending-replies" class="stat stat--warning" style="background:#fffbeb;border-color:#fde68a;color:#92400e;text-decoration:none;display:block;">
      <strong><%= counts.pending_replies || 0 %></strong><span>Pending replies</span>
    </a>
    <div class="stat stat--success"><strong><%= counts.visible_replies %></strong><span>Visible replies</span></div>
    <div class="stat stat--warning"><strong><%= counts.hidden_replies %></strong><span>Hidden replies</span></div>
    <div class="stat stat--danger"><strong><%= counts.deleted_replies %></strong><span>Deleted replies</span></div>
  </div><!-- semantic layout preserved: class="stat" -->

  <% if (typeof needsAttention !== 'undefined' && needsAttention && !searchTerm && filter === 'all') { %>
  <div class="admin-attention">
    <h3 style="margin:0 0 8px 0;font-size:15px">Needs Attention</h3>
    <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:13px">
      <span><strong><%= needsAttention.counts.unanswered_count %></strong> unanswered <a href="/admin/discussions?filter=unanswered" style="font-size:12px">view</a></span>
      <span><strong><%= needsAttention.counts.hidden_questions_count + needsAttention.counts.hidden_replies_count %></strong> hidden (<%= needsAttention.counts.hidden_questions_count %> Q / <%= needsAttention.counts.hidden_replies_count %> R) <a href="/admin/discussions?filter=hidden" style="font-size:12px">view</a></span>
      <span><strong><%= needsAttention.counts.recent_replies_count %></strong> replies in last 7d</span>
      <span><strong><%= needsAttention.counts.recent_questions_count %></strong> questions in last 7d</span>
    </div>
    <% if (needsAttention.unansweredList && needsAttention.unansweredList.length > 0) { %>
      <div style="margin-top:10px">
        <strong style="font-size:12px;color:#555">Unanswered (recent 5):</strong>
        <ul style="margin:4px 0 0 16px;font-size:12px">
          <% needsAttention.unansweredList.forEach(q => { %>
            <li><a href="/discussions/<%= q.id %>" target="_blank"><%= q.title %></a> <span style="color:#888">— <%= q.author_name %> · <%= new Date(q.created_at).toLocaleDateString() %></span></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <% if (needsAttention.recentActive && needsAttention.recentActive.length > 0) { %>
      <div style="margin-top:10px">
        <strong style="font-size:12px;color:#555">Recently active (5):</strong>
        <ul style="margin:4px 0 0 16px;font-size:12px">
          <% needsAttention.recentActive.forEach(q => { %>
            <li><a href="/discussions/<%= q.id %>" target="_blank"><%= q.title %></a> <span style="color:#888">— <%= q.reply_count %> replies · <%= new Date(q.updated_at).toLocaleDateString() %></span> <% if (Number(q.accepted_count||0)) { %><span style="background:#2e7d32;color:#fff;padding:1px 4px;border-radius:3px;font-size:10px"><%= q.accepted_count %> Accepted</span><% } %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>
  <% } %>

  <h2>All Discussions</h2>
  
  <div style="margin-bottom:16px">
    <form method="get" action="/admin/discussions" style="display:flex;gap:8px;margin-bottom:12px">
      <input type="text" name="search" placeholder="Search by title, body, author, email, path, ID or status..." value="<%= searchTerm %>" style="flex:1;padding:8px;border:1px solid #ddd;border-radius:4px">
      <input type="hidden" name="filter" value="<%= filter %>">
      <button type="submit" class="button primary">Search</button>
      <% if (searchTerm) { %>
        <a href="/admin/discussions?filter=<%= filter %>" class="button">Clear</a>
      <% } %>
    </form>
  </div>

  <div class="admin-filter-bar">
    <a href="/admin/discussions" class="admin-filter<%= filter === 'all' ? ' admin-filter-active' : '' %>">All</a>
    <a href="/admin/discussions?filter=pending" class="admin-filter<%= filter === 'pending' ? ' admin-filter-active' : '' %>" style="background: #fffbeb; border-color: #fde68a; color: #92400e; <%= filter === 'pending' ? 'background: #fde68a; font-weight: bold;' : '' %>">Pending Approval</a>
    <a href="/admin/discussions?filter=pending-replies" class="admin-filter<%= filter === 'pending-replies' ? ' admin-filter-active' : '' %>" style="background: #fffbeb; border-color: #fde68a; color: #92400e; <%= filter === 'pending-replies' ? 'background: #fde68a; font-weight: bold;' : '' %>">Pending Replies</a>
    <a href="/admin/discussions?filter=unanswered" class="admin-filter<%= filter === 'unanswered' ? ' admin-filter-active' : '' %>">Unanswered</a>
    <a href="/admin/discussions?filter=answered" class="admin-filter<%= filter === 'answered' ? ' admin-filter-active' : '' %>">Answered</a>
    <a href="/admin/discussions?filter=most-replies" class="admin-filter<%= filter === 'most-replies' ? ' admin-filter-active' : '' %>">Most Replies</a>
    <a href="/admin/discussions?filter=no-replies" class="admin-filter<%= filter === 'no-replies' ? ' admin-filter-active' : '' %>">No Replies</a>
    <a href="/admin/discussions?filter=hidden" class="admin-filter<%= filter === 'hidden' ? ' admin-filter-active' : '' %>">Hidden</a>
    <a href="/admin/discussions?filter=deleted" class="admin-filter<%= filter === 'deleted' ? ' admin-filter-active' : '' %>">Deleted</a>
    <a href="/admin/discussions?filter=newest" class="admin-filter<%= filter === 'newest' ? ' admin-filter-active' : '' %>">Newest</a>
    <a href="/admin/discussions?filter=oldest-unanswered" class="admin-filter<%= filter === 'oldest-unanswered' ? ' admin-filter-active' : '' %>">Oldest Unanswered</a>
  </div>

  <% if (discussions.length === 0) { %>
    <p class="muted">No discussions match this filter.</p>
  <% } else { %>
    <% discussions.forEach(d => { %>
      <% const qMod = (typeof questionModeration !== 'undefined' && questionModeration.get) ? questionModeration.get(d.id) : null; %>
      <div class="admin-question-card">
        <div class="admin-question-header">
          <div class="admin-question-title-row">
            <h3 class="admin-question-title">
              <a href="/discussions/<%= d.id %>" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;" title="Open exact discussion/thread in new tab">
                <%= d.title %>
              </a>
            </h3>
            <% if (d.status === 'pending') { %>
              <span class="badge" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:bold;">PENDING APPROVAL</span>
            <% } else if (d.status === 'approved') { %>
              <span class="badge" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:bold;">APPROVED</span>
            <% } else { %>
              <span class="badge badge-<%= d.status === 'visible' ? 'visible' : d.status === 'hidden' ? 'hidden' : 'deleted' %>"><%= d.status.toUpperCase() %></span>
            <% } %>
            <% const _acAdmin = Number(d.accepted_count || 0); if (_acAdmin) { %>
              <span class="badge badge-success" style="margin-left:6px">✓ <%= _acAdmin %> Accepted</span>
            <% } %>
            <% if (d.status === 'deleted' && d.deleted_at) { %>
              <span style="font-size:0.85em;color:#999;margin-left:8px">deleted <%= new Date(d.deleted_at).toLocaleDateString() %></span>
            <% } %>
          </div>
          <div class="admin-question-meta">
            <span>By: <strong><%= d.author_name || 'Unknown' %></strong> (<%= d.author_email %>)</span>
            <span class="admin-meta-sep">·</span>
            <span>
              <a href="<%= contentRouteForPath(d.item_path) + d.item_path.split('/').map(c => encodeURIComponent(c)).join('/') %>" target="_blank" rel="noopener noreferrer" title="Open content in new tab">
                <%= d.item_path %>
              </a>
            </span>
            <span class="admin-meta-sep">·</span>
            <span><%= d.visible_reply_count %> visible / <%= d.hidden_reply_count %> hidden / <%= d.deleted_reply_count %> deleted</span>
            <span class="admin-meta-sep">·</span>
            <span><%= new Date(d.created_at).toLocaleString() %></span>
          </div>
          <% if (d.status === 'deleted') { %>
            <div style="font-size:0.85em;color:#666;margin-top:4px">
              Deleted by: <strong><%= d.deleted_by_name || (qMod ? qMod.actor_name : 'Unknown') %></strong> (<%= d.deleted_by_email || (qMod ? qMod.actor_email : '') %>) · <%= new Date(d.deleted_at || (qMod ? qMod.created_at : d.updated_at)).toLocaleString() %>
            </div>
          <% } else if (d.status === 'hidden' && qMod) { %>
            <div style="font-size:0.85em;color:#666;margin-top:4px">
              Hidden by: <strong><%= qMod.actor_name || 'Unknown' %></strong> (<%= qMod.actor_email || '' %>) · <%= new Date(qMod.created_at).toLocaleString() %>
            </div>
          <% } else if (qMod && qMod.action === 'restore') { %>
            <div style="font-size:0.85em;color:#666;margin-top:4px">
              Restored by: <strong><%= qMod.actor_name || 'Unknown' %></strong> (<%= qMod.actor_email || '' %>) · <%= new Date(qMod.created_at).toLocaleString() %>
            </div>
          <% } else if (qMod && qMod.action === 'unhide') { %>
            <div style="font-size:0.85em;color:#666;margin-top:4px">
              Unhidden by: <strong><%= qMod.actor_name || 'Unknown' %></strong> (<%= qMod.actor_email || '' %>) · <%= new Date(qMod.created_at).toLocaleString() %>
            </div>
          <% } %>
        </div>
        <% if (d.body) { %>
          <div class="admin-question-content"><%= d.body %></div>
        <% } %>
        <div class="admin-question-actions">
          <% if (d.status === 'pending') { %>
            <form method="post" action="/admin/discussions/<%= d.id %>/approve" style="display:inline">
              <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
              <button type="submit" class="button small success" style="font-weight: bold;">Approve</button>
            </form>
          <% } %>
          <% if (d.status === 'visible' || d.status === 'approved') { %>
            <form method="post" action="/admin/discussions/<%= d.id %>/hide" style="display:inline">
              <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
              <button type="submit" class="button small warning">Hide</button>
            </form>
          <% } else if (d.status === 'hidden') { %>
            <form method="post" action="/admin/discussions/<%= d.id %>/unhide" style="display:inline">
              <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
              <button type="submit" class="button small success">Unhide</button>
            </form>
          <% } else if (d.status === 'deleted') { %>
            <form method="post" action="/admin/discussions/<%= d.id %>/restore" style="display:inline">
              <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
              <button type="submit" class="button small success">Restore</button>
            </form>
          <% } %>
          <% if (d.status !== 'deleted') { %>
            <form method="post" action="/admin/discussions/<%= d.id %>/delete" style="display:inline" class="discussion-delete-form">
              <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
              <button type="submit" class="button small danger discussion-delete-btn">Delete</button>
            </form>
          <% } %>
          <a href="/discussions/<%= d.id %>" class="button small" target="_blank" rel="noopener noreferrer">View thread</a>
        </div>

        <% const replies = repliesByDiscussion[d.id] || []; %>
        <% if (replies.length > 0) { %>
          <div class="admin-replies-section">
            <h4 class="admin-replies-heading">Replies (<%= replies.filter(r => r.status === 'visible').length %> visible / <%= replies.filter(r => r.status === 'hidden').length %> hidden / <%= replies.filter(r => r.status === 'deleted').length %> deleted)</h4>
            <% replies.forEach(r => { %>
              <% const rMod = (typeof replyModeration !== 'undefined' && replyModeration.get) ? replyModeration.get(r.id) : null; %>
                <% const isAcceptedReply = !!r.accepted_at; %>
              <div class="admin-reply-card<%= r.status === 'hidden' ? ' discussion-hidden' : '' %><%= r.status === 'deleted' ? ' discussion-deleted' : '' %><%= isAcceptedReply ? ' discussion-accepted' : '' %>" style="<%= isAcceptedReply ? 'border:2px solid #2e7d32;background:#f1f8f1;' : '' %>">
                <div class="admin-reply-meta">
                  <span class="admin-reply-author"><strong><%= r.author_name || 'Unknown' %></strong> (<%= r.author_email %>)</span>
                  <span class="admin-meta-sep">·</span>
                  <span class="admin-reply-time"><%= new Date(r.created_at).toLocaleString() %></span>
                  <% const replyAuthorRoleAdmin = r.author_app_role || r.author_role; %>
                  <% if (replyAuthorRoleAdmin === 'ADMIN' || replyAuthorRoleAdmin === 'OWNER') { %>
                    <span class="badge badge-admin" data-testid="admin-reply-badge" style="margin-left:6px">Admin Reply</span>
                  <% } %>
                  <% if (r.status === 'pending') { %>
                    <span class="badge" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:bold;">PENDING APPROVAL</span>
                  <% } else if (r.status === 'approved') { %>
                    <span class="badge" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:bold;">APPROVED</span>
                  <% } else { %>
                    <span class="badge badge-<%= r.status === 'visible' ? 'visible' : r.status === 'hidden' ? 'hidden' : 'deleted' %>"><%= r.status.toUpperCase() %></span>
                  <% } %>
                  <% if (isAcceptedReply) { %>
                    <span class="badge badge-success" style="margin-left:6px">✓ Accepted Answer</span>
                  <% } %>
                  <% if (r.status === 'deleted' && r.deleted_at) { %>
                    <span style="font-size:0.85em;color:#999;margin-left:8px">deleted <%= new Date(r.deleted_at).toLocaleDateString() %></span>
                  <% } %>
                </div>
                <% if (r.status === 'deleted') { %>
                  <div style="font-size:0.85em;color:#666;margin-top:2px">
                    Deleted by: <strong><%= r.deleted_by_name || (rMod ? rMod.actor_name : 'Unknown') %></strong> (<%= r.deleted_by_email || (rMod ? rMod.actor_email : '') %>) · <%= new Date(r.deleted_at || (rMod ? rMod.created_at : r.updated_at)).toLocaleString() %>
                  </div>
                <% } else if (r.status === 'hidden' && rMod) { %>
                  <div style="font-size:0.85em;color:#666;margin-top:2px">
                    Hidden by: <strong><%= rMod.actor_name || 'Unknown' %></strong> (<%= rMod.actor_email || '' %>) · <%= new Date(rMod.created_at).toLocaleString() %>
                  </div>
                <% } else if (rMod && rMod.action === 'restore') { %>
                  <div style="font-size:0.85em;color:#666;margin-top:2px">
                    Restored by: <strong><%= rMod.actor_name || 'Unknown' %></strong> (<%= rMod.actor_email || '' %>) · <%= new Date(rMod.created_at).toLocaleString() %>
                  </div>
                <% } %>
                <div class="admin-reply-content"><%= r.body %></div>
                <div class="admin-reply-actions">
                  <% if (r.status === 'pending') { %>
                    <form method="post" action="/admin/discussions/replies/<%= r.id %>/approve" style="display:inline">
                      <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
                      <button type="submit" class="button small success" style="font-weight: bold;">Approve</button>
                    </form>
                  <% } %>
                  <% if (r.status === 'visible' || r.status === 'approved') { %>
                    <form method="post" action="/admin/discussions/replies/<%= r.id %>/hide" style="display:inline">
                      <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
                      <button type="submit" class="button small warning">Hide</button>
                    </form>
                  <% } else if (r.status === 'hidden') { %>
                    <form method="post" action="/admin/discussions/replies/<%= r.id %>/unhide" style="display:inline">
                      <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
                      <button type="submit" class="button small success">Unhide</button>
                    </form>
                  <% } else if (r.status === 'deleted') { %>
                    <form method="post" action="/admin/discussions/replies/<%= r.id %>/restore" style="display:inline">
                      <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
                      <button type="submit" class="button small success">Restore</button>
                    </form>
                  <% } %>
                  <% if (r.status !== 'deleted') { %>
                    <form method="post" action="/admin/discussions/replies/<%= r.id %>/delete" style="display:inline" class="discussion-delete-form">
                      <input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="search" value="<%= searchTerm %>"><input type="hidden" name="page" value="<%= page %>">
                      <button type="submit" class="button small danger discussion-delete-btn">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>

    <% if (totalPages > 1) { %>
      <div style="margin-top:24px;text-align:center">
        <% if (page > 1) { %>
          <a href="/admin/discussions?filter=<%= filter %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>&page=<%= page - 1 %>" class="button">← Previous</a>
        <% } %>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% if (p === page) { %>
            <span class="button primary" style="margin:0 2px;background:#333;color:#fff;padding:6px 12px;border-radius:4px"><%= p %></span>
          <% } else { %>
            <a href="/admin/discussions?filter=<%= filter %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>&page=<%= p %>" class="button" style="margin:0 2px"><%= p %></a>
          <% } %>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="/admin/discussions?filter=<%= filter %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>&page=<%= page + 1 %>" class="button">Next →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</main>
<%- include('partials/footer') %>
<script src="/discussions.js" defer></script>
</body></html>
