<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create Product Plan · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Learn with me</a>
  <div class="user">
    <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span>
    <% } %>
    <form method="post" action="/logout"><button type="submit">Sign out</button></form>
  </div>
</header>
<main class="container" style="max-width:600px;margin-top:24px;margin-bottom:48px;">
  <%- include('partials/admin-nav') %>

  <a href="/admin/paid-products" class="nav-link" style="display:inline-block;margin-bottom:16px;">&larr; Back to Paid Products</a>
  
  <h1>Create Product Plan</h1>
  <p class="muted">Adding a plan for product: <strong><%= product.name %></strong> (<code><%= product.code %></code>)</p>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form method="post" action="/admin/paid-products/<%= product.id %>/plan/create" style="background:#fff;border:1px solid #e1e6ee;border-radius:12px;padding:24px;margin-top:16px;">
    <% if (csrfToken) { %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% } %>

    <div style="margin-bottom:18px;">
      <label for="code" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Plan Code</label>
      <input type="text" id="code" name="code" value="<%= (form && form.code) || '' %>" required placeholder="e.g. monthly_pro" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;text-transform:lowercase;">
      <p class="muted" style="margin-top:4px;font-size:12px;">Unique within this product. Only lowercase letters, numbers, and underscores are allowed.</p>
    </div>

    <div style="margin-bottom:18px;">
      <label for="name" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Plan Name</label>
      <input type="text" id="name" name="name" value="<%= (form && form.name) || '' %>" required placeholder="e.g. Pro Monthly Subscription" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
    </div>

    <div style="margin-bottom:18px;display:flex;gap:16px;">
      <div style="flex:1;">
        <label for="billing_type" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Billing Type</label>
        <select id="billing_type" name="billing_type" required style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;background:#fff;">
          <option value="one_time" <%= (form && form.billing_type === 'one_time') ? 'selected' : '' %>>One-Time Payment</option>
          <option value="recurring" <%= (form && form.billing_type === 'recurring') ? 'selected' : '' %>>Recurring Subscription</option>
        </select>
      </div>
      
      <div style="flex:1;">
        <label for="currency" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Currency</label>
        <input type="text" id="currency" name="currency" value="<%= (form && form.currency) || 'INR' %>" required style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;text-transform:uppercase;">
      </div>
    </div>

    <div style="margin-bottom:18px;display:flex;gap:16px;">
      <div style="flex:1;">
        <label for="price" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Price</label>
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= (form && form.price) || '' %>" required placeholder="e.g. 299.00" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
        <p class="muted" style="margin-top:4px;font-size:12px;">Standard price amount (gets converted to paise on save).</p>
      </div>

      <div style="flex:1;">
        <label for="duration_days" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Duration (Days)</label>
        <input type="number" id="duration_days" name="duration_days" min="1" value="<%= (form && form.duration_days) || '' %>" placeholder="Lifetime / Unlimited" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
        <p class="muted" style="margin-top:4px;font-size:12px;">Leave blank for lifetime/continuous plans.</p>
      </div>
    </div>

    <div style="margin-bottom:18px;">
      <label for="razorpay_plan_id" style="display:block;font-weight:600;margin-bottom:6px;color:#2d3748;">Razorpay Plan ID (Optional)</label>
      <input type="text" id="razorpay_plan_id" name="razorpay_plan_id" value="<%= (form && form.razorpay_plan_id) || '' %>" placeholder="e.g. plan_N1v9xYabc123" style="width:100%;padding:10px;border:1px solid #cbd5e0;border-radius:6px;">
      <p class="muted" style="margin-top:4px;font-size:12px;">Mandatory for recurring subscriptions if connecting live checkout.</p>
    </div>

    <div style="margin-bottom:24px;display:flex;align-items:center;gap:8px;">
      <input type="checkbox" id="is_active" name="is_active" value="true" <%= (!form || form.is_active === 'true' || form.is_active === true) ? 'checked' : '' %>>
      <label for="is_active" style="font-weight:600;color:#2d3748;margin:0;">Make plan active immediately</label>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end;">
      <a href="/admin/paid-products" class="button secondary" style="padding:10px 20px;text-decoration:none;">Cancel</a>
      <button type="submit" class="button success" style="padding:10px 20px;">Create Plan</button>
    </div>
  </form>
</main>
</body>
</html>
