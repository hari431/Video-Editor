<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Timestamp &amp; Date Converter · Admin · Learn with me</title>
  <link rel="stylesheet" href="/styles.css">
  <%- include('partials/adsense-verification') %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Learn with me</a>
    <div class="user">
      <a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;">
          <%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %>
          <% if (user.access_expires_at) { %>
            <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span>
          <% } %>
        </span>
      <% } %>
      <form method="post" action="/logout">
        <button type="submit">Sign out</button>
      </form>
    </div>
  </header>

  <main class="container" style="max-width:1100px;">
    <h1>Timestamp &amp; DateTime Converter</h1>
    <%- include('partials/admin-nav') %>

    <p class="muted">
      Admin/Owner only. Convert between standard Unix timestamps (seconds or milliseconds) and human-readable dates (ISO-8601 strings, explicit UTC representations, and local timestamps) instantly in-memory.
    </p>

    <!-- Core Convert Panel -->
    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-top:20px;">
      
      <!-- Option selection header -->
      <div class="flex items-center justify-between gap-4 mb-4 flex-wrap border-b border-slate-100 pb-3">
        <h2 style="font-size:16px; margin:0;">Time Definitions</h2>
        <div class="flex items-center gap-3 flex-wrap">
          <button type="button" class="button small secondary font-semibold" id="btnLoadSample">Load Sample</button>
          <button type="button" class="button small secondary" id="btnClearAll" data-testid="clear-btn">Clear</button>
        </div>
      </div>

      <!-- Converters Form Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
        <!-- Timestamp input converter -->
        <div class="bg-slate-50/50 border border-slate-200 rounded-xl p-5 space-y-3">
          <label for="timestampInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Convert from Unix Timestamp</label>
          <div class="flex gap-2">
            <input type="text" id="timestampInput" placeholder="e.g. 1785501192 or 1785501192000" class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-full font-mono bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500" />
            <button type="button" class="button small primary" id="btnConvertTimestamp">Convert</button>
          </div>
          <span class="text-[10px] text-slate-400 block">Detects seconds (10 digits) vs milliseconds (13 digits) automatically.</span>
        </div>

        <!-- Date input converter -->
        <div class="bg-slate-50/50 border border-slate-200 rounded-xl p-5 space-y-3">
          <label for="isoInput" class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Convert from ISO 8601 Date String</label>
          <div class="flex gap-2">
            <input type="text" id="isoInput" placeholder="e.g. 2026-09-30T04:30:00Z" class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-full font-mono bg-white focus:outline-none focus:ring-1 focus:ring-indigo-500" />
            <button type="button" class="button small primary" id="btnConvertIso">Convert</button>
          </div>
          <span class="text-[10px] text-slate-400 block">Parses standard calendar ISO format timestamps.</span>
        </div>
      </div>

      <!-- Error display banner -->
      <div id="errorContainer" class="hidden bg-red-50 border border-red-200 text-red-900 rounded-xl p-4 mb-6"></div>

      <!-- Result View Panel -->
      <div id="resultsPanel" class="hidden">
        <hr style="border:0; border-top:1px solid #e2e8f0; margin:24px 0;">

        <div class="space-y-4">
          <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2">
            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Resolved DateTime Representations
          </h3>

          <div class="overflow-x-auto border rounded-xl bg-white shadow-sm">
            <table class="w-full text-left border-collapse text-xs text-slate-700">
              <tbody>
                <tr class="border-b border-slate-100">
                  <td class="p-3 font-semibold text-slate-500 w-44">Unix Seconds</td>
                  <td class="p-3"><input type="text" id="outSeconds" readonly class="bg-slate-50 border border-slate-200 px-2.5 py-1.5 rounded font-mono w-full text-slate-800 focus:outline-none select-all" /></td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-3 font-semibold text-slate-500">Unix Milliseconds</td>
                  <td class="p-3"><input type="text" id="outMillis" readonly class="bg-slate-50 border border-slate-200 px-2.5 py-1.5 rounded font-mono w-full text-slate-800 focus:outline-none select-all" /></td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-3 font-semibold text-slate-500">ISO 8601 String</td>
                  <td class="p-3"><input type="text" id="outIso" readonly class="bg-slate-50 border border-slate-200 px-2.5 py-1.5 rounded font-mono w-full text-slate-800 focus:outline-none select-all" /></td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-3 font-semibold text-slate-500">Explicit UTC Time</td>
                  <td class="p-3"><input type="text" id="outUtc" readonly class="bg-slate-50 border border-slate-200 px-2.5 py-1.5 rounded font-mono w-full text-slate-800 focus:outline-none select-all" /></td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-3 font-semibold text-slate-500">Explicit Local Time</td>
                  <td class="p-3"><input type="text" id="outLocal" readonly class="bg-slate-50 border border-slate-200 px-2.5 py-1.5 rounded font-mono w-full text-indigo-900 font-bold focus:outline-none select-all" /></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/admin-developer-tools-timestamp-converter.js?v=<%= Date.now() %>"></script>
</body>
</html>
