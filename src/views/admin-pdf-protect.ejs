<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Protect PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Protect PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Upload one PDF and set a password to download a <strong>new</strong> AES-256 encrypted copy. The original file is never modified. The password is used for encryption only — it is never recovered, cracked, bypassed, stored or logged. There is no password recovery: keep the password safe. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfProtectAvailable !== 'undefined' ? !!pdfProtectAvailable : false; %>
<% const _maxMb = (typeof pdfProtectMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfProtectMaxFileMb)) && Number(pdfProtectMaxFileMb) >= 1) ? Math.floor(Number(pdfProtectMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-protect-disabled">PDF protect is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-protect-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfProtectPick" data-testid="pdf-protect-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfProtectFile" data-testid="pdf-protect-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <label style="font-size:13px;">Password
      <input type="password" id="pdfProtectPassword" data-testid="pdf-protect-password" autocomplete="new-password" autocapitalize="off" spellcheck="false" placeholder="New password" style="width:200px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="font-size:13px;">Confirm password
      <input type="password" id="pdfProtectConfirm" data-testid="pdf-protect-confirm" autocomplete="new-password" autocapitalize="off" spellcheck="false" placeholder="Repeat password" style="width:200px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <button type="button" class="button small primary" id="pdfProtectBtn" data-testid="pdf-protect-submit" <%= _available ? '' : 'disabled' %>>🔒 Protect &amp; download</button>
    <button type="button" class="button small secondary" id="pdfProtectClear" data-testid="pdf-protect-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB · AES-256</span>
  </div>
  <p class="muted" id="pdfProtectFileInfo" data-testid="pdf-protect-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <div id="pdfProtectProgress" data-testid="pdf-protect-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Protecting… <span id="pdfProtectProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-protect-status" id="pdfProtectStatus" style="font-size:13px;font-weight:600;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-protect.js?v=<%= Date.now() %>"></script>
</body></html>
