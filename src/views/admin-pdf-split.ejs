<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Split PDF · Admin · Learn with me</title><link rel="stylesheet" href="/styles.css"><%- include('partials/adsense-verification') %></head>
<body><header class="topbar"><a class="brand" href="/">Learn with me</a><div class="user"><a href="/account" style="text-decoration: underline; font-weight: bold;"><%= user.name || user.email %></a><% if (typeof user !== 'undefined' && user) { %><span class="user-status-text" style="color: #64748b; font-size: 13px; margin-left: 6px;"><%= (typeof getUserHeaderStatus === 'function') ? getUserHeaderStatus(user) : (user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active') %><% if (user.access_expires_at) { %> <span class="user-access-until">(Access Until: <%= new Date(user.access_expires_at).toLocaleDateString() %>)</span><% } %></span><% } %><form method="post" action="/logout"><button type="submit">Sign out</button></form></div></header>
<main class="container" style="max-width:900px;">
<h1>Split PDF</h1>
<%- include('partials/admin-nav') %>

<p class="muted">Admin/Owner only. Upload one PDF and split it into a <strong>new</strong> file (single result) or a <strong>ZIP of files</strong> (multiple results). Pages keep their original content, size and order. The original file is never modified. This tool is <strong>disabled in production</strong>.</p>

<% const _available = typeof pdfSplitAvailable !== 'undefined' ? !!pdfSplitAvailable : false; %>
<% const _maxMb = (typeof pdfSplitMaxFileMb !== 'undefined' && Number.isFinite(Number(pdfSplitMaxFileMb)) && Number(pdfSplitMaxFileMb) >= 1) ? Math.floor(Number(pdfSplitMaxFileMb)) : 50; %>
<% if (!_available) { %>
  <p class="flash flash-error" data-testid="pdf-split-disabled">PDF split is disabled in production. Run the app locally (development) to use it.</p>
<% } %>

<div data-testid="pdf-split-root" data-available="<%= _available ? '1' : '0' %>" data-max-file-mb="<%= _maxMb %>">
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small" id="pdfSplitPick" data-testid="pdf-split-pick" <%= _available ? '' : 'disabled' %>>📂 Select PDF</button>
    <input type="file" id="pdfSplitFile" data-testid="pdf-split-file" accept=".pdf,application/pdf" style="display:none;" <%= _available ? '' : 'disabled' %>>
    <span class="muted" style="font-size:12px;">One file · max <%= _maxMb %> MB</span>
  </div>
  <p class="muted" id="pdfSplitFileInfo" data-testid="pdf-split-fileinfo" style="font-size:13px;">No PDF selected yet.</p>
  <fieldset style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin:12px 0;max-width:560px;">
    <legend style="font-size:13px;font-weight:700;padding:0 6px;">Split mode</legend>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfSplitMode" value="extract" data-testid="pdf-split-mode-extract" checked <%= _available ? '' : 'disabled' %>>
      Extract pages
      <input type="text" id="pdfSplitSelection" data-testid="pdf-split-selection" placeholder="e.g. 1-3,5,8-10" autocomplete="off" spellcheck="false" style="width:200px;margin-left:8px;" <%= _available ? '' : 'disabled' %>>
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfSplitMode" value="every" data-testid="pdf-split-mode-every" <%= _available ? '' : 'disabled' %>>
      Split every
      <input type="number" id="pdfSplitEvery" data-testid="pdf-split-every" value="2" min="1" max="500" step="1" style="width:80px;margin:0 4px;" <%= _available ? '' : 'disabled' %>>
      pages
    </label>
    <label style="display:block;font-size:13px;margin:6px 0;">
      <input type="radio" name="pdfSplitMode" value="pages" data-testid="pdf-split-mode-pages" <%= _available ? '' : 'disabled' %>>
      Individual pages (one file per page)
    </label>
  </fieldset>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0;">
    <button type="button" class="button small primary" id="pdfSplitBtn" data-testid="pdf-split-submit" <%= _available ? '' : 'disabled' %>>✂ Split &amp; download</button>
    <button type="button" class="button small secondary" id="pdfSplitClear" data-testid="pdf-split-clear" <%= _available ? '' : 'disabled' %>>Clear</button>
  </div>
  <div id="pdfSplitProgress" data-testid="pdf-split-progress" style="display:none;margin-top:8px;font-size:13px;font-weight:600;" role="status" aria-live="polite">Splitting… <span id="pdfSplitProgressPct">0%</span></div>
  <p class="muted" data-testid="pdf-split-status" id="pdfSplitStatus" style="font-size:13px;font-weight:600;"></p>
  <p class="muted" data-testid="pdf-split-result" id="pdfSplitResult" style="font-size:13px;"></p>
</div>

</main>
<%- include('partials/footer') %>
<script type="module" src="/admin-pdf-split.js?v=<%= Date.now() %>"></script>
</body></html>
